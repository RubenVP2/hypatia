import { Theme, Type } from "theme.slint";

export struct AllyRow {
    lane: int,
    champion: string,
    initials: string,
    icon: image,
    player: string,
    rank: string,
    is-self: bool,
    is-premade: bool,
    picking: bool,
    hidden: bool,
}

export struct EnemyPick {
    champion: string,
    initials: string,
    icon: image,
}

export struct TowerDot {
    x: float,
    y: float,
    mine: bool,
    standing: bool,
}

export struct ObjectiveChip {
    weight: int,
    label: string,
    mine: bool,
}

export struct FeedLine {
    time: string,
    text: string,
    lane: int,
    side: int, // 1 your team, 0 enemy, -1 neutral
}

export struct PlayerLine {
    lane: int,
    champion: string,
    initials: string,
    icon: image,
    level: int,
    kda: string,
    cs: int,
    is-self: bool,
    dead: bool,
    respawn: string,
}

export struct MapAlly {
    x: float,
    y: float,
    label: string,
    is-self: bool,
    // 0: right, 1: left, 2: above, 3: below
    label-pos: int,
}

export struct PartyRow {
    name: string,
    first-lane: int,
    second-lane: int,
    is-leader: bool,
    is-self: bool,
}

export struct StatLine {
    label: string,
    value: string,
}

export struct TelemetrySourceItem {
    id: string,
    name: string,
    status: string,
    live: bool,
    port: string,
    pid: string,
    stats: string,
}

export struct TelemetryEventItem {
    id: int,
    time: string,
    source: string,
    source-idx: int,
    kind: string,
    uri: string,
    size: string,
    preview: string,
    has-secrets: bool,
}

export struct TelemetryEndpointItem {
    source: string,
    source-idx: int,
    method: string,
    path: string,
    namespace: string,
    origin: string,
    stats: string,
    description: string,
}

export struct TelemetryProcessItem {
    pid: string,
    name: string,
    source: string,
    cpu: string,
    mem: string,
    exe: string,
}

export struct TelemetrySocketItem {
    proto: string,
    address: string,
    pid: string,
    state: string,
}

export struct TelemetryView {
    rate: string,
    total-events: string,
    phase: string,
    sources: [TelemetrySourceItem],
    events: [TelemetryEventItem],
    selected-event-id: int,
    inspector-title: string,
    inspector-meta: string,
    inspector-has-secrets: bool,
    secrets-revealed: bool,
    inspector-payload: string,
    endpoints: [TelemetryEndpointItem],
    endpoints-total: int,
    endpoints-summary: string,
    call-status: string,
    call-response: string,
    processes: [TelemetryProcessItem],
    sockets: [TelemetrySocketItem],
    connections: [TelemetrySocketItem],
}

// Lane-colored ring with role initial.
export component Roundel inherits Rectangle {
    in property <int> lane;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: max(2px, size * 0.14);
    border-color: Theme.lane-color(lane);
    background: Theme.ground;
    accessible-role: text;
    accessible-label: Theme.lane-name(root.lane);
    if root.size >= 24px: Text {
        text: Theme.lane-letter(root.lane);
        color: Theme.text;
        font-family: Type.display-family;
        font-size: root.size * 0.42;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Team-colored champion plate: local image icon when available, otherwise initials.
export component ChampPlate inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> mine: true;
    in property <bool> empty: false;
    in property <bool> faded: false;
    in property <length> size: 56px;
    width: size;
    height: size;
    border-radius: Theme.radius;
    clip: true;
    background: empty ? Theme.panel-raised : Theme.team-color(mine);
    border-width: empty ? 1px : 0px;
    border-color: Theme.rule-strong;
    opacity: faded ? 0.45 : 1.0;
    if !root.empty && root.icon.width == 0: Text {
        text: root.label;
        color: Theme.on-team;
        font-family: Type.display-family;
        font-size: root.size * 0.42;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.empty && root.icon.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.icon;
        image-fit: cover;
    }
}

export component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: Type.label;
    font-weight: 600;
    letter-spacing: 0.9px;
}

// High-contrast focal callout plate: headline leads, optional detail below.
export component Plate inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> active-turn: false;
    background: active-turn ? Theme.signal : Theme.plate;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: active-turn ? Theme.signal : Theme.rule-strong;
    accessible-role: text;
    accessible-label: root.title + ". " + root.detail;
    VerticalLayout {
        padding-left: 18px;
        padding-right: 20px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 3px;
        Text {
            text: root.title;
            color: root.active-turn ? #0f1116 : Theme.on-plate;
            font-family: Type.display-family;
            font-size: 26px;
            font-weight: 800;
            letter-spacing: 0.3px;
            wrap: word-wrap;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: root.active-turn ? #222631 : Theme.on-plate-muted;
            font-size: Type.body;
            font-weight: 600;
            wrap: word-wrap;
        }
    }
}

// Condensed pit-wall timing display figure.
export component Specimen inherits Text {
    font-family: Type.display-family;
    font-size: Type.specimen;
    font-weight: 800;
    letter-spacing: -1px;
    color: Theme.text;
    horizontal-alignment: right;
    vertical-alignment: center;
}

// Instrument button with clear hover, selected, and keyboard focus rings.
export component Action inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> primary-signal: false;
    callback clicked();
    height: 30px;
    min-width: label.preferred-width + 20px;
    border-radius: Theme.radius-sm;
    background: selected
        ? (primary-signal ? Theme.signal : Theme.plate)
        : (touch.has-hover && enabled ? Theme.panel-raised : Theme.panel);
    border-width: 1px;
    border-color: selected
        ? (primary-signal ? Theme.signal : Theme.plate)
        : (touch.has-hover && enabled ? Theme.rule-strong : Theme.rule);
    opacity: enabled ? 1.0 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    animate background { duration: 110ms; easing: ease-out; }
    animate border-color { duration: 110ms; easing: ease-out; }

    label := Text {
        text: root.text;
        color: root.selected
            ? (root.primary-signal ? #0f1116 : Theme.on-plate)
            : Theme.text;
        font-size: Type.small;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                focus.focus();
                root.clicked();
            }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

// Left navigation rail item with uniform 2px vector icon and crisp active state.
export component RailNavItem inherits Rectangle {
    in property <string> label;
    in property <string> badge: "";
    in property <string> icon-path;
    in property <bool> active: false;
    in property <bool> indicator-live: false;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-sm;
    background: active
        ? Theme.signal-soft
        : (touch.has-hover ? Theme.panel-raised : transparent);
    border-width: 1px;
    border-color: active ? Theme.signal : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    animate background { duration: 110ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        alignment: stretch;

        Rectangle {
            width: 16px;
            Path {
                x: 0px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon-path;
                stroke: root.active ? Theme.signal : Theme.muted;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
        }

        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.muted;
            font-size: Type.small;
            font-weight: root.active ? 800 : 600;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.indicator-live: Rectangle {
            width: 8px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.live-green;
            }
        }

        if root.badge != "": Rectangle {
            width: badge-txt.preferred-width + 12px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: root.active ? Theme.signal : Theme.panel-raised;
            border-width: 1px;
            border-color: root.active ? Theme.signal : Theme.rule;
            badge-txt := Text {
                text: root.badge;
                color: root.active ? #0f1116 : Theme.text;
                font-family: Type.mono-family;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: parent.border-radius + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

// Compact source telemetry indicator in the workspace rail.
export component RailSourceRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> port;
    in property <bool> live: false;
    height: 22px;
    spacing: 8px;
    alignment: stretch;

    Rectangle {
        width: 8px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: root.live ? Theme.live-green : Theme.rule-strong;
        }
    }
    Text {
        text: root.label;
        color: root.live ? Theme.text : Theme.muted;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.port;
        color: Theme.muted;
        font-family: Type.mono-family;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Match progression ticker: Lobby, Queue, Champ Select, In Game, Results.
export component PhaseLine inherits Rectangle {
    // 0 lobby, 1 queue, 2 champ select, 3 in game, 4 results, -1 none
    in property <int> current: -1;
    height: 36px;
    accessible-role: text;
    accessible-label: "Current phase: " + (current == 0 ? "Lobby" : current == 1 ? "Queue" : current == 2 ? "Champion select" : current == 3 ? "In game" : current == 4 ? "Results" : "Not in a match");
    property <[string]> stops: ["LOBBY", "QUEUE", "CHAMP SELECT", "IN GAME", "RESULTS"];

    HorizontalLayout {
        alignment: start;
        spacing: 0px;
        for stop[i] in root.stops: HorizontalLayout {
            spacing: 7px;
            alignment: start;
            if i > 0: Rectangle {
                width: 22px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 2px;
                    width: 100%;
                    background: i <= root.current ? Theme.signal : Theme.rule-strong;
                }
            }
            Rectangle {
                width: 12px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    border-width: 2.5px;
                    border-color: i == root.current
                        ? Theme.signal
                        : (i < root.current ? Theme.text : Theme.rule-strong);
                    background: i == root.current ? Theme.signal : Theme.ground;
                }
            }
            Text {
                text: stop;
                vertical-alignment: center;
                font-family: Type.display-family;
                font-size: 14px;
                font-weight: i == root.current ? 800 : 700;
                letter-spacing: 0.6px;
                color: i == root.current
                    ? Theme.signal-text
                    : (i < root.current ? Theme.text : Theme.muted);
            }
            Rectangle { width: 8px; }
        }
    }
}

// Three-lane Summoner's Rift telemetry diagram on a 400 x 400 grid.
export component LineMap inherits Rectangle {
    in property <[TowerDot]> towers;
    in property <[MapAlly]> allies;
    in property <bool> show-jungle: true;
    in property <length> line-width: 8px;
    in property <length> station: 20px;
    in property <color> halo: Theme.panel;
    background: transparent;
    accessible-role: image;
    accessible-label: "Map of the three lanes";

    Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 40 348 L 40 42 L 358 42";
        stroke: Theme.lane-top;
        stroke-width: root.line-width;
        fill: transparent;
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 40 348 L 358 42";
        stroke: Theme.lane-mid;
        stroke-width: root.line-width;
        fill: transparent;
    }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 40 348 L 358 348 L 358 42";
        stroke: Theme.lane-bot;
        stroke-width: root.line-width;
        fill: transparent;
    }
    if root.show-jungle: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 95 215 L 107 226 M 120 238 L 132 249 M 145 261 L 157 272 M 210 112 L 222 123 M 235 135 L 247 146 M 260 158 L 272 169";
        stroke: Theme.lane-jungle;
        stroke-width: root.line-width * 0.75;
        fill: transparent;
    }

    for t in root.towers: Rectangle {
        x: root.width * t.x / 400 - self.width / 2;
        y: root.height * t.y / 400 - self.height / 2;
        width: t.standing ? root.station : root.station * 0.78;
        height: self.width;
        border-radius: self.width / 2;
        background: t.standing ? Theme.team-color(t.mine) : root.halo;
        border-width: t.standing ? 3px : 2.5px;
        border-color: t.standing ? root.halo : Theme.team-color(t.mine);
    }

    for a in root.allies: Rectangle {
        x: root.width * a.x / 400 - self.width / 2;
        y: root.height * a.y / 400 - self.height / 2;
        width: a.is-self ? root.station * 1.5 : root.station * 1.25;
        height: self.width;
        border-radius: self.width / 2;
        background: a.is-self ? Theme.signal : Theme.blue;
        border-width: 3px;
        border-color: root.halo;

        Text {
            x: a.label-pos == 1
                ? -self.width - 7px
                : (a.label-pos == 2 || a.label-pos == 3)
                    ? (parent.width - self.width) / 2
                    : parent.width + 7px;
            y: a.label-pos == 2
                ? -self.height - 5px
                : a.label-pos == 3
                    ? parent.height + 5px
                    : (parent.height - self.height) / 2;
            text: a.label;
            color: a.is-self ? Theme.signal-text : Theme.text;
            font-size: Type.small;
            font-weight: 800;
            horizontal-alignment: a.label-pos == 1 ? right : ((a.label-pos == 2 || a.label-pos == 3) ? center : left);
        }
    }
}

// Match event feed entry with tabular clock timestamp and lane roundel.
export component FeedRow inherits HorizontalLayout {
    in property <FeedLine> line;
    spacing: 8px;
    height: 30px;
    Text {
        width: 44px;
        text: root.line.time;
        color: Theme.muted;
        font-family: Type.mono-family;
        font-size: 11px;
        vertical-alignment: center;
    }
    Rectangle {
        width: 18px;
        Roundel {
            size: 18px;
            lane: root.line.lane;
            y: (parent.height - self.height) / 2;
            visible: root.line.lane >= 0;
        }
    }
    Text {
        text: root.line.text;
        color: root.line.side == 0 ? Theme.red-soft : Theme.text;
        font-size: Type.small;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Objectives ramp: weighted dots plus optional labels when room allows.
export component ObjectiveRow inherits HorizontalLayout {
    in property <[ObjectiveChip]> chips;
    in property <string> empty-text: "No objectives claimed";
    in property <bool> compact: false;
    spacing: root.compact ? 7px : 8px;
    alignment: start;
    height: 32px;
    if root.chips.length == 0: Text {
        text: root.empty-text;
        color: Theme.muted;
        font-size: Type.small;
        vertical-alignment: center;
    }
    for c in root.chips: Rectangle {
        accessible-role: text;
        accessible-label: c.label;

        if root.compact: Rectangle {
            width: 10px + c.weight * 4px;
            height: 10px + c.weight * 4px;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: Theme.team-color(c.mine);
        }

        if !root.compact: Rectangle {
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.team-color(c.mine);

            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 5px;
                Rectangle {
                    width: 8px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.team-color(c.mine);
                    }
                }
                Text {
                    text: c.label;
                    color: Theme.text;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Compact ban chip shown in Champion Select.
export component BanChip inherits Rectangle {
    in property <string> name;
    in property <bool> mine: true;
    height: 24px;
    width: txt.preferred-width + 18px;
    border-radius: Theme.radius-sm;
    background: Theme.panel-raised;
    border-width: 1px;
    border-color: mine ? Theme.blue : Theme.red;
    txt := Text {
        text: root.name;
        color: Theme.text;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A player's live scoreboard row: lane roundel, champion, stats, KDA.
export component PlayerRow inherits Rectangle {
    in property <PlayerLine> p;
    in property <bool> mine: true;
    height: 50px;
    border-radius: Theme.radius;
    background: p.is-self ? Theme.signal-soft : Theme.panel;
    border-width: 1px;
    border-color: p.is-self ? Theme.signal : Theme.rule;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        alignment: stretch;
        Rectangle {
            width: 28px;
            Roundel { size: 28px; lane: root.p.lane; y: (parent.height - self.height) / 2; }
        }
        Rectangle {
            width: 36px;
            ChampPlate {
                y: (parent.height - self.height) / 2;
                size: 36px;
                label: root.p.initials;
                icon: root.p.icon;
                mine: root.mine;
                faded: root.p.dead;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.p.champion + (root.p.is-self ? " (you)" : "");
                color: Theme.text;
                font-size: Type.body;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: root.p.dead ? "Respawn in " + root.p.respawn : "Lvl " + root.p.level + " · " + root.p.cs + " CS";
                color: root.p.dead ? Theme.danger : Theme.muted;
                font-size: Type.small;
                font-weight: root.p.dead ? 600 : 400;
            }
        }
        Text {
            text: root.p.kda;
            color: Theme.text;
            font-family: Type.mono-family;
            font-size: Type.small;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 68px;
        }
    }
}
