import { Theme, Type, Space } from "theme.slint";
import {
    AllyRow, BanEntry, EnemyPick, TowerDot, ObjectiveChip, FeedLine, PlayerLine, MapAlly, PartyRow, StatLine,
    EnemySighting, PitClock,
    TelemetrySourceItem, TelemetryEventItem, TelemetryEndpointItem, TelemetryProcessItem,
    TelemetrySocketItem, TelemetryView,
    Roundel, ChampPlate, GameIconBadge, RankedCrest, SplashBackdrop, HeroSplash, EnemySlot, ReadyMedallion, ResultCrest, SectionLabel, Plate, Specimen, ClockReadout, Action, RailNavItem, RailSourceRow,
    PhaseLine, LineMap, ClientArt, FeedRow, ObjectiveRow, BanChip, PlayerRow, SettingRow, ChoiceRow, Card, Divider,
    SightingRow, PitRow, ModalSheet,
} from "parts.slint";
import { StatsPage, StatsBridge } from "stats.slint";
import { HelperView, DraftHelperPanel } from "helper.slint";
import "fonts/Overpass-Regular.ttf";
import "fonts/Overpass-SemiBold.ttf";
import "fonts/Overpass-ExtraBold.ttf";
import "fonts/BarlowCondensed-Bold.ttf";
import "fonts/BarlowCondensed-ExtraBold.ttf";
import "fonts/OverpassMono.ttf";

export { Theme, ClientArt, StatsBridge }

// Which companion screen the client's gameflow phase maps to. Set from Rust.
export enum Screen {
    // League is not running.
    offline,
    // The client is open but not in a lobby.
    idle,
    lobby,
    queue,
    ready-check,
    champ-select,
    in-game,
    results,
}

// Mirrors `hypatia_core::settings::Settings` plus hardware recommendation.
export struct PerfSettings {
    profile: string,
    profile-label: string,
    profile-badge: string,
    profile-summary: string,
    hardware-summary: string,
    recommended-profile: string,
    recommended-label: string,
    live-poll-idx: int,
    discovery-rate-idx: int,
    clock-rate-idx: int,
    cache-budget-idx: int,
    live-game: bool,
    riot-client: bool,
    replay-api: bool,
    game-icons: bool,
    splash-backdrops: bool,
    demo-prefetch: bool,
    mobile-remote: bool,
    system-footprint: bool,
    endpoint-catalog: bool,
    eco-mode: bool,
    pause-when-minimized: bool,
    reduce-motion: bool,
    online-stats: bool,
    update-check: bool,
}

// A newer Hypatia release, pushed by `updates.rs` once the Update Check found one.
export struct UpdateView {
    available: bool,
    version: string,
    current: string,
    notes: string,
    page-url: string,
    // The signed archive can be installed from here (Windows builds only).
    installable: bool,
    busy: bool,
    status: string,
    failed: bool,
}

// Live self-footprint metrics sampled only while the Performance sheet is open.
export struct PerfMetrics {
    ram-text: string,
    cpu-text: string,
    cache-ram-text: string,
    cache-disk-text: string,
    cadence-text: string,
    status-note: string,
}

export struct WaitView {
    title: string,
    detail: string,
    specimen: string,
    summoner-name: string,
    summoner-initials: string,
    summoner-icon: image,
    rank-tier: string,
    notes: [StatLine],
    // Ready check answer: 0 pending, 1 accepted, 2 declined.
    ready-state: int,
}

export struct ActiveLoadoutView {
    shown: bool,
    has-runes: bool,
    rune-page: string,
    keystone: string,
    keystone-initials: string,
    keystone-icon: image,
    styles-line: string,
    has-spells: bool,
    spell1-name: string,
    spell1-initials: string,
    spell1-icon: image,
    spell2-name: string,
    spell2-initials: string,
    spell2-icon: image,
    smite-warning: bool,
    skin-name: string,
}

export struct ChampSelectView {
    title: string,
    detail: string,
    timer: string,
    // True while the local player is the one picking or banning.
    my-turn: bool,
    allies: [AllyRow],
    map-allies: [MapAlly],
    enemies: [EnemyPick],
    enemies-to-come: int,
    my-bans: string,
    their-bans: string,
    my-ban-list: [BanEntry],
    their-ban-list: [BanEntry],
    anonymized: bool,
    splash-icon: image,
    // Read-only summary of the local player's currently equipped runes, spells, and skin.
    loadout: ActiveLoadoutView,
    // Champ-select helper (helper.slint): build, lane matchup, comps, tips.
    helper: HelperView,
}

export struct LiveView {
    title: string,
    detail: string,
    dead: bool,
    active-initials: string,
    active-icon: image,
    splash-icon: image,
    // Seconds until the player respawns; -1 while alive.
    respawn-seconds: int,
    my-score: int,
    enemy-score: int,
    clock: string,
    self-kda: string,
    my-drakes: int,
    enemy-drakes: int,
    baron-owner: int,
    herald-owner: int,
    order-is-mine: bool,
    my-players: [PlayerLine],
    enemy-players: [PlayerLine],
    towers: [TowerDot],
    my-objectives: [ObjectiveChip],
    enemy-objectives: [ObjectiveChip],
    feed: [FeedLine],
    // Every enemy, in lane order, with their last known place.
    sightings: [EnemySighting],
    // Next monster of the dragon and top-side pits; empty off Summoner's Rift.
    pits: [PitClock],
    // Game clock at the last poll, for the pit countdowns when the ticking clock is off.
    game-seconds: int,
}

export struct EndView {
    title: string,
    detail: string,
    victory: bool,
    splash-icon: image,
    // The player's figures (KDA, CS per minute, gold, damage, vision).
    tiles: [StatLine],
    ally-totals: string,
    enemy-totals: string,
    allies: [PlayerLine],
    enemies: [PlayerLine],
}

component NoteRow inherits Rectangle {
    in property <StatLine> note;
    height: 44px;
    HorizontalLayout {
        spacing: Space.md;
        Text {
            text: root.note.label;
            color: Theme.muted;
            font-size: Type.small;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.note.value;
            color: Theme.text;
            font-family: Type.mono-family;
            font-size: Type.small;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.rule;
    }
}

// Phase headline plus the screen's one large figure: a running clock when the phase has one,
// otherwise `specimen` (e.g. the final KDA).
component Header inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> specimen;
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> clock-down: true;
    in property <bool> active-turn: false;
    in property <bool> compact: false;
    in property <image> splash;
    in property <color> splash-tint: Theme.accent;
    // Over a full-bleed hero splash: the plate turns translucent instead of carrying its own.
    in property <bool> glass: false;
    property <bool> has-figure: root.clock-seconds >= 0 || root.specimen != "";
    min-height: 92px;

    if !root.compact: HorizontalLayout {
        spacing: Space.xl;
        alignment: stretch;
        Plate {
            horizontal-stretch: 1;
            title: root.title;
            detail: root.detail;
            active-turn: root.active-turn;
            splash: root.splash;
            splash-tint: root.splash-tint;
            glass: root.glass;
        }
        if root.has-figure: ClockReadout {
            seconds: root.clock-seconds;
            total: root.clock-total;
            down: root.clock-down;
            fallback: root.specimen;
        }
    }

    if root.compact: VerticalLayout {
        spacing: Space.md;
        Plate {
            title: root.title;
            detail: root.detail;
            active-turn: root.active-turn;
            splash: root.splash;
            splash-tint: root.splash-tint;
            glass: root.glass;
        }
        if root.has-figure: ClockReadout {
            seconds: root.clock-seconds;
            total: root.clock-total;
            down: root.clock-down;
            fallback: root.specimen;
            size: Type.specimen-compact;
            align-left: true;
        }
    }
}

component RosterRow inherits Rectangle {
    in property <AllyRow> ally;
    height: 70px;
    border-radius: Theme.radius;
    background: root.ally.picking
        ? Theme.signal-soft
        : (root.ally.is-self ? Theme.panel-raised : Theme.panel);
    clip: true;
    animate background { duration: Theme.dur-base; easing: ease-out; }
    accessible-role: text;
    accessible-label: Theme.lane-name(root.ally.lane) + ", "
        + (root.ally.champion != "" ? root.ally.champion : @tr("no pick yet"))
        + (root.ally.is-self ? @tr(", you") : "")
        + (root.ally.picking ? @tr(", acting now") : "")
        + (root.hovering ? @tr(", hovering") : "");
    // Kept out of the label: Slint 1.18's code generator mis-moves the struct field when the
    // label reads `ally.champion` once more.
    property <bool> hovering: root.ally.champion != "" && !root.ally.locked;

    // Splash strip of the chosen skin on the right, melting into the row on its left so the
    // text column keeps a flat surface. Half strength while the champion is only hovered.
    if root.ally.banner.width > 0: Rectangle {
        x: parent.width * 0.38;
        width: parent.width * 0.62;
        height: 100%;
        Image {
            width: 100%;
            height: 100%;
            source: root.ally.banner;
            image-fit: cover;
            opacity: root.ally.locked ? (Theme.dark ? 0.85 : 0.7) : 0.4;
            animate opacity { duration: Theme.dur-slow; easing: ease-out; }
        }
        Rectangle {
            background: @linear-gradient(90deg, root.background 0%, root.background.with-alpha(0.55) 40%, root.background.with-alpha(0) 100%);
        }
    }

    // Lock-in: created when the pick locks, a gold glint crosses the row once, then rests
    // outside it (clipped). An animation never plays on a first value, hence `init`.
    if root.ally.locked: Rectangle {
        property <bool> fired: false;
        init => { self.fired = true; }
        width: 120px;
        height: 100%;
        x: self.fired ? parent.width : -self.width;
        background: @linear-gradient(90deg, Theme.gold-bright.with-alpha(0) 0%, Theme.gold-bright.with-alpha(0.38) 50%, Theme.gold-bright.with-alpha(0) 100%);
        animate x { duration: Theme.dur-reveal; easing: ease-in-out; }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        alignment: stretch;

        Rectangle {
            width: 36px;
            Roundel {
                size: 36px;
                lane: root.ally.lane;
                y: (parent.height - self.height) / 2;
            }
        }

        Rectangle {
            width: 48px;
            ChampPlate {
                y: (parent.height - self.height) / 2;
                size: 48px;
                label: root.ally.initials;
                icon: root.ally.icon;
                mine: true;
                is-self: root.ally.is-self;
                empty: root.ally.champion == "";
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Space.xs;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: Space.sm;
                alignment: stretch;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: root.ally.champion != "" ? root.ally.champion : @tr("Waiting for pick");
                        color: root.ally.champion != "" ? Theme.text : Theme.muted;
                        font-size: Type.name;
                        font-weight: 800;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.ally.picking: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 20px;
                        width: turn-lbl.preferred-width + 14px;
                        border-radius: Theme.radius-sm;
                        background: Theme.signal;
                        turn-lbl := Text {
                            text: root.ally.is-self
                                ? @tr("YOUR TURN")
                                : @tr("ACTING NOW");
                            color: Theme.on-signal;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.ally.spell1-name != "" || root.ally.spell2-name != "": HorizontalLayout {
                    spacing: Space.xs;
                    alignment: end;
                    if root.ally.spell1-name != "": Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: sp1-row.preferred-width;
                        border-radius: Theme.radius-sm;
                        background: Theme.ground;
                        border-width: 1px;
                        border-color: Theme.rule;
                        sp1-row := HorizontalLayout {
                            padding-left: Space.xs;
                            padding-right: Space.sm;
                            spacing: Space.xs;
                            GameIconBadge {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                icon: root.ally.spell1-icon;
                                fallback-text: "D";
                            }
                            Text {
                                text: root.ally.spell1-name;
                                color: Theme.text;
                                font-size: Type.label;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.ally.spell2-name != "": Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: sp2-row.preferred-width;
                        border-radius: Theme.radius-sm;
                        background: Theme.ground;
                        border-width: 1px;
                        border-color: Theme.rule;
                        sp2-row := HorizontalLayout {
                            padding-left: Space.xs;
                            padding-right: Space.sm;
                            spacing: Space.xs;
                            GameIconBadge {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                icon: root.ally.spell2-icon;
                                fallback-text: "F";
                            }
                            Text {
                                text: root.ally.spell2-name;
                                color: Theme.text;
                                font-size: Type.label;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Space.xs;
                alignment: start;
                if !root.ally.hidden && root.ally.rank-tier != "": Rectangle {
                    width: 15px;
                    RankedCrest {
                        y: (parent.height - self.height) / 2;
                        size: 15px;
                        tier: root.ally.rank-tier;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: Theme.lane-name(root.ally.lane)
                        + " · "
                        + (root.ally.is-self ? @tr("You · ") : "")
                        + root.ally.player
                        + (root.ally.is-premade ? @tr(" (Premade)") : "")
                        + (!root.ally.hidden && root.ally.rank != "" ? " · " + root.ally.rank : "");
                    color: Theme.muted;
                    font-size: Type.small;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Border drawn last, over the splash strip.
    Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: root.ally.picking
            ? Theme.signal
            : (root.ally.is-self ? Theme.rule-strong : Theme.rule);
        animate border-color { duration: Theme.dur-base; easing: ease-out; }
    }
}

component ActiveLoadoutCard inherits Card {
    in property <ActiveLoadoutView> loadout;
    in property <bool> narrow: false;

    VerticalLayout {
        padding: Space.md;
        spacing: Space.md;

        HorizontalLayout {
            spacing: Space.sm;
            height: 22px;
            SectionLabel { text: @tr("ACTIVE LOADOUT"); vertical-alignment: center; }
            if root.loadout.smite-warning: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 20px;
                width: smite-lbl.preferred-width + 12px;
                border-radius: Theme.radius-sm;
                background: Theme.danger-soft;
                border-width: 1px;
                border-color: Theme.danger;
                smite-lbl := Text {
                    text: @tr("Missing Smite");
                    color: Theme.danger;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.loadout.skin-name != "": Text {
                text: root.loadout.skin-name;
                color: Theme.gold-bright;
                font-size: Type.small;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if !root.narrow: HorizontalLayout {
            spacing: Space.lg;
            alignment: stretch;

            HorizontalLayout {
                horizontal-stretch: 3;
                spacing: Space.sm;
                alignment: start;
                if root.loadout.has-runes: GameIconBadge {
                    y: (parent.height - self.height) / 2;
                    size: 34px;
                    icon: root.loadout.keystone-icon;
                    fallback-text: root.loadout.keystone-initials;
                    border: Theme.gold;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Space.xxs;
                    horizontal-stretch: 1;
                    Text {
                        text: root.loadout.has-runes ? root.loadout.keystone : @tr("No rune page active");
                        color: root.loadout.has-runes ? Theme.text : Theme.muted;
                        font-size: Type.body;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if root.loadout.has-runes: Text {
                        text: root.loadout.styles-line != ""
                            ? @tr("{0} · {1}", root.loadout.rune-page, root.loadout.styles-line)
                            : root.loadout.rune-page;
                        color: Theme.muted;
                        font-size: Type.small;
                        overflow: elide;
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.rule; }

            HorizontalLayout {
                horizontal-stretch: 2;
                spacing: Space.sm;
                alignment: start;
                if root.loadout.has-spells: GameIconBadge {
                    y: (parent.height - self.height) / 2;
                    size: 30px;
                    icon: root.loadout.spell1-icon;
                    fallback-text: root.loadout.spell1-initials;
                    border: Theme.gold;
                }
                if root.loadout.has-spells: GameIconBadge {
                    y: (parent.height - self.height) / 2;
                    size: 30px;
                    icon: root.loadout.spell2-icon;
                    fallback-text: root.loadout.spell2-initials;
                    border: Theme.gold;
                }
                Text {
                    text: root.loadout.has-spells
                        ? @tr("{0} + {1}", root.loadout.spell1-name, root.loadout.spell2-name)
                        : @tr("No spells selected");
                    color: root.loadout.has-spells ? Theme.text : Theme.muted;
                    font-size: Type.body;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        if root.narrow: VerticalLayout {
            spacing: Space.sm;
            HorizontalLayout {
                spacing: Space.sm;
                if root.loadout.has-runes: GameIconBadge {
                    y: (parent.height - self.height) / 2;
                    size: 32px;
                    icon: root.loadout.keystone-icon;
                    fallback-text: root.loadout.keystone-initials;
                    border: Theme.gold;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Space.xxs;
                    horizontal-stretch: 1;
                    Text {
                        text: root.loadout.has-runes ? root.loadout.keystone : @tr("No rune page active");
                        color: root.loadout.has-runes ? Theme.text : Theme.muted;
                        font-size: Type.body;
                        font-weight: 700;
                        overflow: elide;
                    }
                    if root.loadout.has-runes: Text {
                        text: root.loadout.styles-line != ""
                            ? @tr("{0} · {1}", root.loadout.rune-page, root.loadout.styles-line)
                            : root.loadout.rune-page;
                        color: Theme.muted;
                        font-size: Type.small;
                        overflow: elide;
                    }
                }
            }
            Divider {}
            HorizontalLayout {
                spacing: Space.sm;
                if root.loadout.has-spells: GameIconBadge {
                    y: (parent.height - self.height) / 2;
                    size: 28px;
                    icon: root.loadout.spell1-icon;
                    fallback-text: root.loadout.spell1-initials;
                    border: Theme.gold;
                }
                if root.loadout.has-spells: GameIconBadge {
                    y: (parent.height - self.height) / 2;
                    size: 28px;
                    icon: root.loadout.spell2-icon;
                    fallback-text: root.loadout.spell2-initials;
                    border: Theme.gold;
                }
                Text {
                    text: root.loadout.has-spells
                        ? @tr("{0} + {1}", root.loadout.spell1-name, root.loadout.spell2-name)
                        : @tr("No spells selected");
                    color: root.loadout.has-spells ? Theme.text : Theme.muted;
                    font-size: Type.body;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

component ChampSelectScreen inherits Flickable {
    in property <ChampSelectView> cs;
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> compact: false;
    property <bool> guide-expanded: false;
    callback open-link(string);
    content-height: body.preferred-height;

    HeroSplash {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 230px;
        splash: root.cs.splash-icon;
    }

    body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.lg;

        Header {
            title: root.cs.title;
            detail: root.cs.detail;
            specimen: root.cs.timer;
            clock-seconds: root.clock-seconds;
            clock-total: root.clock-total;
            active-turn: root.cs.my-turn;
            compact: root.compact;
            glass: true;
        }

        if !root.compact: HorizontalLayout {
            spacing: Space.xl;
            alignment: stretch;

            // Left: 5 allied draft rows, active loadout, and collapsible draft guide.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: Space.sm;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: stretch;
                    SectionLabel { text: @tr("ALLIES DRAFT"); vertical-alignment: center; }
                    if root.cs.anonymized: Rectangle {
                        height: 20px;
                        width: anon-lbl.preferred-width + 14px;
                        border-radius: Theme.radius-sm;
                        background: Theme.panel-raised;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        anon-lbl := Text {
                            text: @tr("Solo/Duo Anonymized");
                            color: Theme.muted;
                            font-size: Type.label;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                for ally in root.cs.allies: RosterRow { ally: ally; }
                if root.cs.loadout.shown: ActiveLoadoutCard {
                    loadout: root.cs.loadout;
                    narrow: root.width < 1000px;
                }
                if root.cs.helper.shown: DraftHelperPanel {
                    h: root.cs.helper;
                    // Side by side needs ~600px beside the 340px map column; stack below that.
                    narrow: root.width < 1000px;
                    expanded <=> root.guide-expanded;
                    open-link(url) => { root.open-link(url); }
                }
            }

            // Right: Rift map, enemy picks, and visual bans
            VerticalLayout {
                width: 340px;
                spacing: Space.md;

                Card {
                    height: 268px;
                    HorizontalLayout {
                        padding: Space.md;
                        alignment: center;
                        LineMap {
                            width: 248px;
                            height: 248px;
                            allies: root.cs.map-allies;
                            show-jungle: true;
                            line-width: 8px;
                            station: 18px;
                            halo: Theme.panel;
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: Space.md;
                        spacing: Space.md;
                        HorizontalLayout {
                            alignment: stretch;
                            SectionLabel { text: @tr("ENEMY TEAM"); vertical-alignment: center; }
                            if root.cs.enemies-to-come > 0: Text {
                                text: @tr("{0} to pick", root.cs.enemies-to-come);
                                color: Theme.muted;
                                font-size: Type.label;
                                horizontal-alignment: right;
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            alignment: start;
                            for e in root.cs.enemies: VerticalLayout {
                                width: 54px;
                                spacing: Space.xs;
                                EnemySlot {
                                    height: 46px;
                                    pick: e;
                                    size: 46px;
                                }
                                Text {
                                    text: e.picked ? e.champion : "—";
                                    color: e.picked ? Theme.text : Theme.muted;
                                    font-size: Type.label;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        SectionLabel { text: @tr("BANS"); }
                        if root.cs.my-ban-list.length > 0: HorizontalLayout {
                            spacing: Space.sm;
                            alignment: start;
                            Text {
                                text: @tr("Blue");
                                width: 44px;
                                color: Theme.blue-soft;
                                font-size: Type.label;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            for b in root.cs.my-ban-list: BanChip { ban: b; mine: true; }
                        }
                        if root.cs.their-ban-list.length > 0: HorizontalLayout {
                            spacing: Space.sm;
                            alignment: start;
                            Text {
                                text: @tr("Red");
                                width: 44px;
                                color: Theme.red-soft;
                                font-size: Type.label;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            for b in root.cs.their-ban-list: BanChip { ban: b; mine: false; }
                        }
                        if root.cs.my-ban-list.length == 0 && root.cs.their-ban-list.length == 0: Text {
                            text: @tr("No champions banned yet");
                            color: Theme.muted;
                            font-size: Type.small;
                        }
                    }
                }
            }
        }

        // Stacked single-column mode for narrow split pane
        if root.compact: VerticalLayout {
            spacing: Space.md;
            SectionLabel { text: @tr("ALLIES DRAFT"); }
            for ally in root.cs.allies: RosterRow { ally: ally; }
            if root.cs.loadout.shown: ActiveLoadoutCard {
                loadout: root.cs.loadout;
                narrow: true;
            }
            if root.cs.helper.shown: DraftHelperPanel {
                h: root.cs.helper;
                narrow: true;
                expanded <=> root.guide-expanded;
                open-link(url) => { root.open-link(url); }
            }

            Card {
                height: 240px;
                LineMap {
                    width: 220px;
                    height: 220px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    allies: root.cs.map-allies;
                    show-jungle: true;
                    line-width: 7px;
                    station: 16px;
                    halo: Theme.panel;
                }
            }

            Card {
                VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;
                    SectionLabel { text: @tr("ENEMY PICKS & BANS"); }
                    HorizontalLayout {
                        spacing: Space.sm;
                        for e in root.cs.enemies: EnemySlot {
                            width: 40px;
                            height: 40px;
                            pick: e;
                            size: 40px;
                        }
                    }
                    if root.cs.my-ban-list.length > 0: HorizontalLayout {
                        spacing: Space.xs;
                        alignment: start;
                        Text {
                            text: @tr("Blue:");
                            color: Theme.blue-soft;
                            font-size: Type.label;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        for b in root.cs.my-ban-list: BanChip { ban: b; mine: true; }
                    }
                    if root.cs.their-ban-list.length > 0: HorizontalLayout {
                        spacing: Space.xs;
                        alignment: start;
                        Text {
                            text: @tr("Red:");
                            color: Theme.red-soft;
                            font-size: Type.label;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        for b in root.cs.their-ban-list: BanChip { ban: b; mine: false; }
                    }
                }
            }
        }
    }
}

// One team's kill count in the live HUD. When it goes up, the figure swells and its plate
// lights in the team colour once (about 350 ms); a drop (a new demo loop) stays silent.
component HudScore inherits Rectangle {
    in property <int> value;
    in property <color> ink;
    in property <bool> compact: false;
    property <int> seen: 0;
    property <bool> pop: false;
    init => { self.seen = self.value; }
    changed value => {
        if self.value > self.seen && Theme.motion {
            self.pop = true;
            settle.running = true;
        }
        self.seen = self.value;
    }
    settle := Timer {
        interval: Theme.dur-fast;
        running: false;
        triggered => {
            self.running = false;
            root.pop = false;
        }
    }
    width: root.compact ? 52px : 64px;
    height: root.compact ? 36px : 44px;
    background: root.ink.with-alpha(root.pop ? 0.6 : 0.2);
    border-width: 1px;
    border-color: root.ink;
    animate background { duration: root.pop ? Theme.dur-fast : Theme.dur-slow; easing: ease-out; }

    Rectangle {
        transform-scale: root.pop ? 1.3 : 1;
        animate transform-scale { duration: root.pop ? Theme.dur-fast : Theme.dur-slow; easing: ease-out; }
        Text {
            text: root.value;
            color: Theme.text;
            font-family: Type.display-family;
            font-size: root.compact ? Type.title : Type.title + 6px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Top of the live screen, over the player's splash: the score band of the in-game HUD (blue
// kills, game clock, red kills), then the player. While the player is dead, the respawn
// countdown takes the player's line, one step per second.
component LiveHud inherits VerticalLayout {
    in property <LiveView> live;
    in property <string> clock;
    // Separate properties: Slint 1.18's code generator mis-moves struct fields read twice.
    property <int> mine: root.live.my-score;
    property <int> theirs: root.live.enemy-score;
    spacing: Space.lg;

    HorizontalLayout {
        alignment: center;
        accessible-role: text;
        accessible-label: @tr("Score: allies {0}, enemies {1}, game time {2}", root.mine, root.theirs, root.clock);
        HudScore { value: root.mine; ink: Theme.blue; }
        Rectangle {
            width: 92px;
            height: 44px;
            background: Theme.panel.with-alpha(Theme.dark ? 0.8 : 0.88);
            border-width: 1px;
            border-color: Theme.gold;
            Text {
                text: root.clock;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.name;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        HudScore { value: root.theirs; ink: Theme.red; }
    }

    HorizontalLayout {
        spacing: Space.lg;
        alignment: start;

        if root.live.active-initials != "" || root.live.active-icon.width > 0: Rectangle {
            width: 56px;
            ChampPlate {
                y: (parent.height - self.height) / 2;
                size: 56px;
                label: root.live.active-initials;
                icon: root.live.active-icon;
                mine: true;
                is-self: true;
                faded: root.live.dead;
            }
        }

        if !root.live.dead: VerticalLayout {
            alignment: center;
            spacing: Space.xxs;
            Text {
                text: root.live.title;
                color: Theme.text;
                font-family: Type.display-family;
                font-size: Type.headline;
                font-weight: 800;
            }
            Text {
                text: root.live.detail;
                color: Theme.muted;
                font-size: Type.body;
                font-weight: 600;
            }
        }

        if root.live.dead: VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: @tr("RESPAWN");
                color: Theme.danger;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 800;
                letter-spacing: 1.5px;
            }
            Text {
                text: Theme.clock-text(Math.max(0, root.live.respawn-seconds));
                color: Theme.danger;
                font-family: Type.display-family;
                font-size: Type.timer + 8px;
                font-weight: 800;
            }
            Text {
                text: root.live.detail;
                color: Theme.muted;
                font-size: Type.body;
                font-weight: 600;
            }
        }
    }
}

// The live Rift map: towers, pits with their countdowns, and each enemy where an event
// last placed them.
component RiftWatchMap inherits LineMap {
    in property <LiveView> live;
    towers: root.live.towers;
    show-jungle: true;
    show-pits: true;
    order-is-mine: root.live.order-is-mine;
    my-drakes: root.live.my-drakes;
    enemy-drakes: root.live.enemy-drakes;
    baron-owner: root.live.baron-owner;
    herald-owner: root.live.herald-owner;
    sightings: root.live.sightings;
    pit-clocks: root.live.pits;
    line-width: 7px;
    station: 17px;
    halo: Theme.panel;
}

// Every enemy with their last known place, then the next monster of each pit.
component RiftWatchList inherits VerticalLayout {
    in property <LiveView> live;
    in property <int> now: -1;
    in property <bool> padded: true;
    padding: root.padded ? Space.md : 0px;
    spacing: Space.xs;
    alignment: start;

    SectionLabel { text: @tr("ENEMIES LAST SEEN"); }
    for s in root.live.sightings: SightingRow { s: s; }
    Text {
        text: @tr("Riot's live data has no positions: only towers, inhibitors and epic monsters place an enemy.");
        color: Theme.muted;
        font-size: Type.label;
        wrap: word-wrap;
    }

    if root.live.pits.length > 0: VerticalLayout {
        spacing: Space.xs;
        padding-top: Space.sm;
        Divider { }
        SectionLabel { text: @tr("NEXT EPIC MONSTERS"); }
        for p in root.live.pits: PitRow { p: p; now: root.now; }
    }
}

component LiveScreen inherits Flickable {
    in property <LiveView> live;
    in property <int> clock-seconds: -1;
    in property <bool> compact: false;
    // Game clock for the pit countdowns: the ticking clock, else the last poll.
    property <int> now: root.clock-seconds >= 0 ? root.clock-seconds : root.live.game-seconds;
    content-height: live-body.preferred-height;

    HeroSplash {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 230px;
        splash: root.live.splash-icon;
    }

    // Death: a dark red veil falls over the splash until the player respawns.
    Rectangle {
        property <color> veil: Theme.dark ? #1c0507 : Theme.danger-soft;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 230px;
        background: @linear-gradient(180deg, self.veil 0%, self.veil 55%, self.veil.with-alpha(0) 100%);
        opacity: root.live.dead ? 0.8 : 0;
        animate opacity { duration: Theme.dur-slow; easing: ease-out; }
    }

    live-body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.lg;

        LiveHud {
            live: root.live;
            clock: root.clock-seconds >= 0 ? Theme.clock-text(root.clock-seconds) : root.live.clock;
        }

        if !root.compact: HorizontalLayout {
            spacing: Space.lg;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Space.sm;
                SectionLabel { text: @tr("ALLIES"); }
                for p in root.live.my-players: PlayerRow { p: p; mine: true; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Space.sm;
                SectionLabel { text: @tr("ENEMIES"); }
                for p in root.live.enemy-players: PlayerRow { p: p; mine: false; }
            }
        }

        if root.compact: VerticalLayout {
            spacing: Space.md;
            SectionLabel { text: @tr("ALLIES"); }
            for p in root.live.my-players: PlayerRow { p: p; mine: true; }
            SectionLabel { text: @tr("ENEMIES"); }
            for p in root.live.enemy-players: PlayerRow { p: p; mine: false; }
        }

        // Rift watch: the map with each enemy's last known place and the pit countdowns, then
        // the list of every enemy and the next monsters.
        if !root.compact: HorizontalLayout {
            spacing: Space.lg;
            alignment: stretch;

            Card {
                width: 336px;
                height: 336px;
                RiftWatchMap {
                    x: 10px;
                    y: 10px;
                    width: 316px;
                    height: 316px;
                    live: root.live;
                    now: root.now;
                }
            }

            Card {
                horizontal-stretch: 1;
                RiftWatchList { live: root.live; now: root.now; }
            }
        }

        if root.compact: Card {
            VerticalLayout {
                padding: Space.md;
                spacing: Space.md;
                Rectangle {
                    height: 280px;
                    RiftWatchMap {
                        x: (parent.width - self.width) / 2;
                        width: 280px;
                        height: 280px;
                        live: root.live;
                        now: root.now;
                    }
                }
                RiftWatchList { live: root.live; now: root.now; padded: false; }
            }
        }

        // Objectives & live event feed
        if !root.compact: Card {
            VerticalLayout {
                padding: Space.md;
                spacing: Space.md;
                SectionLabel { text: @tr("OBJECTIVES & FEED"); }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        text: @tr("Blue");
                        width: 48px;
                        color: Theme.blue-soft;
                        font-size: Type.small;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    ObjectiveRow { horizontal-stretch: 1; chips: root.live.my-objectives; }
                }
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        text: @tr("Red");
                        width: 48px;
                        color: Theme.red-soft;
                        font-size: Type.small;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    ObjectiveRow { horizontal-stretch: 1; chips: root.live.enemy-objectives; }
                }
                Divider { }
                VerticalLayout {
                    spacing: Space.xxs;
                    for line in root.live.feed: FeedRow { line: line; }
                }
            }
        }

        if root.compact: Card {
            VerticalLayout {
                padding: Space.md;
                spacing: Space.sm;
                SectionLabel { text: @tr("OBJECTIVES & FEED"); }
                ObjectiveRow { chips: root.live.my-objectives; empty-text: @tr("No blue objectives"); }
                ObjectiveRow { chips: root.live.enemy-objectives; empty-text: @tr("No red objectives"); }
                Divider { }
                for line in root.live.feed: FeedRow { line: line; }
            }
        }
    }
}

component WaitScreen inherits Flickable {
    in property <WaitView> wait;
    in property <[PartyRow]> party;
    in property <bool> show-party: false;
    in property <bool> is-ready-check: false;
    in property <bool> compact: false;
    in property <bool> telemetry-enabled: false;
    in property <bool> remote-panel-open: false;
    in property <bool> demo: false;
    // Developer build or `--demo`: offers Demo Mode. The public release never shows it.
    in property <bool> dev-tools: false;
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> clock-down: true;
    callback toggle-telemetry();
    callback toggle-remote-panel();
    callback toggle-demo();
    content-height: wait-body.preferred-height;

    SplashBackdrop {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 190px;
        // No champion yet before the draft: the client's Summoner's Rift valley sets the scene.
        splash: ClientArt.backdrop;
        tint: root.is-ready-check ? Theme.signal : Theme.accent;
    }

    wait-body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.xl;

        // Ready check: the medallion takes the stage and carries the clock.
        if root.is-ready-check: VerticalLayout {
            spacing: Space.md;
            HorizontalLayout {
                alignment: center;
                ReadyMedallion {
                    seconds: root.clock-seconds;
                    total: root.clock-total;
                    state: root.wait.ready-state;
                    size: root.compact ? 168px : 220px;
                }
            }
            Text {
                text: root.wait.title;
                color: root.wait.ready-state == 0 ? Theme.signal-text : Theme.text;
                font-family: Type.display-family;
                font-size: Type.headline;
                font-weight: 800;
                horizontal-alignment: center;
                wrap: word-wrap;
                animate color { duration: Theme.dur-slow; easing: ease-out; }
            }
            Text {
                text: root.wait.detail;
                color: Theme.muted;
                font-size: Type.body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        if !root.is-ready-check: Header {
            title: root.wait.title;
            detail: root.wait.detail;
            specimen: root.wait.specimen;
            clock-seconds: root.clock-seconds;
            clock-total: root.clock-total;
            clock-down: root.clock-down;
            compact: root.compact;
        }

        if !root.compact: HorizontalLayout {
            spacing: Space.xl;
            alignment: stretch;

            // Left: Party roster or summoner telemetry ledger
            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    padding: Space.lg;
                    spacing: Space.md;
                    alignment: start;
                    SectionLabel {
                        text: root.show-party
                            ? @tr("PARTY ROSTER")
                            : @tr("YOUR ACCOUNT");
                    }
                    if root.show-party: VerticalLayout {
                        spacing: Space.sm;
                        for m in root.party: Rectangle {
                            height: 46px;
                            border-radius: Theme.radius-sm;
                            background: m.is-self ? Theme.panel-raised : Theme.ground;
                            border-width: 1px;
                            border-color: m.is-self ? Theme.rule-strong : Theme.rule;
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.sm;
                                Text {
                                    text: m.name + (m.is-leader ? @tr(" · Leader") : "");
                                    color: Theme.text;
                                    font-size: Type.body;
                                    font-weight: m.is-self ? 800 : 600;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: Space.md;
                                    if m.first-lane >= 0: HorizontalLayout {
                                        spacing: Space.xs;
                                        Rectangle {
                                            width: 22px;
                                            Roundel {
                                                y: (parent.height - self.height) / 2;
                                                size: 22px;
                                                lane: m.first-lane;
                                            }
                                        }
                                        Text {
                                            text: Theme.lane-name(m.first-lane);
                                            color: Theme.text;
                                            font-size: Type.small;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if m.second-lane >= 0: HorizontalLayout {
                                        spacing: Space.xs;
                                        Rectangle {
                                            width: 22px;
                                            Roundel {
                                                y: (parent.height - self.height) / 2;
                                                size: 22px;
                                                lane: m.second-lane;
                                            }
                                        }
                                        Text {
                                            text: Theme.lane-name(m.second-lane);
                                            color: Theme.muted;
                                            font-size: Type.small;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if !root.show-party: VerticalLayout {
                        spacing: Space.sm;
                        if root.wait.summoner-name != "": HorizontalLayout {
                            spacing: Space.md;
                            GameIconBadge {
                                size: 38px;
                                icon: root.wait.summoner-icon;
                                fallback-text: root.wait.summoner-initials;
                            }
                            Text {
                                text: root.wait.summoner-name;
                                color: Theme.text;
                                font-size: Type.body;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            if root.wait.rank-tier != "": Rectangle {
                                width: 20px;
                                RankedCrest {
                                    y: (parent.height - self.height) / 2;
                                    size: 18px;
                                    tier: root.wait.rank-tier;
                                }
                            }
                        }
                        for n in root.wait.notes: NoteRow { note: n; }
                    }
                }
            }

            // Right: Quick actions & companion readiness
            Card {
                horizontal-stretch: 2;
                VerticalLayout {
                    padding: Space.lg;
                    spacing: Space.md;
                    alignment: start;
                    SectionLabel { text: @tr("GET STARTED"); }
                    if root.show-party: VerticalLayout {
                        for n in root.wait.notes: NoteRow { note: n; }
                    }
                    Text {
                        text: root.demo
                            ? @tr("Demo mode: simulated matches, nothing comes from your account. Switch phases from the left rail.")
                            : @tr("Hypatia only reads what League already shows on this PC. Nothing leaves your machine.");
                        color: Theme.muted;
                        font-size: Type.small;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Space.sm;
                        alignment: start;
                        if !root.demo && root.dev-tools: Action {
                            text: @tr("Try Demo Mode");
                            primary: true;
                            clicked => { root.toggle-demo(); }
                        }
                        if !root.remote-panel-open: Action {
                            text: @tr("Pair Phone QR");
                            clicked => { root.toggle-remote-panel(); }
                        }
                        if !root.telemetry-enabled: Action {
                            text: @tr("Observatory");
                            clicked => { root.toggle-telemetry(); }
                        }
                    }
                }
            }
        }

        if root.compact: VerticalLayout {
            spacing: Space.md;
            Card {
                VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;
                    SectionLabel {
                        text: root.show-party
                            ? @tr("PARTY ROSTER")
                            : @tr("YOUR ACCOUNT");
                    }
                    if !root.show-party && root.wait.summoner-name != "": HorizontalLayout {
                        spacing: Space.md;
                        GameIconBadge {
                            size: 36px;
                            icon: root.wait.summoner-icon;
                            fallback-text: root.wait.summoner-initials;
                        }
                        Text {
                            text: root.wait.summoner-name;
                            color: Theme.text;
                            font-size: Type.body;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        if root.wait.rank-tier != "": Rectangle {
                            width: 18px;
                            RankedCrest {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                tier: root.wait.rank-tier;
                            }
                        }
                    }
                    if root.show-party: VerticalLayout {
                        spacing: Space.sm;
                        for m in root.party: HorizontalLayout {
                            height: 36px;
                            spacing: Space.sm;
                            Text {
                                horizontal-stretch: 1;
                                text: m.name + (m.is-leader ? @tr(" · Leader") : "");
                                color: Theme.text;
                                font-size: Type.small;
                                font-weight: m.is-self ? 800 : 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if m.first-lane >= 0: HorizontalLayout {
                                spacing: Space.xs;
                                Rectangle {
                                    width: 18px;
                                    Roundel {
                                        y: (parent.height - self.height) / 2;
                                        size: 18px;
                                        lane: m.first-lane;
                                    }
                                }
                                Text {
                                    text: Theme.lane-name(m.first-lane);
                                    color: Theme.text;
                                    font-size: Type.label;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            if m.second-lane >= 0: HorizontalLayout {
                                spacing: Space.xs;
                                Rectangle {
                                    width: 18px;
                                    Roundel {
                                        y: (parent.height - self.height) / 2;
                                        size: 18px;
                                        lane: m.second-lane;
                                    }
                                }
                                Text {
                                    text: Theme.lane-name(m.second-lane);
                                    color: Theme.muted;
                                    font-size: Type.label;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    for n in root.wait.notes: NoteRow { note: n; }
                }
            }
        }
    }
}

component TelemetrySourceCard inherits Rectangle {
    in property <TelemetrySourceItem> src;
    horizontal-stretch: 1;
    height: 60px;
    background: Theme.panel-raised;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: src.live ? Theme.live-green : Theme.rule;

    VerticalLayout {
        padding: Space.sm;
        spacing: Space.xxs;
        HorizontalLayout {
            spacing: Space.xs;
            alignment: stretch;
            Text {
                text: src.name;
                color: Theme.text;
                font-size: Type.label;
                font-weight: 800;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: src.port;
                color: src.live ? Theme.live-green : Theme.muted;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        Text {
            text: src.stats;
            color: Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            overflow: elide;
        }
    }
}

component TelemetryEventRow inherits Rectangle {
    in property <TelemetryEventItem> ev;
    in property <bool> selected: false;
    callback clicked();
    height: 44px;
    border-radius: Theme.radius-sm;
    background: selected || touch.has-hover ? Theme.panel-raised : Theme.ground;
    border-width: 1px;
    border-color: selected ? Theme.text : Theme.rule;
    accessible-role: button;
    accessible-label: ev.source + " " + ev.kind + " " + ev.uri;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.sm;

        Text {
            width: 56px;
            text: ev.time;
            color: Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            vertical-alignment: center;
        }

        Rectangle {
            width: 38px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: ev.source-idx == 1 ? Theme.blue : (ev.source-idx == 2 ? Theme.live-green : Theme.rule-strong);
            Text {
                text: ev.source;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ev.uri;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: ev.kind + " · " + ev.preview;
                color: Theme.muted;
                font-size: Type.label;
                overflow: elide;
            }
        }

        Text {
            text: ev.size;
            color: Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TelemetryInspector inherits Rectangle {
    in property <TelemetryView> telemetry;
    in-out property <int> inspector-mode: 0;
    callback toggle-reveal-secrets();
    background: Theme.panel-raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;

    VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;

        HorizontalLayout {
            spacing: Space.sm;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: root.telemetry.inspector-title != "" ? root.telemetry.inspector-title : @tr("Payload Inspector");
                    color: Theme.text;
                    font-family: Type.mono-family;
                    font-size: Type.small;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.telemetry.inspector-meta != "" ? root.telemetry.inspector-meta : @tr("Select any stream row to inspect redacted JSON or state diffs");
                    color: Theme.muted;
                    font-size: Type.label;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: Space.xs;
                Action {
                    text: "JSON";
                    selected: root.inspector-mode == 0;
                    clicked => { root.inspector-mode = 0; }
                }
                Action {
                    text: "Diff";
                    selected: root.inspector-mode == 1;
                    clicked => { root.inspector-mode = 1; }
                }
                Action {
                    text: @tr("Prev");
                    selected: root.inspector-mode == 2;
                    clicked => { root.inspector-mode = 2; }
                }
                if root.telemetry.inspector-has-secrets: Action {
                    text: root.telemetry.secrets-revealed ? @tr("Mask") : @tr("Reveal");
                    selected: root.telemetry.secrets-revealed;
                    clicked => { root.toggle-reveal-secrets(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.backdrop;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.rule;
            clip: true;

            Flickable {
                width: 100%;
                height: 100%;
                content-height: payload-input.preferred-height + 24px;
                payload-input := TextInput {
                    accessible-label: @tr("Event payload");
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                    color: Theme.text;
                    text: root.telemetry.inspector-payload != ""
                        ? root.telemetry.inspector-payload
                        : @tr("// No event selected yet.\n// Click any item above to view its live payload or structural JSON diff.");
                }
            }
        }
    }
}

component TelemetryEventsList inherits Rectangle {
    in property <TelemetryView> telemetry;
    callback select-event(int);
    background: Theme.backdrop;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: ev-col.preferred-height + 16px;
        ev-col := VerticalLayout {
            width: parent.width;
            padding: Space.sm;
            spacing: Space.xs;
            if root.telemetry.events.length == 0: Text {
                text: @tr("No events captured for this filter.");
                color: Theme.muted;
                font-size: Type.small;
                horizontal-alignment: center;
            }
            for ev in root.telemetry.events: TelemetryEventRow {
                ev: ev;
                selected: ev.id == root.telemetry.selected-event-id;
                clicked => { root.select-event(ev.id); }
            }
        }
    }
}

component TelemetryEndpointRow inherits Rectangle {
    in property <TelemetryEndpointItem> ep;
    callback clicked();
    height: 46px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.panel-raised : Theme.ground;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.rule-strong : Theme.rule;
    accessible-role: button;
    accessible-label: @tr("Use GET {0} {1}", ep.method, ep.path);
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.sm;
        Rectangle {
            width: 38px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: ep.source-idx == 0 ? Theme.blue : (ep.source-idx == 2 ? Theme.live-green : Theme.rule-strong);
            Text {
                text: ep.source;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ep.method + " " + ep.path;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: ep.namespace + " · " + ep.origin + " · " + ep.stats;
                color: Theme.muted;
                font-size: Type.label;
                overflow: elide;
            }
        }
        Text {
            text: @tr("Use GET");
            color: touch.has-hover ? Theme.text : Theme.muted;
            font-size: Type.label;
            font-weight: 800;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TelemetryEndpointsList inherits Rectangle {
    in property <TelemetryView> telemetry;
    callback select-endpoint(int, string);
    background: Theme.backdrop;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: ep-col.preferred-height + 16px;
        ep-col := VerticalLayout {
            width: parent.width;
            padding: Space.sm;
            spacing: Space.xs;
            if root.telemetry.endpoints.length == 0: Text {
                text: @tr("No API endpoints matched filter.");
                color: Theme.muted;
                font-size: Type.small;
                horizontal-alignment: center;
            }
            for ep in root.telemetry.endpoints: TelemetryEndpointRow {
                ep: ep;
                clicked => { root.select-endpoint(ep.source-idx, ep.path); }
            }
        }
    }
}

component TelemetrySystemView inherits Rectangle {
    in property <TelemetryView> telemetry;
    background: Theme.backdrop;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: sys-col.preferred-height + 20px;
        sys-col := VerticalLayout {
            width: parent.width;
            padding: Space.md;
            spacing: Space.md;

            SectionLabel { text: @tr("RIOT PROCESSES ({0})", root.telemetry.processes.length); }
            if root.telemetry.processes.length == 0: Text {
                text: @tr("No active Riot or League processes detected.");
                color: Theme.muted;
                font-size: Type.small;
            }
            for p in root.telemetry.processes: Rectangle {
                height: 36px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    spacing: Space.sm;
                    Text {
                        text: p.name + " (PID " + p.pid + ")";
                        color: Theme.text;
                        font-size: Type.small;
                        font-weight: 800;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: p.cpu + " · " + p.mem;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            SectionLabel { text: @tr("LISTENING SOCKETS ({0})", root.telemetry.sockets.length); }
            for s in root.telemetry.sockets: Rectangle {
                height: 32px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    spacing: Space.sm;
                    Text {
                        text: s.proto + " " + s.address;
                        color: Theme.text;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "PID " + s.pid + " · " + s.state;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            SectionLabel { text: @tr("ACTIVE CONNECTIONS ({0})", root.telemetry.connections.length); }
            for c in root.telemetry.connections: Rectangle {
                height: 32px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    spacing: Space.sm;
                    Text {
                        text: c.address;
                        color: Theme.text;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: c.state;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component TelemetryPanel inherits Rectangle {
    in property <TelemetryView> telemetry;
    in-out property <bool> split: true;
    in-out property <int> tab: 0;
    in-out property <int> source-filter: 0;
    in-out property <int> kind-filter: 0;
    in-out property <bool> paused: false;
    in-out property <int> inspector-mode: 0;
    in-out property <int> call-source-idx: 0;
    in-out property <string> call-path: "/lol-summoner/v1/current-summoner";
    in-out property <string> endpoint-filter: "";

    callback close-telemetry();
    callback select-event(int);
    callback toggle-reveal-secrets();
    callback clear-events();
    callback execute-get(int, string);
    callback set-endpoint-filter(string);

    background: Theme.panel;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 100%;
        background: Theme.rule;
    }

    VerticalLayout {
        padding: Space.md;
        spacing: Space.md;

        // Telemetry Header Bar
        HorizontalLayout {
            spacing: Space.sm;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: @tr("OBSERVATORY");
                        color: Theme.text;
                        font-family: Type.display-family;
                        font-size: Type.title;
                        font-weight: 800;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 20px;
                        width: phase-badge.preferred-width + 12px;
                        border-radius: Theme.radius-sm;
                        background: Theme.panel-raised;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        phase-badge := Text {
                            text: root.telemetry.phase;
                            color: Theme.text;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.telemetry.rate + " · " + root.telemetry.total-events;
                    color: Theme.muted;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                }
            }
            HorizontalLayout {
                spacing: Space.sm;
                Action {
                    text: root.split ? @tr("Full View") : @tr("Split View");
                    selected: !root.split;
                    clicked => { root.split = !root.split; }
                }
                Action {
                    text: @tr("Hide");
                    clicked => { root.close-telemetry(); }
                }
            }
        }

        // Sources Summary Strip
        HorizontalLayout {
            spacing: Space.sm;
            for src in root.telemetry.sources: TelemetrySourceCard { src: src; }
        }

        // Sub-tabs (without numeric prefixes)
        HorizontalLayout {
            spacing: Space.sm;
            alignment: stretch;
            Action {
                text: @tr("Live Stream");
                selected: root.tab == 0;
                clicked => { root.tab = 0; }
            }
            Action {
                text: @tr("API Catalog ({0})", root.telemetry.endpoints-total);
                selected: root.tab == 1;
                clicked => { root.tab = 1; }
            }
            Action {
                text: @tr("System");
                selected: root.tab == 2;
                clicked => { root.tab = 2; }
            }
        }

        // Tab 0: Event Stream + Inspector
        if root.tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: Space.sm;

            HorizontalLayout {
                spacing: Space.xs;
                Action { text: @tr("All"); selected: root.source-filter == 0; clicked => { root.source-filter = 0; } }
                Action { text: "LCU"; selected: root.source-filter == 1; clicked => { root.source-filter = 1; } }
                Action { text: "RC"; selected: root.source-filter == 2; clicked => { root.source-filter = 2; } }
                Action { text: @tr("Game"); selected: root.source-filter == 3; clicked => { root.source-filter = 3; } }
                Rectangle { horizontal-stretch: 1; }
                Action {
                    text: root.paused ? @tr("Resume") : "Pause";
                    selected: root.paused;
                    clicked => { root.paused = !root.paused; }
                }
                Action { text: @tr("Clear"); clicked => { root.clear-events(); } }
            }

            HorizontalLayout {
                spacing: Space.xs;
                Action { text: @tr("All types"); selected: root.kind-filter == 0; clicked => { root.kind-filter = 0; } }
                Action { text: @tr("Update"); selected: root.kind-filter == 1; clicked => { root.kind-filter = 1; } }
                Action { text: @tr("Create"); selected: root.kind-filter == 2; clicked => { root.kind-filter = 2; } }
                Action { text: @tr("Delete"); selected: root.kind-filter == 3; clicked => { root.kind-filter = 3; } }
                Action { text: @tr("Call"); selected: root.kind-filter == 4; clicked => { root.kind-filter = 4; } }
            }

            TelemetryEventsList {
                vertical-stretch: 1;
                min-height: 150px;
                telemetry: root.telemetry;
                select-event(id) => { root.select-event(id); }
            }

            TelemetryInspector {
                vertical-stretch: 1;
                min-height: 170px;
                telemetry: root.telemetry;
                inspector-mode <=> root.inspector-mode;
                toggle-reveal-secrets => { root.toggle-reveal-secrets(); }
            }
        }

        // Tab 1: API Catalog & Read-Only GET Runner
        if root.tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: Space.sm;

            Rectangle {
                height: 46px;
                background: Theme.panel-raised;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding: Space.sm;
                    spacing: Space.sm;
                    Action { text: "LCU"; selected: root.call-source-idx == 0; clicked => { root.call-source-idx = 0; } }
                    Action { text: "RC"; selected: root.call-source-idx == 1; clicked => { root.call-source-idx = 1; } }
                    Action { text: ":2999"; selected: root.call-source-idx == 2; clicked => { root.call-source-idx = 2; } }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.backdrop;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.call-path;
                            accessible-label: @tr("GET request path");
                            color: Theme.text;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.execute-get(root.call-source-idx, root.call-path); }
                        }
                    }
                    Action {
                        text: "GET";
                        primary: true;
                        clicked => { root.execute-get(root.call-source-idx, root.call-path); }
                    }
                }
            }

            HorizontalLayout {
                spacing: Space.sm;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    background: Theme.backdrop;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.rule;
                    Text {
                        x: 10px;
                        height: 100%;
                        text: root.endpoint-filter == "" ? @tr("Filter APIs (summoner, lobby, champ-select...)") : "";
                        color: Theme.muted;
                        font-size: Type.small;
                        vertical-alignment: center;
                    }
                    TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text <=> root.endpoint-filter;
                        accessible-label: @tr("Filter APIs");
                        color: Theme.text;
                        font-size: Type.small;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.set-endpoint-filter(self.text); }
                    }
                }
                Text {
                    text: root.telemetry.endpoints-summary;
                    color: Theme.muted;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                    vertical-alignment: center;
                }
            }

            TelemetryEndpointsList {
                vertical-stretch: 1;
                telemetry: root.telemetry;
                select-endpoint(src, path) => {
                    root.call-source-idx = src;
                    root.call-path = path;
                }
            }

            if root.telemetry.call-status != "": Rectangle {
                height: 132px;
                background: Theme.backdrop;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule-strong;
                clip: true;
                VerticalLayout {
                    padding: Space.sm;
                    spacing: Space.xs;
                    Text {
                        text: root.telemetry.call-status;
                        color: Theme.text;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        font-weight: 700;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: call-resp.preferred-height + 8px;
                        call-resp := TextInput {
                            accessible-label: @tr("Call response");
                            width: parent.width;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            text: root.telemetry.call-response;
                            color: Theme.text;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                        }
                    }
                }
            }
        }

        // Tab 2: Processes & Sockets
        if root.tab == 2: TelemetrySystemView {
            vertical-stretch: 1;
            telemetry: root.telemetry;
        }
    }
}

// One figure of the player's game on Results: the value large, its label beneath.
component StatTile inherits Rectangle {
    in property <StatLine> stat;
    in property <bool> compact: false;
    height: root.compact ? 62px : 76px;
    min-width: root.compact ? 0px : 92px;
    border-radius: Theme.radius;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.rule;
    accessible-role: text;
    accessible-label: root.stat.label + ": " + root.stat.value;
    VerticalLayout {
        padding: root.compact ? Space.sm : Space.md;
        alignment: center;
        spacing: Space.xxs;
        Text {
            text: root.stat.value;
            color: Theme.text;
            font-family: Type.display-family;
            font-size: root.compact ? Type.title : Type.title + 4px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: root.stat.label;
            color: Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-alignment: center;
        }
    }
}

// Results: the crest centre stage over the player's splash, the outcome in large type, the
// player's figures, then both teams. A defeat is cold grey: red stays the enemy's colour.
component EndScreen inherits Flickable {
    in property <EndView> end;
    in property <bool> compact: false;
    property <int> view-mode: 0;
    content-height: end-body.preferred-height;

    HeroSplash {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 320px;
        splash: root.end.splash-icon;
    }

    // Defeat: a cold veil mutes the splash.
    if !root.end.victory: Rectangle {
        property <color> veil: Theme.dark ? #0b1119 : Theme.ground;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 320px;
        background: @linear-gradient(180deg, self.veil 0%, self.veil 60%, self.veil.with-alpha(0) 100%);
        opacity: 0.6;
    }

    end-body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.xl;

        VerticalLayout {
            padding-top: Space.lg;
            spacing: Space.sm;
            HorizontalLayout {
                alignment: center;
                ResultCrest {
                    victory: root.end.victory;
                    size: root.compact ? 120px : 150px;
                }
            }
            Text {
                property <bool> shown: false;
                init => { self.shown = true; }
                text: root.end.title;
                color: root.end.victory ? Theme.gold-bright : (Theme.dark ? #aeb6c2 : Theme.muted);
                font-family: Type.display-family;
                font-size: root.compact ? 44px : Type.display;
                font-weight: 800;
                letter-spacing: 3px;
                horizontal-alignment: center;
                opacity: self.shown ? 1 : 0;
                animate opacity { duration: Theme.dur-slow; delay: Theme.dur-fast; easing: ease-out; }
            }
            Text {
                text: root.end.detail;
                color: Theme.muted;
                font-size: Type.body;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: Space.md;
            for t in root.end.tiles: StatTile {
                horizontal-stretch: 1;
                stat: t;
            }
        }

        if root.end.allies.length > 0: HorizontalLayout {
            spacing: Space.xs;
            alignment: start;
            Action {
                text: @tr("Scoreboard");
                selected: root.view-mode == 0;
                clicked => { root.view-mode = 0; }
            }
            Action {
                text: @tr("Damage & Gold");
                selected: root.view-mode == 1;
                clicked => { root.view-mode = 1; }
            }
        }

        if !root.compact && root.end.allies.length > 0: HorizontalLayout {
            spacing: Space.lg;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Space.sm;
                HorizontalLayout {
                    spacing: Space.sm;
                    SectionLabel { text: @tr("ALLIES"); }
                    Text {
                        horizontal-stretch: 1;
                        text: root.end.ally-totals;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                for p in root.end.allies: PlayerRow { p: p; mine: true; show-bar: root.view-mode == 1; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Space.sm;
                HorizontalLayout {
                    spacing: Space.sm;
                    SectionLabel { text: @tr("ENEMIES"); }
                    Text {
                        horizontal-stretch: 1;
                        text: root.end.enemy-totals;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                for p in root.end.enemies: PlayerRow { p: p; mine: false; show-bar: root.view-mode == 1; }
            }
        }

        if root.compact && root.end.allies.length > 0: VerticalLayout {
            spacing: Space.md;
            HorizontalLayout {
                spacing: Space.sm;
                SectionLabel { text: @tr("ALLIES"); }
                Text {
                    horizontal-stretch: 1;
                    text: root.end.ally-totals;
                    color: Theme.muted;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            for p in root.end.allies: PlayerRow { p: p; mine: true; show-bar: root.view-mode == 1; }
            HorizontalLayout {
                spacing: Space.sm;
                SectionLabel { text: @tr("ENEMIES"); }
                Text {
                    horizontal-stretch: 1;
                    text: root.end.enemy-totals;
                    color: Theme.muted;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            for p in root.end.enemies: PlayerRow { p: p; mine: false; show-bar: root.view-mode == 1; }
        }
    }
}

export component MainWindow inherits Window {
    title: "Hypatia";
    icon: @image-url("../assets/hypatia.png");
    default-font-family: Type.family;
    preferred-width: 1320px;
    preferred-height: 820px;
    min-width: 980px;
    min-height: 680px;
    background: Theme.ground;

    in property <Screen> view: Screen.offline;
    in property <bool> demo: false;
    // Demo Mode is a developer tool: shown in debug builds or when launched with `--demo`.
    in property <bool> dev-tools: false;
    in property <string> demo-phase: "";
    in property <string> queue-label;
    in property <bool> remote-enabled: false;
    in-out property <bool> remote-panel-open: false;
    in property <int> remote-clients: 0;
    in property <string> remote-url;
    in property <image> remote-qr;
    in property <bool> lcu-live: false;
    in property <bool> rc-live: false;
    in property <bool> game-live: false;
    in property <string> lcu-port: "";
    in property <string> rc-port: "";
    in property <string> game-port: "";
    in property <WaitView> wait;
    in property <[PartyRow]> party;
    in property <ChampSelectView> champ;
    in property <LiveView> live;
    in property <EndView> end;
    // Running phase clock pushed by Rust four times a second: -1 when the phase has none.
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> clock-down: true;
    // Stop server asks once before it closes the phone link.
    in-out property <bool> remote-confirm-stop: false;

    in-out property <bool> telemetry-enabled: false;
    in-out property <bool> telemetry-split: true;
    in-out property <int> telemetry-tab: 0;
    in-out property <int> telemetry-source-filter: 0;
    in-out property <int> telemetry-kind-filter: 0;
    in-out property <bool> telemetry-paused: false;
    in-out property <int> inspector-mode: 0;
    in-out property <int> call-source-idx: 0;
    in-out property <string> call-path: "/lol-summoner/v1/current-summoner";
    in-out property <string> endpoint-filter: "";
    in property <TelemetryView> telemetry;

    in property <PerfSettings> perf;
    in property <PerfMetrics> perf-metrics;
    in-out property <bool> settings-open: false;
    in-out property <bool> settings-advanced-open: false;
    changed settings-open => { root.performance-panel-changed(self.settings-open); }
    callback toggle-setting(string);
    callback select-perf-profile(string);
    callback apply-recommended-profile();
    callback set-perf-choice(string, int);
    callback clear-ram-cache();
    callback clear-disk-cache();
    callback performance-panel-changed(bool);
    // Champion Stats page in the companion stage (`stats.slint`).
    in-out property <bool> stats-open: false;
    callback open-stats();

    // Update Check: the first-launch question, then the sheet of a newer release.
    in-out property <bool> update-consent-open: false;
    in-out property <bool> update-open: false;
    in property <UpdateView> update;
    callback answer-update-check(bool);
    callback install-update();

    callback toggle-remote-panel();
    callback rotate-remote-token();
    callback disable-remote();
    callback set-dark(bool);
    // Selected interface language ("en" or "fr"); drives the EN/FR switch only.
    in property <string> language: "en";
    callback select-language(string);
    callback toggle-telemetry();
    callback toggle-demo();
    callback select-demo-phase(string);
    callback select-telemetry-event(int);
    callback toggle-reveal-secrets();
    callback clear-telemetry-events();
    callback execute-get-call(int, string);
    callback set-endpoint-filter(string);
    // Opens an allowlisted page (a stats provider, Hypatia's releases) in the browser.
    callback open-link(string);

    // PhaseLine stop for the current screen: 0 lobby .. 4 results, -1 before the lobby.
    pure function current-stop() -> int {
        if (root.view == Screen.lobby) { return 0; }
        if (root.view == Screen.queue || root.view == Screen.ready-check) { return 1; }
        if (root.view == Screen.champ-select) { return 2; }
        if (root.view == Screen.in-game) { return 3; }
        if (root.view == Screen.results) { return 4; }
        return -1;
    }

    HorizontalLayout {
        spacing: 0px;

        // Persistent left workspace rail. Scrolls instead of clipping when the window is short.
        Rectangle {
            width: 216px;
            background: Theme.shell;

            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: 100%;
                background: Theme.rule;
            }

            rail-flick := Flickable {
                width: parent.width - 1px;
                height: 100%;
                content-height: max(self.height, rail-col.preferred-height);

            rail-col := VerticalLayout {
                width: rail-flick.width;
                height: rail-flick.content-height;
                padding: Space.md;
                spacing: Space.md;

                // Brand emblem + title
                HorizontalLayout {
                    height: 40px;
                    spacing: Space.md;
                    alignment: start;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius;
                        clip: true;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("../assets/hypatia.png");
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "HYPATIA";
                            color: Theme.text;
                            font-family: Type.display-family;
                            font-size: Type.title;
                            font-weight: 800;
                            letter-spacing: 0.9px;
                        }
                        Text {
                            text: @tr("LOL COMPANION");
                            color: Theme.muted;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                    }
                }

                Divider { }

                SectionLabel { text: @tr("WORKSPACE"); }

                RailNavItem {
                    label: @tr("Companion");
                    icon-path: "M 3 12 L 12 3 L 21 12 M 5 10 V 20 H 19 V 10";
                    active: (!root.telemetry-enabled || root.telemetry-split) && !root.remote-panel-open && !root.stats-open;
                    clicked => {
                        root.remote-panel-open = false;
                        root.stats-open = false;
                        if (root.telemetry-enabled && !root.telemetry-split) {
                            root.telemetry-split = true;
                        }
                    }
                }

                RailNavItem {
                    label: @tr("Stats");
                    icon-path: "M 4 20 V 10 M 10 20 V 4 M 16 20 V 13 M 22 20 H 2";
                    active: root.stats-open && (!root.telemetry-enabled || root.telemetry-split) && !root.remote-panel-open;
                    clicked => {
                        root.remote-panel-open = false;
                        if (root.telemetry-enabled && !root.telemetry-split) {
                            root.telemetry-split = true;
                        }
                        root.open-stats();
                    }
                }

                RailNavItem {
                    label: @tr("Observatory");
                    icon-path: "M 3 12 H 7 L 10 5 L 14 19 L 17 12 H 21";
                    active: root.telemetry-enabled;
                    badge: root.telemetry-enabled ? (root.telemetry-split ? @tr("SPLIT") : @tr("FULL")) : "";
                    clicked => {
                        root.remote-panel-open = false;
                        root.toggle-telemetry();
                    }
                }

                RailNavItem {
                    label: @tr("Mobile Remote");
                    icon-path: "M 7 3 H 17 V 21 H 7 Z M 11 18 H 13";
                    active: root.remote-panel-open;
                    indicator-live: root.remote-enabled;
                    badge: root.remote-clients > 0
                        ? root.remote-clients + " ON"
                        : (root.remote-enabled ? "QR" : "OFF");
                    clicked => { root.toggle-remote-panel(); }
                }

                RailNavItem {
                    label: "Performance";
                    icon-path: "M 4 6 H 20 M 4 12 H 20 M 4 18 H 20 M 8 4 V 8 M 16 10 V 14 M 10 16 V 20";
                    active: root.settings-open;
                    badge: root.perf.profile-badge;
                    clicked => {
                        root.remote-panel-open = false;
                        root.settings-open = !root.settings-open;
                    }
                }

                if root.dev-tools: Divider { }

                if root.dev-tools: SectionLabel { text: "SIMULATION"; }

                if root.dev-tools: RailNavItem {
                    label: @tr("Demo Mode");
                    icon-path: "M 6 4 L 19 12 L 6 20 Z";
                    active: root.demo;
                    badge: root.demo ? @tr("ON") : "OFF";
                    clicked => { root.toggle-demo(); }
                }

                if root.demo: VerticalLayout {
                    spacing: Space.xs;
                    HorizontalLayout {
                        spacing: Space.xs;
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Lobby");
                            selected: root.view == Screen.lobby;
                            clicked => { root.select-demo-phase("Lobby"); }
                        }
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Queue");
                            selected: root.view == Screen.queue;
                            clicked => { root.select-demo-phase("Matchmaking"); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.xs;
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Ready");
                            selected: root.view == Screen.ready-check;
                            clicked => { root.select-demo-phase("ReadyCheck"); }
                        }
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Champ");
                            selected: root.view == Screen.champ-select;
                            clicked => { root.select-demo-phase("ChampSelect"); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.xs;
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Live");
                            selected: root.view == Screen.in-game;
                            clicked => { root.select-demo-phase("InProgress"); }
                        }
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("End");
                            selected: root.view == Screen.results;
                            clicked => { root.select-demo-phase("EndOfGame"); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Divider { }

                SectionLabel { text: @tr("RIOT SOURCES"); }
                VerticalLayout {
                    spacing: Space.xxs;
                    RailSourceRow {
                        label: @tr("LCU API");
                        port: root.lcu-live && root.lcu-port != "" ? root.lcu-port : (root.lcu-live ? @tr("ready") : @tr("offline"));
                        live: root.lcu-live;
                    }
                    RailSourceRow {
                        label: @tr("Riot Client");
                        port: root.rc-live && root.rc-port != "" ? root.rc-port : (root.rc-live ? @tr("ready") : @tr("offline"));
                        live: root.rc-live;
                    }
                    RailSourceRow {
                        label: @tr("Live Game");
                        port: root.game-live ? ":2999" : @tr("idle");
                        live: root.game-live;
                    }
                }

                Divider { }

                // Language switcher (EN / FR)
                HorizontalLayout {
                    spacing: Space.xs;
                    Action {
                        horizontal-stretch: 1;
                        text: "EN";
                        selected: root.language != "fr";
                        clicked => { root.select-language("en"); }
                    }
                    Action {
                        horizontal-stretch: 1;
                        text: "FR";
                        selected: root.language == "fr";
                        clicked => { root.select-language("fr"); }
                    }
                }

                // Day / Night theme printing switch
                HorizontalLayout {
                    spacing: Space.xs;
                    Action {
                        horizontal-stretch: 1;
                        text: @tr("Dark");
                        selected: Theme.dark;
                        clicked => { root.set-dark(true); }
                    }
                    Action {
                        horizontal-stretch: 1;
                        text: @tr("Light");
                        selected: !Theme.dark;
                        clicked => { root.set-dark(false); }
                    }
                }
            }
            }
        }

        // Right Workspace: Phase Ticker + Responsive Content Stage
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Top 52px Pit-Wall Phase Ticker
            Rectangle {
                height: 52px;
                background: Theme.ground;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.rule;
                }

                HorizontalLayout {
                    padding-left: Space.xl;
                    padding-right: Space.xl;
                    spacing: Space.md;
                    alignment: stretch;

                    PhaseLine {
                        y: (parent.height - self.height) / 2;
                        current: root.current-stop();
                    }

                    Rectangle { horizontal-stretch: 1; }

                    HorizontalLayout {
                        spacing: Space.sm;

                        if root.queue-label != "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 24px;
                            width: q-lbl.preferred-width + 16px;
                            border-radius: Theme.radius-sm;
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: Theme.rule;
                            q-lbl := Text {
                                text: root.queue-label;
                                color: Theme.text;
                                font-size: Type.label;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.demo: Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 24px;
                            width: demo-tag.preferred-width + 14px;
                            border-radius: Theme.radius-sm;
                            background: Theme.panel-raised;
                            border-width: 1px;
                            border-color: Theme.rule-strong;
                            demo-tag := Text {
                                text: @tr("DEMO");
                                color: Theme.text;
                                font-family: Type.mono-family;
                                font-size: Type.label;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.remote-enabled: Action {
                            y: (parent.height - self.height) / 2;
                            text: root.remote-clients > 0
                                ? @tr("Mobile connected ({0})", root.remote-clients)
                                : @tr("Mobile Remote ready");
                            selected: root.remote-panel-open;
                            clicked => { root.toggle-remote-panel(); }
                        }

                        if root.update.available: Action {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Update to {0}", root.update.version);
                            selected: root.update-open;
                            clicked => {
                                root.settings-open = false;
                                root.remote-panel-open = false;
                                root.update-open = true;
                            }
                        }
                    }
                }
            }

            // Main Workspace Split Area + Floating Mobile Remote Pairing Sheet
            workspace-box := Rectangle {
                vertical-stretch: 1;
                clip: true;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 0px;

                    // Companion Stage
                    if !root.telemetry-enabled || root.telemetry-split: stage := Rectangle {
                        horizontal-stretch: 3;
                        min-width: 340px;
                        property <bool> is-compact: self.width < 680px;

                        if root.stats-open: StatsPage {
                            width: 100%;
                            height: 100%;
                            compact: stage.is-compact;
                        }
                        if !root.stats-open && root.view != Screen.champ-select && root.view != Screen.in-game && root.view != Screen.results: WaitScreen {
                            width: 100%;
                            height: 100%;
                            wait: root.wait;
                            party: root.party;
                            show-party: root.view == Screen.lobby && root.party.length > 0;
                            is-ready-check: root.view == Screen.ready-check;
                            compact: stage.is-compact;
                            telemetry-enabled: root.telemetry-enabled;
                            remote-panel-open: root.remote-panel-open;
                            demo: root.demo;
                            dev-tools: root.dev-tools;
                            clock-seconds: root.clock-seconds;
                            clock-total: root.clock-total;
                            clock-down: root.clock-down;
                            toggle-telemetry => { root.toggle-telemetry(); }
                            toggle-remote-panel => { root.toggle-remote-panel(); }
                            toggle-demo => { root.toggle-demo(); }
                        }
                        if !root.stats-open && root.view == Screen.champ-select: ChampSelectScreen {
                            width: 100%;
                            height: 100%;
                            cs: root.champ;
                            clock-seconds: root.clock-seconds;
                            clock-total: root.clock-total;
                            compact: stage.is-compact;
                            open-link(url) => { root.open-link(url); }
                        }
                        if !root.stats-open && root.view == Screen.in-game: LiveScreen {
                            width: 100%;
                            height: 100%;
                            live: root.live;
                            clock-seconds: root.clock-seconds;
                            compact: stage.is-compact;
                        }
                        if !root.stats-open && root.view == Screen.results: EndScreen {
                            width: 100%;
                            height: 100%;
                            end: root.end;
                            compact: stage.is-compact;
                        }
                    }

                    // Telemetry Lab Split or Full Pane
                    if root.telemetry-enabled: TelemetryPanel {
                        horizontal-stretch: 2;
                        min-width: root.telemetry-split ? 380px : 0px;
                        height: 100%;
                        telemetry: root.telemetry;
                        split <=> root.telemetry-split;
                        tab <=> root.telemetry-tab;
                        source-filter <=> root.telemetry-source-filter;
                        kind-filter <=> root.telemetry-kind-filter;
                        paused <=> root.telemetry-paused;
                        inspector-mode <=> root.inspector-mode;
                        call-source-idx <=> root.call-source-idx;
                        call-path <=> root.call-path;
                        endpoint-filter <=> root.endpoint-filter;
                        close-telemetry => { root.toggle-telemetry(); }
                        select-event(id) => { root.select-telemetry-event(id); }
                        toggle-reveal-secrets => { root.toggle-reveal-secrets(); }
                        clear-events => { root.clear-telemetry-events(); }
                        execute-get(src, path) => { root.execute-get-call(src, path); }
                        set-endpoint-filter(f) => { root.set-endpoint-filter(f); }
                    }
                }

                // Mobile Remote pairing: QR code, what the phone can do, and the URL to copy.
                if root.remote-panel-open: pairing := ModalSheet {
                    property <bool> url-copied: false;
                    title: @tr("MOBILE REMOTE PAIRING");
                    subtitle: root.remote-clients > 0
                        ? @tr("{n} phone connected on LAN" | "{n} phones connected on LAN" % root.remote-clients)
                        : @tr("Waiting for QR scan on same Wi-Fi");
                    subtitle-color: root.remote-clients > 0 ? Theme.live-green : Theme.muted;
                    panel-width: 600px;
                    opened => {
                        root.remote-confirm-stop = false;
                        self.url-copied = false;
                    }
                    dismiss => { root.remote-panel-open = false; }

                    HorizontalLayout {
                        spacing: Space.lg;
                        alignment: stretch;

                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 168px;
                                height: 168px;
                                border-radius: Theme.radius;
                                background: Theme.qr-ground;
                                border-width: 1px;
                                border-color: Theme.rule-strong;
                                Image {
                                    width: 152px;
                                    height: 152px;
                                    x: 8px;
                                    y: 8px;
                                    source: root.remote-qr;
                                    image-fit: contain;
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: Space.md;

                            Text {
                                text: @tr("Scan the QR code to accept queues, lock picks & bans, swap roles/champions, switch runes, and view live objectives from your phone.");
                                color: Theme.text;
                                font-size: Type.body;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: Space.sm;
                                alignment: start;
                                Action {
                                    text: @tr("New QR code");
                                    clicked => { root.rotate-remote-token(); }
                                }
                                Action {
                                    text: root.remote-confirm-stop
                                        ? @tr("Confirm stop")
                                        : @tr("Stop server");
                                    clicked => {
                                        if (root.remote-confirm-stop) {
                                            root.disable-remote();
                                        } else {
                                            root.remote-confirm-stop = true;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Full width, wrapping: the whole URL stays readable inside the sheet.
                    VerticalLayout {
                        spacing: Space.xs;
                        SectionLabel {
                            text: @tr("DIRECT PAIRING URL");
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            alignment: stretch;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.backdrop;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.rule-strong;
                                HorizontalLayout {
                                    padding-left: Space.sm;
                                    padding-right: Space.sm;
                                    padding-top: 7px;
                                    padding-bottom: 7px;
                                    url-input := TextInput {
                                        read-only: true;
                                        single-line: false;
                                        wrap: char-wrap;
                                        text: root.remote-url;
                                        accessible-label: @tr("Pairing URL");
                                        color: Theme.text;
                                        font-family: Type.mono-family;
                                        font-size: Type.label;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                Action {
                                    text: pairing.url-copied ? @tr("Copied") : @tr("Copy");
                                    clicked => {
                                        url-input.select-all();
                                        url-input.copy();
                                        url-input.clear-selection();
                                        pairing.url-copied = true;
                                    }
                                }
                            }
                        }
                    }
                }

                // First-launch question: may Hypatia ask GitHub for new releases?
                if root.update-consent-open: ModalSheet {
                    title: @tr("CHECK FOR UPDATES?");
                    subtitle: @tr("Asked once. You can change it later in Performance.");
                    panel-width: 560px;
                    dismiss => { root.update-consent-open = false; }

                    Text {
                        text: @tr("Hypatia can ask GitHub, where it is published, whether a newer version is out: when it starts, then twice a day. The request says nothing about you, your account or your games.");
                        color: Theme.text;
                        font-size: Type.body;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("When one is out, a button appears at the top of the window. Nothing is downloaded or installed until you click it.");
                        color: Theme.muted;
                        font-size: Type.small;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Space.sm;
                        alignment: start;
                        Action {
                            primary: true;
                            text: @tr("Check for updates");
                            clicked => { root.answer-update-check(true); }
                        }
                        Action {
                            text: @tr("Don't check");
                            clicked => { root.answer-update-check(false); }
                        }
                    }
                }

                // A newer release: its notes, then install in place or open the release page.
                if root.update-open: ModalSheet {
                    title: @tr("HYPATIA {0} IS OUT", root.update.version);
                    subtitle: @tr("You have {0}", root.update.current);
                    panel-width: 600px;
                    dismiss => {
                        if (!root.update.busy) {
                            root.update-open = false;
                        }
                    }

                    if root.update.notes != "": VerticalLayout {
                        spacing: Space.xs;
                        SectionLabel { text: @tr("WHAT'S NEW"); }
                        Rectangle {
                            background: Theme.ground;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.rule;
                            VerticalLayout {
                                padding: Space.md;
                                Text {
                                    text: root.update.notes;
                                    color: Theme.text;
                                    font-size: Type.small;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.update.installable
                            ? @tr("Hypatia downloads the new version from GitHub, checks it is signed by Hypatia's release key, then restarts. Your settings stay as they are.")
                            : @tr("Download the new version from the release page and put its hypatia.exe in place of this one. Your settings stay as they are.");
                        color: Theme.muted;
                        font-size: Type.small;
                        wrap: word-wrap;
                    }

                    if root.update.status != "": Text {
                        text: root.update.status;
                        color: root.update.failed ? Theme.danger : Theme.text;
                        font-size: Type.small;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Space.sm;
                        alignment: start;
                        if root.update.installable: Action {
                            primary: true;
                            enabled: !root.update.busy;
                            text: root.update.busy ? @tr("Downloading…") : @tr("Install and restart");
                            clicked => { root.install-update(); }
                        }
                        Action {
                            primary: !root.update.installable;
                            text: @tr("Open release page");
                            clicked => { root.open-link(root.update.page-url); }
                        }
                        Action {
                            text: @tr("Later");
                            enabled: !root.update.busy;
                            clicked => { root.update-open = false; }
                        }
                    }
                }

                // Performance & Features sheet: live footprint monitor, simplified presets, and advanced controls.
                if root.settings-open: ModalSheet {
                    title: @tr("PERFORMANCE & FEATURES");
                    subtitle: @tr("Adapt Hypatia to your PC: pick a preset or fine-tune what runs in the background.");
                    panel-width: 640px;
                    dismiss => { root.settings-open = false; }


                    // Live self-footprint readout (sampled only while this sheet is open).
                    Rectangle {
                        background: Theme.ground;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.rule;

                        VerticalLayout {
                            padding: Space.md;
                            spacing: Space.sm;

                            HorizontalLayout {
                                alignment: stretch;
                                spacing: Space.sm;
                                SectionLabel {
                                    text: @tr("THIS APP RIGHT NOW");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.perf.hardware-summary;
                                    color: Theme.muted;
                                    font-family: Type.mono-family;
                                    font-size: Type.label;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }

                            HorizontalLayout {
                                spacing: Space.sm;
                                alignment: stretch;

                                // Memory tile
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 70px;
                                    background: Theme.panel;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.rule;
                                    VerticalLayout {
                                        padding: Space.sm;
                                        alignment: center;
                                        spacing: Space.xxs;
                                        Text {
                                            text: root.perf-metrics.ram-text;
                                            color: Theme.text;
                                            font-family: Type.mono-family;
                                            font-size: Type.name;
                                            font-weight: 800;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: @tr("MEMORY");
                                            color: Theme.muted;
                                            font-family: Type.mono-family;
                                            font-size: Type.label;
                                            font-weight: 700;
                                            letter-spacing: 0.8px;
                                        }
                                    }
                                }

                                // CPU tile
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 70px;
                                    background: Theme.panel;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.rule;
                                    VerticalLayout {
                                        padding: Space.sm;
                                        alignment: center;
                                        spacing: Space.xxs;
                                        Text {
                                            text: root.perf-metrics.cpu-text;
                                            color: Theme.text;
                                            font-family: Type.mono-family;
                                            font-size: Type.name;
                                            font-weight: 800;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: @tr("CPU");
                                            color: Theme.muted;
                                            font-family: Type.mono-family;
                                            font-size: Type.label;
                                            font-weight: 700;
                                            letter-spacing: 0.8px;
                                        }
                                    }
                                }

                                // Asset cache tile (RAM + disk)
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 70px;
                                    background: Theme.panel;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.rule;
                                    VerticalLayout {
                                        padding: Space.sm;
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: root.perf-metrics.cache-ram-text;
                                            color: Theme.text;
                                            font-family: Type.mono-family;
                                            font-size: Type.small + 2px;
                                            font-weight: 800;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: @tr("Disk: {0}", root.perf-metrics.cache-disk-text);
                                            color: Theme.muted;
                                            font-family: Type.mono-family;
                                            font-size: Type.label;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: @tr("ASSET CACHE");
                                            color: Theme.muted;
                                            font-family: Type.mono-family;
                                            font-size: Type.label;
                                            font-weight: 700;
                                            letter-spacing: 0.8px;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: Space.sm;
                                alignment: stretch;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: Space.xxs;
                                    Text {
                                        text: root.perf-metrics.cadence-text;
                                        color: Theme.muted;
                                        font-family: Type.mono-family;
                                        font-size: Type.label;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }
                                    if root.perf-metrics.status-note != "": Text {
                                        text: root.perf-metrics.status-note;
                                        color: Theme.text;
                                        font-size: Type.label;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: Space.xs;
                                        Action {
                                            text: @tr("Clear RAM cache");
                                            clicked => { root.clear-ram-cache(); }
                                        }
                                        Action {
                                            text: @tr("Clear disk cache");
                                            clicked => { root.clear-disk-cache(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Simplified Mode
                    VerticalLayout {
                        spacing: Space.xs;
                        SectionLabel { text: @tr("PERFORMANCE PROFILE"); }

                        HorizontalLayout {
                            spacing: Space.xs;
                            alignment: start;
                            Action {
                                text: @tr("Auto");
                                enabled: root.perf.profile != root.perf.recommended-profile;
                                clicked => { root.apply-recommended-profile(); }
                            }
                            Action {
                                text: @tr("Ultra-light");
                                selected: root.perf.profile == "ultra_light";
                                clicked => { root.select-perf-profile("ultra_light"); }
                            }
                            Action {
                                text: @tr("Eco");
                                selected: root.perf.profile == "eco";
                                clicked => { root.select-perf-profile("eco"); }
                            }
                            Action {
                                text: @tr("Balanced");
                                selected: root.perf.profile == "balanced";
                                clicked => { root.select-perf-profile("balanced"); }
                            }
                            if root.perf.profile == "custom": Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 30px;
                                width: custom-lbl.preferred-width + 18px;
                                border-radius: Theme.radius-sm;
                                background: Theme.panel-raised;
                                border-width: 1px;
                                border-color: Theme.text;
                                custom-lbl := Text {
                                    text: @tr("Custom");
                                    color: Theme.text;
                                    font-size: Type.small;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: @tr("Recommended for this PC: {0}", root.perf.recommended-label);
                            color: Theme.text;
                            font-size: Type.small;
                            font-weight: 700;
                        }
                        Text {
                            text: root.perf.profile-summary;
                            color: Theme.muted;
                            font-size: Type.small;
                            wrap: word-wrap;
                        }
                    }

                    Divider { }

                    // Advanced disclosure toggle
                    HorizontalLayout {
                        spacing: Space.md;
                        alignment: stretch;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Space.xxs;
                            SectionLabel { text: @tr("ADVANCED CONTROLS"); }
                            Text {
                                text: @tr("Adjust individual polling rates, image memory limits, sleep behavior, and background connections.");
                                color: Theme.muted;
                                font-size: Type.small;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Action {
                                text: root.settings-advanced-open ? @tr("Hide") : @tr("Show");
                                selected: root.settings-advanced-open;
                                clicked => { root.settings-advanced-open = !root.settings-advanced-open; }
                            }
                        }
                    }

                    if root.settings-advanced-open: VerticalLayout {
                        spacing: Space.xs;

                        Divider { }
                        SectionLabel { text: @tr("POLLING & SLEEP"); }

                        ChoiceRow {
                            title: @tr("Live game polling");
                            detail: @tr("How often Live Client Data (:2999) refreshes while a match is running.");
                            options: ["1 s", "2 s", "4 s"];
                            current: root.perf.live-poll-idx;
                            enabled: root.perf.live-game;
                            chosen(idx) => { root.set-perf-choice("live_poll_rate", idx); }
                        }
                        ChoiceRow {
                            title: @tr("Riot client detection");
                            detail: @tr("How often Hypatia scans for League / Riot processes and lockfiles.");
                            options: [@tr("Normal"), @tr("Eco"), @tr("Slow")];
                            current: root.perf.discovery-rate-idx;
                            chosen(idx) => { root.set-perf-choice("discovery_rate", idx); }
                        }
                        ChoiceRow {
                            title: @tr("Interface & clock ticks");
                            detail: @tr("How often timers and UI updates refresh (250 ms smooth or 1 s low CPU).");
                            options: ["250 ms", "1 s"];
                            current: root.perf.clock-rate-idx;
                            chosen(idx) => { root.set-perf-choice("clock_rate", idx); }
                        }
                        SettingRow {
                            title: @tr("Sleep when minimized");
                            detail: @tr("Pauses interface rebuilds and slows clock timers while the main window is minimized.");
                            checked: root.perf.pause-when-minimized;
                            toggled => { root.toggle-setting("pause_when_minimized"); }
                        }

                        Divider { }
                        SectionLabel { text: @tr("VISUALS & ASSET CACHE"); }

                        SettingRow {
                            title: @tr("Game icons");
                            detail: @tr("Fetches and shows champion portraits, spells and profile icons. Otherwise: initials.");
                            checked: root.perf.game-icons;
                            toggled => { root.toggle-setting("game_icons"); }
                        }
                        SettingRow {
                            title: @tr("Client artwork");
                            detail: @tr("Shows cached champion splash art and Summoner's Rift artwork from the League client behind headers and the map.");
                            checked: root.perf.splash-backdrops;
                            enabled: root.perf.game-icons;
                            toggled => { root.toggle-setting("splash_backdrops"); }
                        }
                        ChoiceRow {
                            title: @tr("Image memory budget");
                            detail: @tr("Maximum decoded textures and cached blobs kept in RAM (16, 64, or 256).");
                            options: ["16", "64", "256"];
                            current: root.perf.cache-budget-idx;
                            enabled: root.perf.game-icons;
                            chosen(idx) => { root.set-perf-choice("asset_cache_budget", idx); }
                        }
                        SettingRow {
                            title: @tr("Reduce motion");
                            detail: @tr("Turns every animation off. The Windows animation setting is honoured either way.");
                            checked: root.perf.reduce-motion;
                            toggled => { root.toggle-setting("reduce_motion"); }
                        }
                        SettingRow {
                            title: @tr("Preload showcase art on connect");
                            detail: @tr("Pre-caches ~36 sample icons and splashes when League connects for instant previews.");
                            checked: root.perf.demo-prefetch;
                            enabled: root.perf.game-icons;
                            toggled => { root.toggle-setting("demo_prefetch"); }
                        }

                        Divider { }
                        SectionLabel { text: @tr("CONNECTIONS"); }

                        SettingRow {
                            title: @tr("Live game board");
                            detail: @tr("Reads live scoreboard, towers, and objectives while you play.");
                            checked: root.perf.live-game;
                            toggled => { root.toggle-setting("live_game"); }
                        }
                        SettingRow {
                            title: @tr("Riot Client connection");
                            detail: @tr("Keeps a second WebSocket open to the Riot Client (chat presence).");
                            checked: root.perf.riot-client;
                            toggled => { root.toggle-setting("riot_client"); }
                        }
                        SettingRow {
                            title: @tr("Mobile Remote at launch");
                            detail: @tr("Starts the local pairing server. Off: no port is opened on your network.");
                            checked: root.perf.mobile-remote;
                            toggled => { root.toggle-setting("mobile_remote"); }
                        }
                        SettingRow {
                            title: @tr("Online stats");
                            detail: @tr("Global builds, tier lists and matchups from MetaBot.GG. Sends only champion, role, queue and patch, never who you are.");
                            checked: root.perf.online-stats;
                            toggled => { root.toggle-setting("online_stats"); }
                        }
                        SettingRow {
                            title: @tr("Check for updates");
                            detail: @tr("Asks GitHub at launch and twice a day whether a newer Hypatia is out. Sends nothing about you; installs only when you click.");
                            checked: root.perf.update-check;
                            toggled => { root.toggle-setting("update_check"); }
                        }

                        Divider { }
                        SectionLabel {
                            text: @tr("OBSERVATORY (ONLY ACTIVE WHILE IT IS OPEN)");
                        }

                        SettingRow {
                            title: @tr("System footprint");
                            detail: @tr("Samples Riot process CPU / RAM and lists their ports and connections.");
                            checked: root.perf.system-footprint;
                            toggled => { root.toggle-setting("system_footprint"); }
                        }
                        SettingRow {
                            title: @tr("Endpoint catalog");
                            detail: @tr("Imports the clients' Swagger / help listing (several thousand entries).");
                            checked: root.perf.endpoint-catalog;
                            toggled => { root.toggle-setting("endpoint_catalog"); }
                        }
                        SettingRow {
                            title: @tr("Replay API probe");
                            detail: @tr("Queries /replay/game every 5 seconds during a game.");
                            checked: root.perf.replay-api;
                            toggled => { root.toggle-setting("replay_api"); }
                        }
                    }
                }
            }
        }
    }
}
