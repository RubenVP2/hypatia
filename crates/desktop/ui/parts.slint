import { Theme, Type, Space } from "theme.slint";

export struct AllyRow {
    lane: int,
    champion: string,
    initials: string,
    icon: image,
    // Splash strip of the chosen skin (prepared `banner` asset); empty until cached.
    banner: image,
    // Pick locked in; false while the champion is only hovered.
    locked: bool,
    spell1-icon: image,
    spell1-name: string,
    spell2-icon: image,
    spell2-name: string,
    player: string,
    rank: string,
    rank-tier: string,
    is-self: bool,
    is-premade: bool,
    picking: bool,
    hidden: bool,
}

export struct BanEntry {
    name: string,
    initials: string,
    icon: image,
}

// One enemy cell; `picked` is false while that enemy has not chosen yet.
export struct EnemyPick {
    champion: string,
    initials: string,
    icon: image,
    picked: bool,
}

export struct TowerDot {
    x: float,
    y: float,
    mine: bool,
    standing: bool,
}

export struct ObjectiveChip {
    kind: int, // 0 Baron, 1 Elder, 2 Drake, 3 Herald, 4 Grubs
    weight: int,
    label: string,
    mine: bool,
}

export struct FeedLine {
    time: string,
    text: string,
    lane: int,
    side: int, // 1 your team, 0 enemy, -1 neutral
}

export struct PlayerLine {
    lane: int,
    champion: string,
    initials: string,
    icon: image,
    // Splash strip of the player's skin (prepared `banner` asset); empty until cached.
    banner: image,
    level: int,
    kda: string,
    cs: int,
    is-self: bool,
    dead: bool,
    respawn: string,
}

export struct MapAlly {
    x: float,
    y: float,
    label: string,
    initials: string,
    icon: image,
    is-self: bool,
    // 0: right, 1: left, 2: above, 3: below
    label-pos: int,
}

// An enemy champion's last known place. Live Client Data has no coordinates: a place is only
// known when an event at a fixed spot (tower, inhibitor, epic pit) credits the champion.
export struct EnemySighting {
    // Plan point (400-unit rift), fanned out when several enemies share a place.
    x: float,
    y: float,
    champion: string,
    initials: string,
    icon: image,
    // False until an event places this enemy; the map then leaves them off.
    seen: bool,
    // Game clock of the sighting, e.g. "14:02".
    time: string,
    place: string,
    // "2 min ago"
    age: string,
    // Seen more than two minutes ago: likely elsewhere by now.
    stale: bool,
    dead: bool,
}

// The epic monster next due in a pit, counted down against the game clock in Slint.
export struct PitClock {
    x: float,
    y: float,
    kind: int, // ObjectiveChip kinds: 0 Baron, 1 Elder, 2 Drake, 3 Herald, 4 Grubs
    label: string,
    spawn-at: int,
}

export struct PartyRow {
    name: string,
    first-lane: int,
    second-lane: int,
    is-leader: bool,
    is-self: bool,
}

export struct StatLine {
    label: string,
    value: string,
}

export struct TelemetrySourceItem {
    id: string,
    name: string,
    status: string,
    live: bool,
    port: string,
    pid: string,
    stats: string,
}

export struct TelemetryEventItem {
    id: int,
    time: string,
    source: string,
    source-idx: int,
    kind: string,
    uri: string,
    size: string,
    preview: string,
    has-secrets: bool,
}

export struct TelemetryEndpointItem {
    source: string,
    source-idx: int,
    method: string,
    path: string,
    namespace: string,
    origin: string,
    stats: string,
    description: string,
}

export struct TelemetryProcessItem {
    pid: string,
    name: string,
    source: string,
    cpu: string,
    mem: string,
    exe: string,
}

export struct TelemetrySocketItem {
    proto: string,
    address: string,
    pid: string,
    state: string,
}

export struct TelemetryView {
    rate: string,
    total-events: string,
    phase: string,
    sources: [TelemetrySourceItem],
    events: [TelemetryEventItem],
    selected-event-id: int,
    inspector-title: string,
    inspector-meta: string,
    inspector-has-secrets: bool,
    secrets-revealed: bool,
    inspector-payload: string,
    endpoints: [TelemetryEndpointItem],
    endpoints-total: int,
    endpoints-summary: string,
    call-status: string,
    call-response: string,
    processes: [TelemetryProcessItem],
    sockets: [TelemetrySocketItem],
    connections: [TelemetrySocketItem],
}

// Bordered panel surface: the one container style every screen section sits on.
export component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;

    // Subtle top metallic bevel highlight.
    Rectangle {
        x: 1px;
        y: 1px;
        width: max(0px, parent.width - 2px);
        height: 1px;
        background: Theme.gold-bright;
        opacity: 0.14;
    }
}

// 1px horizontal hairline between sections.
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.rule;
}

// Lane-colored ring with the LoL position crest.
export component Roundel inherits Rectangle {
    in property <int> lane;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: max(2px, size * 0.12);
    border-color: Theme.lane-color(lane);
    background: Theme.panel-raised;
    accessible-role: text;
    accessible-label: Theme.lane-name(root.lane);

    if root.size >= 16px && Theme.lol-lane-context-path(root.lane) != "": Path {
        property <length> icon-sz: max(10px, root.size * 0.54);
        x: (root.width - self.icon-sz) / 2;
        y: (root.height - self.icon-sz) / 2;
        width: self.icon-sz;
        height: self.icon-sz;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Theme.lol-lane-context-path(root.lane);
        fill: root.lane >= 0 ? Theme.lane-color(root.lane) : Theme.muted;
        opacity: 0.28;
    }

    if root.size >= 16px: Path {
        property <length> icon-sz: max(10px, root.size * 0.54);
        x: (root.width - self.icon-sz) / 2;
        y: (root.height - self.icon-sz) / 2;
        width: self.icon-sz;
        height: self.icon-sz;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: Theme.lol-lane-primary-path(root.lane);
        fill: root.lane >= 0 ? Theme.lane-color(root.lane) : Theme.text;
    }
}

// Reusable square icon badge with local LCU bitmap and clean monogram fallback.
export component GameIconBadge inherits Rectangle {
    in property <image> icon;
    in property <string> fallback-text: "";
    in property <color> badge-bg: Theme.panel-raised;
    in property <color> border: Theme.rule-strong;
    in property <length> size: 22px;
    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    clip: true;
    background: root.badge-bg;
    border-width: 1px;
    border-color: root.border;
    if root.icon.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.icon;
        image-fit: cover;
    }
    if root.icon.width == 0 && root.fallback-text != "": Text {
        text: root.fallback-text;
        color: Theme.text;
        font-family: Type.mono-family;
        font-size: max(10px, root.size * 0.44);
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Team-colored circular Hextech champion portrait.
export component ChampPlate inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> mine: true;
    in property <bool> is-self: false;
    in property <bool> empty: false;
    in property <bool> faded: false;
    in property <length> size: 56px;
    width: size;
    height: size;
    border-radius: size / 2;
    clip: true;
    background: empty ? Theme.panel-raised : Theme.team-color(mine);
    border-width: empty ? 1px : max(1.5px, size * 0.05);
    border-color: empty
        ? Theme.gold
        : (is-self ? Theme.gold-bright : (mine ? Theme.gold : Theme.team-color(mine)));
    opacity: faded ? 0.45 : 1.0;
    animate opacity { duration: Theme.dur-slow; easing: ease-out; }
    if !root.empty && root.icon.width == 0: Text {
        text: root.label;
        color: Theme.on-team;
        font-family: Type.display-family;
        font-size: root.size * 0.42;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !root.empty && root.icon.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.icon;
        image-fit: cover;
    }
}

// Compact ranked tier vector crest matching League's rank palette.
export component RankedCrest inherits Rectangle {
    in property <string> tier;
    in property <length> size: 16px;
    width: size;
    height: size;
    background: transparent;
    if root.tier != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 L 20 7 L 17 16 L 12 22 L 7 16 L 4 7 Z";
        fill: Theme.rank-tier-color(root.tier);
        stroke: Theme.gold-bright;
        stroke-width: 1.2px;
    }
    if root.tier != "": Path {
        x: root.size * 0.28;
        y: root.size * 0.25;
        width: root.size * 0.44;
        height: root.size * 0.44;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 3 L 21 12 L 12 21 L 3 12 Z";
        fill: #ffffff;
        opacity: 0.42;
    }
}

// Cached champion splash backdrop (or atmospheric Hextech crest when no splash is cached yet).
export component SplashBackdrop inherits Rectangle {
    in property <image> splash;
    in property <color> tint: Theme.accent;
    in property <color> surface: Theme.ground;
    in property <bool> card-mode: false;
    clip: true;
    background: transparent;

    if root.splash.width > 0: Image {
        x: root.card-mode ? parent.width * 0.22 : 0px;
        y: 0px;
        width: root.card-mode ? parent.width * 0.78 : parent.width;
        height: parent.height;
        source: root.splash;
        image-fit: cover;
        opacity: root.card-mode
            ? (Theme.dark ? 0.48 : 0.28)
            : (Theme.dark ? 0.30 : 0.18);
    }

    if root.splash.width == 0: Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(110deg, root.surface 0%, root.tint 100%);
        opacity: root.card-mode
            ? (Theme.dark ? 0.16 : 0.09)
            : (Theme.dark ? 0.10 : 0.05);
    }

    if root.splash.width == 0: Path {
        x: parent.width - parent.height * 1.15;
        y: -parent.height * 0.15;
        width: parent.height * 1.3;
        height: parent.height * 1.3;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 L 21 7 L 21 17 L 12 22 L 3 17 L 3 7 Z M 12 5.5 L 18 9 V 15 L 12 18.5 L 6 15 V 9 Z M 12 9 L 15 12 L 12 15 L 9 12 Z";
        stroke: Theme.gold-bright;
        stroke-width: 0.9px;
        fill: transparent;
        opacity: 0.18;
    }

    // Readability veil fading smoothly from left text area toward the right art showcase.
    if root.card-mode: Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(90deg, root.surface 0%, root.surface 28%, transparent 88%);
    }
    if !root.card-mode: Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, transparent 0%, root.surface 96%);
    }
    if !root.card-mode: Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(90deg, root.surface 0%, transparent 55%, root.surface 100%);
        opacity: 0.72;
    }
}

// The ready check, centre stage: the client's valley medallion inside a countdown ring that
// loses one notch per second (no tween: see the drain bar). On arrival it scales in and an amber
// halo pulses twice, then everything holds still. Accepting turns the ring Hextech cyan with a
// check; declining turns it red with a cross. The medallion is always a dark object, in Day too.
export component ReadyMedallion inherits Rectangle {
    in property <int> seconds: -1;
    in property <int> total: 10;
    // 0 waiting for the player, 1 accepted, 2 declined.
    in property <int> state: 0;
    in property <length> size: 220px;
    width: root.size;
    height: root.size;
    accessible-role: text;
    accessible-label: root.state == 1
        ? @tr("Match accepted")
        : (root.state == 2 ? @tr("Match declined") : @tr("Match found, {0} left", Theme.clock-text(Math.max(0, root.seconds))));

    property <bool> fired: false;
    init => { self.fired = true; }
    // Share of the ring still lit, and where its arc ends (100-unit viewbox, radius 49).
    property <float> left: root.state != 0 ? 1 : Math.clamp(root.seconds / Math.max(1, root.total), 0, 1);
    property <float> end-x: 50 + 49 * Math.sin(root.left * 360deg);
    property <float> end-y: 50 - 49 * Math.cos(root.left * 360deg);
    property <color> ink: root.state == 1
        ? Theme.accent
        : (root.state == 2 ? Theme.red : Theme.urgency-color(Theme.clock-urgency(root.seconds, true)));

    body := Rectangle {
        opacity: root.fired ? 1 : 0;
        transform-scale: root.fired ? 1 : 0.86;
        animate opacity, transform-scale { duration: Theme.dur-slow; easing: ease-out; }

        // Arrival: an amber halo fades out twice, then stays invisible.
        Rectangle {
            x: -10px;
            y: -10px;
            width: parent.width + 20px;
            height: parent.height + 20px;
            border-radius: self.width / 2;
            border-width: 3px;
            border-color: Theme.signal;
            opacity: root.fired ? 0 : 0.9;
            animate opacity { duration: Theme.dur-pulse; iteration-count: 2; easing: ease-out; }
        }

        // Ring track.
        Rectangle {
            border-radius: self.width / 2;
            border-width: 4px;
            border-color: Theme.rule;
        }

        // The valley medallion, clipped to its circle (the client image carries two stand
        // legs below the disc).
        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: self.width;
            border-radius: self.width / 2;
            clip: true;
            background: #182334;
            if ClientArt.ready-check.width > 0: Image {
                x: -parent.width * 0.0125;
                y: 0px;
                width: parent.width * 1.025;
                height: self.width;
                source: ClientArt.ready-check;
                image-fit: fill;
            }
            Rectangle {
                background: @radial-gradient(circle, #05080dd9 0%, #05080d80 55%, #05080d00 100%);
            }
        }

        // Countdown ring: a full circle when lit all round, an arc otherwise.
        if root.left >= 0.999: Rectangle {
            border-radius: self.width / 2;
            border-width: 4px;
            border-color: root.ink;
            animate border-color { duration: Theme.dur-slow; easing: ease-out; }
        }
        if root.left > 0.001 && root.left < 0.999: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: root.ink;
            stroke-width: 4px;
            MoveTo {
                x: 50;
                y: 1;
            }
            ArcTo {
                x: root.end-x;
                y: root.end-y;
                radius-x: 49;
                radius-y: 49;
                large-arc: root.left > 0.5;
                sweep: true;
            }
        }

        if root.state == 0: Text {
            text: root.seconds >= 0 ? Theme.clock-text(root.seconds) : "!";
            color: #eef0f5;
            font-family: Type.display-family;
            font-size: root.size * 0.26;
            font-weight: 800;
            letter-spacing: -1px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.state == 1: Path {
            property <bool> shown: false;
            init => { self.shown = true; }
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.size * 0.34;
            height: self.width;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: #0ac8b9;
            stroke-width: 5px;
            commands: "M 4 12.5 L 9.5 18 L 20 6.5";
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: Theme.dur-slow; easing: ease-out; }
        }
        if root.state == 2: Path {
            property <bool> shown: false;
            init => { self.shown = true; }
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.size * 0.3;
            height: self.width;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: #f0605a;
            stroke-width: 5px;
            commands: "M 6 6 L 18 18 M 18 6 L 6 18";
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: Theme.dur-slow; easing: ease-out; }
        }
    }
}

// The result crest at the top of Results: the client's victory or defeat crest. On arrival it
// settles from 115% with a fade; a victory adds one golden glow that fades out. Then it holds.
export component ResultCrest inherits Rectangle {
    in property <bool> victory;
    in property <length> size: 150px;
    width: root.size;
    height: root.size;
    accessible-role: image;
    accessible-label: root.victory ? @tr("Victory crest") : @tr("Defeat crest");
    property <bool> fired: false;
    init => { self.fired = true; }

    if root.victory: Rectangle {
        x: -root.size * 0.25;
        y: -root.size * 0.25;
        width: root.size * 1.5;
        height: root.size * 1.5;
        background: @radial-gradient(circle, #f0e6d2b3 0%, #c8aa6e59 38%, #c8aa6e00 70%);
        opacity: root.fired ? 0 : 1;
        animate opacity { duration: Theme.dur-reveal; delay: Theme.dur-fast; easing: ease-out; }
    }
    Rectangle {
        opacity: root.fired ? 1 : 0;
        transform-scale: root.fired ? 1 : 1.15;
        animate opacity, transform-scale { duration: Theme.dur-reveal; easing: ease-out; }
        Image {
            width: 100%;
            height: 100%;
            source: root.victory ? ClientArt.victory : ClientArt.defeat;
            image-fit: contain;
        }
    }
}

// Full-bleed splash behind a screen's header (the player's own skin), shown at the strength
// the client gives it, veiled on the left for the headline and fading into the page below.
// The image keeps its own ratio and is shifted up so the band with the champion's face shows.
export component HeroSplash inherits Rectangle {
    in property <image> splash;
    in property <color> surface: Theme.ground;
    clip: true;

    if root.splash.width > 0: Image {
        width: parent.width;
        height: parent.width * root.splash.height / root.splash.width;
        y: -self.height * 0.16;
        source: root.splash;
        image-fit: cover;
        opacity: Theme.dark ? 0.7 : 0.5;
    }
    Rectangle {
        background: @linear-gradient(90deg, root.surface.with-alpha(0.82) 0%, root.surface.with-alpha(0.35) 50%, root.surface.with-alpha(0.15) 100%);
    }
    Rectangle {
        background: @linear-gradient(180deg, root.surface.with-alpha(0) 0%, root.surface.with-alpha(0) 50%, root.surface 100%);
    }
}

// One enemy cell in champion select: an empty socket until that enemy picks, then the portrait
// arrives (scale and fade) with a red ring that fades out once.
export component EnemySlot inherits Rectangle {
    in property <EnemyPick> pick;
    in property <length> size: 46px;
    accessible-role: text;
    accessible-label: root.pick.picked ? root.pick.champion : @tr("Enemy not picked yet");

    if !root.pick.picked: ChampPlate {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.size;
        empty: true;
        mine: false;
    }
    if root.pick.picked: reveal := Rectangle {
        property <bool> fired: false;
        init => { self.fired = true; }
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        opacity: self.fired ? 1 : 0;
        transform-scale: self.fired ? 1 : 0.8;
        animate opacity, transform-scale { duration: Theme.dur-slow; easing: ease-out; }
        ChampPlate {
            size: root.size;
            label: root.pick.initials;
            icon: root.pick.icon;
            mine: false;
        }
        Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: Theme.red;
            opacity: reveal.fired ? 0 : 1;
            animate opacity { duration: Theme.dur-reveal; easing: ease-out; }
        }
    }
}

export component SectionLabel inherits Text {
    color: Theme.muted;
    font-size: Type.label;
    font-weight: 600;
    letter-spacing: 0.9px;
}

// Phase headline plate. A quiet panel by default; it turns amber only when the player must act
// (their pick or ban, a ready check) and announces that moment with a ring that fades twice.
export component Plate inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> active-turn: false;
    in property <image> splash;
    in property <color> splash-tint: Theme.accent;
    // Translucent over a hero splash, without a splash of its own.
    in property <bool> glass: false;
    in property <length> title-size: Type.headline;
    background: active-turn ? Theme.signal : (glass ? Theme.panel.with-alpha(Theme.dark ? 0.58 : 0.66) : Theme.panel);
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: active-turn ? Theme.signal : Theme.rule-strong;
    accessible-role: text;
    accessible-label: root.title + ". " + root.detail;
    animate background, border-color { duration: Theme.dur-base; easing: ease-out; }

    // Embedded splash art / Hextech crest inside the header banner (hidden during amber alerts).
    if !root.active-turn && !root.glass: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: parent.border-radius;
        clip: true;
        SplashBackdrop {
            width: 100%;
            height: 100%;
            splash: root.splash;
            tint: root.splash-tint;
            surface: Theme.panel;
            card-mode: true;
        }
    }

    // Left metallic bar when calm (keeps amber strictly for active-turn).
    if !root.active-turn: Rectangle {
        x: 0px;
        y: 6px;
        width: 3px;
        height: max(0px, parent.height - 12px);
        background: Theme.gold-bright;
    }

    // Created when the turn starts: its opacity runs 1 -> 0 twice, then it stays invisible.
    // An animation never plays on an element's first value, so `init` flips `fired` after
    // creation to give the opacity binding a change to animate.
    if root.active-turn: Rectangle {
        property <bool> fired: false;
        init => { self.fired = true; }
        x: -5px;
        y: -5px;
        width: parent.width + 10px;
        height: parent.height + 10px;
        border-radius: parent.border-radius + 4px;
        border-width: 2px;
        border-color: Theme.signal;
        opacity: self.fired ? 0 : 1;
        animate opacity { duration: Theme.dur-pulse; iteration-count: 2; easing: ease-out; }
    }

    VerticalLayout {
        padding-left: Space.lg;
        padding-right: Space.xl;
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.xs;
        Text {
            text: root.title;
            color: root.active-turn ? Theme.on-signal : Theme.text;
            font-family: Type.display-family;
            font-size: root.title-size;
            font-weight: 800;
            letter-spacing: 0.3px;
            wrap: word-wrap;
            animate color { duration: Theme.dur-base; }
        }
        if root.detail != "": Text {
            text: root.detail;
            color: root.active-turn ? Theme.on-signal-muted : Theme.muted;
            font-size: Type.body;
            font-weight: 600;
            wrap: word-wrap;
        }
    }
}

// Condensed display figure: the one large number on a screen.
export component Specimen inherits Text {
    font-family: Type.display-family;
    font-size: Type.specimen;
    font-weight: 800;
    letter-spacing: -1px;
    color: Theme.text;
    horizontal-alignment: right;
    vertical-alignment: center;
}

// A running phase clock. Counting down, it turns amber at 10 s and red at 5 s while a 3px bar
// beneath it drains with the time left. Counting up (queue, game time) it stays calm.
export component ClockReadout inherits Rectangle {
    in property <int> seconds: -1;
    in property <int> total: 0;
    in property <bool> down: true;
    // Shown when no clock runs.
    in property <string> fallback: "";
    in property <length> size: Type.specimen;
    in property <bool> align-left: false;
    property <int> urgency: Theme.clock-urgency(root.seconds, root.down);
    property <color> ink: Theme.urgency-color(root.urgency);
    property <bool> has-bar: root.down && root.total > 0 && root.seconds >= 0;
    // Barlow Condensed's descent (200/1000 em): the empty band under the digits, which have
    // no descenders. The drain bar sits in it, so it needs no room of its own.
    property <length> descent: root.size * 0.2;
    min-width: figure.preferred-width + 12px;
    min-height: figure.preferred-height;
    accessible-role: text;
    accessible-label: root.seconds >= 0
        ? @tr("Time: {0}", Theme.clock-text(root.seconds))
        : root.fallback;

    figure := Text {
        // Its own size, not the parent's (the default outside a layout): the bar below is
        // placed and sized from it, and would otherwise land under the next panel.
        width: self.preferred-width;
        height: self.preferred-height;
        x: root.align-left ? 0px : parent.width - self.width;
        y: (parent.height - self.height) / 2;
        text: root.seconds >= 0 ? Theme.clock-text(root.seconds) : root.fallback;
        font-family: Type.display-family;
        font-size: root.size;
        font-weight: 800;
        letter-spacing: -1px;
        color: root.seconds >= 0 ? root.ink : Theme.text;
        animate color { duration: Theme.dur-slow; easing: ease-out; }
    }

    if root.has-bar: Rectangle {
        x: figure.x;
        y: figure.y + figure.height - root.descent + 6px;
        width: figure.width;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.rule;
        clip: true;
        // Steps once per second, unanimated on purpose. Any `animate` here (on width, or on a
        // scale) kept the window repainting at ~36 fps for the whole draft under Slint 1.18:
        // the animation never reported itself finished. A step of a few pixels needs no tween;
        // the figure above already marks each second.
        Rectangle {
            x: root.align-left ? 0px : parent.width - self.width;
            height: 100%;
            width: parent.width * Math.clamp(root.seconds / Math.max(1, root.total), 0, 1);
            background: root.ink;
        }
    }
}

// Instrument button. `selected` is a quiet toggle state (raised fill, ink border); `primary`
// marks the one main action of a panel (ivory fill). Neither is amber: amber means urgency.
export component Action inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    min-width: label.preferred-width + 20px;
    border-radius: Theme.radius-sm;
    background: primary
        ? Theme.plate
        : (selected || (touch.has-hover && enabled) ? Theme.panel-raised : Theme.panel);
    border-width: 1px;
    border-color: primary
        ? Theme.plate
        : selected
            ? Theme.text
            : (touch.has-hover && enabled ? Theme.rule-strong : Theme.rule);
    opacity: enabled ? 1.0 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    animate background, border-color { duration: Theme.dur-fast; easing: ease-out; }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-plate : Theme.text;
        font-size: Type.small;
        font-weight: root.selected || root.primary ? 800 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                focus.focus();
                root.clicked();
            }
        }
    }
    focus := FocusScope {
        // A FocusScope on top of the TouchArea would otherwise eat the first press to take
        // focus, so the button only fired on a second click. The TouchArea focuses it instead.
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: parent.border-radius + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

// Left navigation rail item with uniform 2px vector icon and crisp active state.
export component RailNavItem inherits Rectangle {
    in property <string> label;
    in property <string> badge: "";
    in property <string> icon-path;
    in property <bool> active: false;
    in property <bool> indicator-live: false;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius-sm;
    background: active || touch.has-hover ? Theme.panel-raised : transparent;
    border-width: 1px;
    border-color: active ? Theme.rule-strong : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    animate background, border-color { duration: Theme.dur-fast; easing: ease-out; }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;
        alignment: stretch;

        Rectangle {
            width: 16px;
            Path {
                x: 0px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon-path;
                stroke: root.active ? Theme.text : Theme.muted;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
        }

        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.muted;
            font-size: Type.small;
            font-weight: root.active ? 800 : 600;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.indicator-live: Rectangle {
            width: 8px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 7px;
                height: 7px;
                border-radius: self.width / 2;
                background: Theme.live-green;
            }
        }

        if root.badge != "": Rectangle {
            width: badge-txt.preferred-width + 12px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: root.active ? Theme.plate : Theme.panel-raised;
            border-width: 1px;
            border-color: root.active ? Theme.plate : Theme.rule;
            badge-txt := Text {
                text: root.badge;
                color: root.active ? Theme.on-plate : Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if focus.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: parent.border-radius + 2px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

// Compact source telemetry indicator in the workspace rail.
export component RailSourceRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> port;
    in property <bool> live: false;
    height: 22px;
    spacing: Space.sm;
    alignment: stretch;

    Rectangle {
        width: 8px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: 7px;
            border-radius: self.width / 2;
            background: root.live ? Theme.live-green : Theme.rule-strong;
        }
    }
    Text {
        text: root.label;
        color: root.live ? Theme.text : Theme.muted;
        font-size: Type.label;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.port;
        color: Theme.muted;
        font-family: Type.mono-family;
        font-size: Type.label;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Match progression ticker: Lobby, Queue, Champ Select, In Game, Results.
export component PhaseLine inherits Rectangle {
    // 0 lobby, 1 queue, 2 champ select, 3 in game, 4 results, -1 none
    in property <int> current: -1;
    height: 36px;
    accessible-role: text;
    accessible-label: @tr("Current phase: {0}",
        current == 0 ? @tr("Lobby") : current == 1 ? @tr("Queue") : current == 2 ? @tr("Champ Select")
        : current == 3 ? @tr("Live Game") : current == 4 ? @tr("Results") : @tr("Waiting"));
    property <[string]> stops: [@tr("LOBBY"), @tr("QUEUE"), @tr("CHAMPIONS"), @tr("LIVE"), @tr("RESULTS")];

    HorizontalLayout {
        alignment: start;
        spacing: 0px;
        for stop[i] in root.stops: HorizontalLayout {
            spacing: Space.sm;
            alignment: start;
            if i > 0: Rectangle {
                width: 22px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 2px;
                    width: 100%;
                    background: i <= root.current ? Theme.signal : Theme.rule-strong;
                    animate background { duration: Theme.dur-slow; easing: ease-out; }
                }
            }
            Rectangle {
                width: 12px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: self.width / 2;
                    border-width: 2.5px;
                    border-color: i == root.current
                        ? Theme.signal
                        : (i < root.current ? Theme.text : Theme.rule-strong);
                    background: i == root.current ? Theme.signal : Theme.ground;
                    animate background, border-color { duration: Theme.dur-slow; easing: ease-out; }
                }
            }
            Text {
                text: stop;
                vertical-alignment: center;
                font-family: Type.display-family;
                font-size: Type.body;
                font-weight: i == root.current ? 800 : 700;
                letter-spacing: 0.6px;
                color: i == root.current
                    ? Theme.signal-text
                    : (i < root.current ? Theme.text : Theme.muted);
            }
            Rectangle { width: 8px; }
        }
    }
}

// Client artwork prepared by `hypatia_core::art`: empty images until the League client has
// served it once, then read from the disk cache. Set from Rust, never animated.
export global ClientArt {
    in property <image> map-south;
    in property <image> map-north;
    in property <image> ready-check;
    in property <image> victory;
    in property <image> defeat;
    in property <image> backdrop;
}

// Summoner's Rift map: the client's painted rift when cached, a vector rift otherwise.
// Markers live in a 400-unit plan (Order base bottom-left, Chaos top-right). On the painting
// they are projected through its four lane corners, which absorbs the slight perspective.
// A ring that flares from an element and fades once each time `count` goes up (a tower falls,
// a pit is taken). A drop stays silent, so a reset or a new demo loop never plays it.
export component Ping inherits Rectangle {
    in property <int> count;
    in property <color> ink: Theme.gold-bright;
    property <int> seen: 0;
    property <bool> lit: false;
    init => { self.seen = self.count; }
    changed count => {
        if self.count > self.seen && Theme.motion {
            self.lit = true;
            hold.running = true;
        }
        self.seen = self.count;
    }
    hold := Timer {
        interval: 60ms;
        running: false;
        triggered => {
            self.running = false;
            root.lit = false;
        }
    }
    border-radius: self.width / 2;
    border-width: 2px;
    border-color: root.ink;
    opacity: root.lit ? 1 : 0;
    transform-scale: root.lit ? 1 : 1.9;
    // Lighting is instant; only the fade and the spread are animated.
    animate opacity, transform-scale { duration: root.lit ? 0ms : Theme.dur-reveal; easing: ease-out; }
}

export component LineMap inherits Rectangle {
    in property <[TowerDot]> towers;
    in property <[MapAlly]> allies;
    in property <bool> show-jungle: true;
    in property <bool> show-pits: false;
    in property <bool> order-is-mine: true;
    in property <int> my-drakes: 0;
    in property <int> enemy-drakes: 0;
    in property <int> baron-owner: 0; // 0 none, 1 mine, 2 enemy
    in property <int> herald-owner: 0; // 0 none, 1 mine, 2 enemy
    in property <length> line-width: 8px;
    in property <length> station: 20px;
    in property <color> halo: Theme.panel;
    // Live game: enemies at their last known place, and the countdown to each pit's monster.
    in property <[EnemySighting]> sightings;
    in property <[PitClock]> pit-clocks;
    in property <int> now: -1;

    // The painting puts a light beam on the player's own base.
    property <image> art: root.order-is-mine ? ClientArt.map-south : ClientArt.map-north;
    property <bool> painted: root.art.width > 0;
    // Plan lane corners on the prepared painting (fractions of `MAP_CROP` in art.rs):
    // top-lane corner (40,42), Chaos nexus (358,42), Order nexus (40,348), bot-lane corner (358,348).
    property <float> a-x: 0.162;
    property <float> a-y: 0.305;
    property <float> b-x: 0.833;
    property <float> b-y: 0.267;
    property <float> c-x: 0.105;
    property <float> c-y: 0.725;
    property <float> d-x: 0.912;
    property <float> d-y: 0.720;

    background: Theme.map-ground;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.gold;
    clip: true;
    accessible-role: image;
    accessible-label: @tr("Three-lane map");

    pure function mix(from: float, to: float, k: float) -> float {
        return from + (to - from) * k;
    }

    // Plan point -> fraction of the map box (bilinear through the lane corners when painted).
    pure function fx(x: float, y: float) -> float {
        return root.painted
            ? root.mix(root.mix(root.a-x, root.b-x, (x - 40) / 318), root.mix(root.c-x, root.d-x, (x - 40) / 318), (y - 42) / 306)
            : x / 400;
    }

    pure function fy(x: float, y: float) -> float {
        return root.painted
            ? root.mix(root.mix(root.a-y, root.b-y, (x - 40) / 318), root.mix(root.c-y, root.d-y, (x - 40) / 318), (y - 42) / 306)
            : y / 400;
    }

    // ===== Painted rift from the League client =====
    if root.painted: Image {
        width: 100%;
        height: 100%;
        source: root.art;
        image-fit: fill;
    }

    // ===== Vector rift: jungle plateaus, river, bases, lanes =====
    if !root.painted && root.show-jungle: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        // 4 jungle islands (top-left Order, top-right Chaos, bot-left Order, bot-right Chaos)
        commands: "M 66 156 L 146 218 L 66 290 Z M 138 66 L 306 66 L 208 164 Z M 94 328 L 190 232 L 260 328 Z M 248 190 L 334 108 L 334 252 Z";
        fill: Theme.map-jungle;
    }

    if !root.painted: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 54 78 L 342 316";
        stroke: Theme.map-river;
        stroke-width: root.line-width * 3.4;
        stroke-line-cap: round;
        fill: transparent;
    }

    // Order base pad (bottom-left) & Chaos base pad (top-right)
    if !root.painted: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 18 378 L 18 292 L 106 378 Z";
        fill: Theme.team-color(root.order-is-mine);
        opacity: 0.22;
    }
    if !root.painted: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 382 18 L 382 104 L 294 18 Z";
        fill: Theme.team-color(!root.order-is-mine);
        opacity: 0.22;
    }

    // Curved Summoner's Rift lanes (background road), then each lane's color thread
    if !root.painted: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 40 348 L 40 108 Q 40 42 108 42 L 358 42 M 40 348 L 358 42 M 40 348 L 292 348 Q 358 348 358 282 L 358 42";
        stroke: Theme.map-lane;
        stroke-width: root.line-width * 1.45;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
    if !root.painted: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 40 348 L 40 108 Q 40 42 108 42 L 358 42";
        stroke: Theme.lane-top;
        stroke-width: max(2px, root.line-width * 0.45);
        opacity: 0.55;
        fill: transparent;
    }
    if !root.painted: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 40 348 L 358 42";
        stroke: Theme.lane-mid;
        stroke-width: max(2px, root.line-width * 0.45);
        opacity: 0.55;
        fill: transparent;
    }
    if !root.painted: Path {
        width: 100%; height: 100%;
        viewbox-width: 400; viewbox-height: 400;
        commands: "M 40 348 L 292 348 Q 358 348 358 282 L 358 42";
        stroke: Theme.lane-bot;
        stroke-width: max(2px, root.line-width * 0.45);
        opacity: 0.55;
        fill: transparent;
    }

    // Order & Chaos Nexus diamonds (the painting already shows both nexuses)
    if !root.painted: Path {
        x: root.width * 40 / 400 - root.station * 0.65;
        y: root.height * 348 / 400 - root.station * 0.65;
        width: root.station * 1.3;
        height: root.station * 1.3;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 12 2 L 22 12 L 12 22 L 2 12 Z";
        fill: Theme.team-color(root.order-is-mine);
        stroke: Theme.gold-bright;
        stroke-width: 1.5px;
    }
    if !root.painted: Path {
        x: root.width * 358 / 400 - root.station * 0.65;
        y: root.height * 42 / 400 - root.station * 0.65;
        width: root.station * 1.3;
        height: root.station * 1.3;
        viewbox-width: 24; viewbox-height: 24;
        commands: "M 12 2 L 22 12 L 12 22 L 2 12 Z";
        fill: Theme.team-color(!root.order-is-mine);
        stroke: Theme.gold-bright;
        stroke-width: 1.5px;
    }

    // Baron / Herald Pit (top-left river alcove)
    Rectangle {
        property <color> pit-c: root.baron-owner == 1
            ? Theme.blue
            : (root.baron-owner == 2
                ? Theme.red
                : (root.herald-owner == 1 ? Theme.blue : (root.herald-owner == 2 ? Theme.red : Theme.muted)));
        x: root.width * root.fx(132, 116) - self.width / 2;
        y: root.height * root.fy(132, 116) - self.height / 2;
        width: root.show-pits ? root.station * 1.3 : root.station * 0.95;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.map-ground;
        border-width: 1.5px;
        border-color: (root.baron-owner > 0 || root.herald-owner > 0) ? self.pit-c : Theme.rule-strong;
        opacity: root.show-pits ? 1.0 : 0.65;

        Ping {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            count: root.baron-owner * 3 + root.herald-owner;
            ink: parent.pit-c;
        }

        Path {
            property <length> icon-sz: max(9px, parent.width * 0.62);
            x: (parent.width - self.icon-sz) / 2;
            y: (parent.height - self.icon-sz) / 2;
            width: self.icon-sz;
            height: self.icon-sz;
            viewbox-width: 24; viewbox-height: 24;
            commands: Theme.lol-objective-path(root.baron-owner > 0 || root.herald-owner == 0 ? 0 : 3);
            fill: (root.baron-owner > 0 || root.herald-owner > 0)
                ? parent.pit-c
                : Theme.objective-color(0);
        }
    }

    // Dragon Pit (bottom-right river alcove) + live drake count chip
    Rectangle {
        x: root.width * root.fx(266, 276) - self.width / 2;
        y: root.height * root.fy(266, 276) - self.height / 2;
        width: root.show-pits ? root.station * 1.3 : root.station * 0.95;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.map-ground;
        border-width: 1.5px;
        border-color: (root.my-drakes > 0 || root.enemy-drakes > 0) ? Theme.objective-color(2) : Theme.rule-strong;
        opacity: root.show-pits ? 1.0 : 0.65;

        Ping {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            count: root.my-drakes + root.enemy-drakes;
            ink: Theme.objective-color(2);
        }

        Path {
            property <length> icon-sz: max(9px, parent.width * 0.62);
            x: (parent.width - self.icon-sz) / 2;
            y: (parent.height - self.icon-sz) / 2;
            width: self.icon-sz;
            height: self.icon-sz;
            viewbox-width: 24; viewbox-height: 24;
            commands: Theme.lol-objective-path(2);
            fill: Theme.objective-color(2);
        }
    }

    if root.show-pits && (root.my-drakes > 0 || root.enemy-drakes > 0): Rectangle {
        x: root.width * root.fx(266, 276) - self.width / 2;
        y: root.height * root.fy(266, 276) + root.station * 0.72;
        width: drake-txt.preferred-width + 8px;
        height: 15px;
        border-radius: 3px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.rule-strong;
        drake-txt := Text {
            text: root.my-drakes + ":" + root.enemy-drakes;
            color: Theme.text;
            font-family: Type.mono-family;
            font-size: 9px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Towers =====
    for t in root.towers: Rectangle {
        x: root.width * root.fx(t.x, t.y) - self.width / 2;
        y: root.height * root.fy(t.x, t.y) - self.height / 2;
        width: t.standing ? root.station * 1.15 : root.station * 0.8;
        height: self.width;
        border-radius: self.width / 2;
        background: t.standing ? Theme.map-ground : root.halo;
        border-width: 1.5px;
        border-color: Theme.team-color(t.mine);
        opacity: !t.standing ? 0.55 : 1.0;

        if t.standing: Path {
            property <length> icon-sz: max(9px, parent.width * 0.65);
            x: (parent.width - self.icon-sz) / 2;
            y: (parent.height - self.icon-sz) / 2;
            width: self.icon-sz;
            height: self.icon-sz;
            viewbox-width: 24; viewbox-height: 24;
            commands: Theme.lol-turret-path();
            fill: Theme.team-color(t.mine);
        }

        if !t.standing: Path {
            property <length> icon-sz: max(7px, parent.width * 0.52);
            x: (parent.width - self.icon-sz) / 2;
            y: (parent.height - self.icon-sz) / 2;
            width: self.icon-sz;
            height: self.icon-sz;
            viewbox-width: 24; viewbox-height: 24;
            commands: "M 6 6 L 18 18 M 18 6 L 6 18";
            stroke: Theme.team-color(t.mine);
            stroke-width: 2.2px;
            stroke-line-cap: round;
        }

        // Falls: a ring flares from the tower once (rows are updated in place).
        Ping {
            x: -5px;
            y: -5px;
            width: parent.width + 10px;
            height: parent.height + 10px;
            count: t.standing ? 0 : 1;
            ink: Theme.team-color(t.mine);
        }
    }

    // ===== Pit countdowns: above the dragon pit, below the top-side pit =====
    for p in root.pit-clocks: Rectangle {
        property <int> left: p.spawn-at - root.now;
        property <bool> up: self.left <= 0;
        x: root.width * root.fx(p.x, p.y) - self.width / 2;
        y: p.y > 200
            ? root.height * root.fy(p.x, p.y) - root.station * 0.72 - self.height
            : root.height * root.fy(p.x, p.y) + root.station * 0.72;
        visible: root.now >= 0;
        width: pit-txt.preferred-width + 10px;
        height: 16px;
        border-radius: 3px;
        background: self.up ? Theme.objective-color(p.kind) : Theme.panel;
        border-width: 1px;
        border-color: Theme.objective-color(p.kind);
        accessible-role: text;
        accessible-label: self.up
            ? @tr("{0} is up", p.label)
            : @tr("{0} in {1}", p.label, Theme.clock-text(self.left));
        pit-txt := Text {
            text: parent.up ? @tr("UP") : Theme.clock-text(parent.left);
            color: parent.up ? Theme.on-signal : Theme.text;
            font-family: Type.mono-family;
            font-size: 10px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Enemies at their last known place =====
    for e in root.sightings: Rectangle {
        x: root.width * root.fx(e.x, e.y) - self.width / 2;
        y: root.height * root.fy(e.x, e.y) - self.height / 2;
        width: root.station * 1.45;
        height: self.width;
        visible: e.seen;
        opacity: e.dead ? 0.35 : (e.stale ? 0.6 : 1);
        accessible-role: image;
        accessible-label: @tr("{0}: {1}, {2}", e.champion, e.place, e.age);

        Rectangle {
            border-radius: self.width / 2;
            clip: true;
            background: Theme.red;
            border-width: 2px;
            border-color: Theme.red;
            if e.icon.width > 0: Image {
                width: 100%;
                height: 100%;
                source: e.icon;
                image-fit: cover;
            }
            if e.icon.width == 0: Text {
                text: e.initials;
                color: Theme.on-team;
                font-family: Type.display-family;
                font-size: max(8px, parent.width * 0.42);
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ===== Allies (Champ Select tokens) =====
    for a in root.allies: Rectangle {
        x: root.width * root.fx(a.x, a.y) - self.width / 2;
        y: root.height * root.fy(a.x, a.y) - self.height / 2;
        width: a.is-self ? root.station * 1.65 : root.station * 1.35;
        height: self.width;
        background: transparent;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: self.width / 2;
            clip: true;
            background: a.is-self ? Theme.gold : Theme.blue;
            border-width: 2.5px;
            border-color: a.is-self ? Theme.gold-bright : Theme.blue;

            if a.icon.width > 0: Image {
                width: 100%;
                height: 100%;
                source: a.icon;
                image-fit: cover;
            }
            if a.icon.width == 0 && a.initials != "": Text {
                text: a.initials;
                color: Theme.on-team;
                font-family: Type.display-family;
                font-size: max(9px, parent.width * 0.42);
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: a.label-pos == 1
                ? -self.width - 7px
                : (a.label-pos == 2 || a.label-pos == 3)
                    ? (parent.width - self.width) / 2
                    : parent.width + 7px;
            y: a.label-pos == 2
                ? -self.height - 5px
                : a.label-pos == 3
                    ? parent.height + 5px
                    : (parent.height - self.height) / 2;
            text: a.label;
            // The painting is dark in both printings: light ink with a dark rim stays legible.
            color: a.is-self ? Theme.gold-bright : (root.painted ? #eef0f5 : Theme.text);
            stroke: root.painted ? #05080dd9 : transparent;
            stroke-width: root.painted ? 3px : 0px;
            stroke-style: outside;
            font-size: Type.small;
            font-weight: 800;
            horizontal-alignment: a.label-pos == 1 ? right : ((a.label-pos == 2 || a.label-pos == 3) ? center : left);
        }
    }
}

// One enemy in the "last seen" list: portrait, where they were last placed, and how long ago.
export component SightingRow inherits HorizontalLayout {
    in property <EnemySighting> s;
    spacing: Space.sm;
    height: 34px;
    accessible-role: text;
    accessible-label: @tr("{0}: {1}, {2}", root.s.champion, root.s.place, root.s.age);
    Rectangle {
        width: 28px;
        ChampPlate {
            y: (parent.height - self.height) / 2;
            size: 28px;
            label: root.s.initials;
            icon: root.s.icon;
            mine: false;
            faded: !root.s.seen || root.s.dead;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text {
            text: root.s.champion;
            color: Theme.text;
            font-size: Type.small;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            text: root.s.place;
            color: Theme.muted;
            font-size: Type.label;
            font-weight: 600;
            overflow: elide;
        }
    }
    if root.s.seen: VerticalLayout {
        alignment: center;
        Text {
            text: root.s.time;
            color: root.s.stale ? Theme.muted : Theme.text;
            font-family: Type.mono-family;
            font-size: Type.small;
            font-weight: 700;
            horizontal-alignment: right;
        }
        Text {
            text: root.s.age;
            color: Theme.muted;
            font-size: Type.label;
            horizontal-alignment: right;
        }
    }
}

// The next epic monster of a pit, counting down to its spawn against the game clock.
export component PitRow inherits HorizontalLayout {
    in property <PitClock> p;
    in property <int> now: -1;
    property <int> left: root.p.spawn-at - root.now;
    property <bool> up: self.left <= 0;
    spacing: Space.sm;
    height: 28px;
    accessible-role: text;
    accessible-label: root.up
        ? @tr("{0} is up", root.p.label)
        : @tr("{0} in {1}", root.p.label, Theme.clock-text(root.left));
    Rectangle {
        width: 22px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: Theme.ground;
            border-width: 1px;
            border-color: Theme.objective-color(root.p.kind);
            Path {
                x: 4px;
                y: 4px;
                width: 14px;
                height: 14px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Theme.lol-objective-path(root.p.kind);
                fill: Theme.objective-color(root.p.kind);
            }
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.p.label;
        color: Theme.text;
        font-size: Type.small;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.now < 0 ? "" : (root.up ? @tr("UP") : Theme.clock-text(root.left));
        color: root.up ? Theme.objective-color(root.p.kind) : Theme.text;
        font-family: Type.mono-family;
        font-size: Type.small;
        font-weight: 800;
        vertical-alignment: center;
    }
}

// Match event feed entry with tabular clock timestamp and lane roundel.
export component FeedRow inherits HorizontalLayout {
    in property <FeedLine> line;
    spacing: Space.sm;
    height: 30px;
    Text {
        width: 44px;
        text: root.line.time;
        color: Theme.muted;
        font-family: Type.mono-family;
        font-size: Type.label;
        vertical-alignment: center;
    }
    Rectangle {
        width: 18px;
        Roundel {
            size: 18px;
            lane: root.line.lane;
            y: (parent.height - self.height) / 2;
            visible: root.line.lane >= 0;
        }
    }
    Text {
        text: root.line.text;
        color: root.line.side == 0 ? Theme.red-soft : Theme.text;
        font-size: Type.small;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Objectives ramp: weighted icon chips combining emblem + objective label.
export component ObjectiveRow inherits HorizontalLayout {
    in property <[ObjectiveChip]> chips;
    in property <string> empty-text: @tr("No objectives yet");
    in property <bool> compact: false;
    spacing: root.compact ? 6px : 8px;
    alignment: start;
    height: root.compact ? 22px : 32px;
    if root.chips.length == 0: Text {
        text: root.empty-text;
        color: Theme.muted;
        font-size: Type.small;
        vertical-alignment: center;
    }
    // A layout (not a bare Rectangle) per chip so each one takes its content's width
    // instead of collapsing to zero and overlapping its neighbours.
    for c in root.chips: HorizontalLayout {
        accessible-role: text;
        accessible-label: c.label;

        if root.compact: Rectangle {
            property <bool> fired: false;
            init => { self.fired = true; }
            opacity: self.fired ? 1 : 0;
            animate opacity { duration: Theme.dur-slow; easing: ease-out; }
            width: 14px + c.weight * 3px;
            height: 14px + c.weight * 3px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.panel-raised;
            border-width: 1.5px;
            border-color: Theme.team-color(c.mine);
            Path {
                property <length> icon-sz: max(10px, parent.height - 5px);
                x: (parent.width - self.icon-sz) / 2;
                y: (parent.height - self.icon-sz) / 2;
                width: self.icon-sz;
                height: self.icon-sz;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Theme.lol-objective-path(c.kind);
                fill: Theme.objective-color(c.kind);
            }
        }

        if !root.compact: Rectangle {
            property <bool> fired: false;
            init => { self.fired = true; }
            opacity: self.fired ? 1 : 0;
            animate opacity { duration: Theme.dur-slow; easing: ease-out; }
            height: 26px;
            width: chip-row.preferred-width;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.team-color(c.mine);

            chip-row := HorizontalLayout {
                padding-left: Space.xs;
                padding-right: Space.sm;
                spacing: Space.sm;
                Rectangle {
                    width: 18px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: Theme.radius-sm;
                        background: Theme.ground;
                        Path {
                            x: 3px;
                            y: 3px;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: Theme.lol-objective-path(c.kind);
                            fill: Theme.objective-color(c.kind);
                        }
                    }
                }
                Text {
                    text: c.label;
                    color: Theme.text;
                    font-size: Type.label;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Compact ban chip shown in Champion Select: portrait icon + champion name.
export component BanChip inherits Rectangle {
    in property <BanEntry> ban;
    in property <bool> mine: true;
    // Portrait and strike only, when shown compactly.
    in property <bool> compact: false;
    height: 26px;
    width: row.preferred-width;
    border-radius: Theme.radius-sm;
    background: Theme.panel-raised;
    border-width: 1px;
    border-color: mine ? Theme.blue : Theme.red;
    accessible-role: text;
    accessible-label: root.ban.name;
    // Created when the ban lands: the chip fades in and a red strike draws across the dimmed
    // portrait once. Rows are updated in place, so chips already shown never replay it.
    property <bool> landed: false;
    init => { self.landed = true; }
    opacity: root.landed ? 1 : 0;
    animate opacity { duration: Theme.dur-base; easing: ease-out; }
    row := HorizontalLayout {
        padding-left: Space.xs;
        padding-right: root.compact ? Space.xs : Space.sm;
        spacing: Space.sm;
        Rectangle {
            width: 18px;
            ChampPlate {
                y: (parent.height - self.height) / 2;
                size: 18px;
                label: root.ban.initials;
                icon: root.ban.icon;
                mine: root.mine;
                faded: true;
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                x: (parent.width - self.width) / 2;
                width: 24px;
                height: 2px;
                border-radius: 1px;
                background: Theme.red;
                transform-rotation: -45deg;
                transform-scale-x: root.landed ? 1 : 0;
                animate transform-scale-x { duration: Theme.dur-reveal; delay: Theme.dur-fast; easing: ease-out; }
            }
        }
        if !root.compact: Text {
            text: root.ban.name;
            color: Theme.text;
            font-size: Type.label;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A player's live scoreboard row: lane roundel, champion, stats, KDA.
export component PlayerRow inherits Rectangle {
    in property <PlayerLine> p;
    in property <bool> mine: true;
    height: 50px;
    border-radius: Theme.radius;
    background: p.is-self ? Theme.panel-raised : Theme.panel;
    clip: true;
    accessible-role: text;
    accessible-label: (root.p.is-self ? @tr("{0}, you", root.p.champion) : root.p.champion)
        + ", " + root.p.kda
        + (root.p.dead ? @tr(", dead, respawn in {0}", root.p.respawn) : "");

    // Splash strip of the player's skin on the right, melting into the row; it goes out while
    // the player is dead.
    if root.p.banner.width > 0: Rectangle {
        x: parent.width * 0.42;
        width: parent.width * 0.58;
        height: 100%;
        Image {
            width: 100%;
            height: 100%;
            source: root.p.banner;
            image-fit: cover;
            opacity: root.p.dead ? 0.1 : (Theme.dark ? 0.7 : 0.55);
            animate opacity { duration: Theme.dur-slow; easing: ease-out; }
        }
        Rectangle {
            background: @linear-gradient(90deg, root.background 0%, root.background.with-alpha(0.55) 45%, root.background.with-alpha(0.3) 100%);
        }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        alignment: stretch;
        Rectangle {
            width: 28px;
            Roundel { size: 28px; lane: root.p.lane; y: (parent.height - self.height) / 2; }
        }
        Rectangle {
            width: 36px;
            ChampPlate {
                y: (parent.height - self.height) / 2;
                size: 36px;
                label: root.p.initials;
                icon: root.p.icon;
                mine: root.mine;
                is-self: root.p.is-self;
                faded: root.p.dead;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: (root.p.is-self ? @tr("{0} (you)", root.p.champion) : root.p.champion);
                color: Theme.text;
                font-size: Type.body;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: root.p.dead
                    ? @tr("Respawn {0}", root.p.respawn)
                    : @tr("Lvl {0} · {1} CS", root.p.level, root.p.cs);
                color: root.p.dead ? Theme.danger : Theme.muted;
                font-size: Type.small;
                font-weight: root.p.dead ? 600 : 400;
            }
        }
        Text {
            text: root.p.kda;
            color: Theme.text;
            font-family: Type.mono-family;
            font-size: Type.small;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 68px;
        }
    }

    // Border drawn over the strip.
    Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: root.p.is-self ? Theme.rule-strong : Theme.rule;
    }
}

// One user-toggleable feature: what it does, what it costs, and its ON / OFF switch.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();
    min-height: 50px;

    HorizontalLayout {
        padding-top: Space.sm;
        padding-bottom: Space.sm;
        spacing: Space.md;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Space.xxs;
            Text {
                text: root.title;
                color: root.enabled ? Theme.text : Theme.muted;
                font-size: Type.body;
                font-weight: 800;
            }
            Text {
                text: root.detail;
                color: Theme.muted;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }

        Rectangle {
            width: 58px;
            Action {
                y: (parent.height - self.height) / 2;
                width: 100%;
                text: root.checked ? "ON" : "OFF";
                selected: root.checked;
                enabled: root.enabled;
                accessible-label: root.title;
                clicked => { root.toggled(); }
            }
        }
    }
}

// One discrete multi-option setting: title, detail, and quiet option selector buttons.
export component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <[string]> options;
    in property <int> current: 0;
    in property <bool> enabled: true;
    callback chosen(int);
    min-height: 52px;

    HorizontalLayout {
        padding-top: Space.sm;
        padding-bottom: Space.sm;
        spacing: Space.md;
        alignment: stretch;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Space.xxs;
            Text {
                text: root.title;
                color: root.enabled ? Theme.text : Theme.muted;
                font-size: Type.body;
                font-weight: 800;
            }
            Text {
                text: root.detail;
                color: Theme.muted;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Space.xs;
                alignment: end;
                for opt[i] in root.options: Action {
                    text: opt;
                    selected: root.current == i;
                    enabled: root.enabled;
                    clicked => { root.chosen(i); }
                }
            }
        }
    }
}
