import { Theme, Type, Space } from "theme.slint";
import {
    AllyRow, BanEntry, EnemyPick, TowerDot, ObjectiveChip, FeedLine, PlayerLine, MapAlly, PartyRow, StatLine,
    TelemetrySourceItem, TelemetryEventItem, TelemetryEndpointItem, TelemetryProcessItem,
    TelemetrySocketItem, TelemetryView,
    Roundel, ChampPlate, GameIconBadge, RankedCrest, SplashBackdrop, HeroSplash, EnemySlot, SectionLabel, Plate, Specimen, ClockReadout, Action, RailNavItem, RailSourceRow,
    PhaseLine, LineMap, ClientArt, FeedRow, ObjectiveRow, BanChip, PlayerRow, SettingRow, Card, Divider,
} from "parts.slint";
import "fonts/Overpass-Regular.ttf";
import "fonts/Overpass-SemiBold.ttf";
import "fonts/Overpass-ExtraBold.ttf";
import "fonts/BarlowCondensed-Bold.ttf";
import "fonts/BarlowCondensed-ExtraBold.ttf";
import "fonts/OverpassMono.ttf";

export { Theme, ClientArt }

// Which companion screen the client's gameflow phase maps to. Set from Rust.
export enum Screen {
    // League is not running.
    offline,
    // The client is open but not in a lobby.
    idle,
    lobby,
    queue,
    ready-check,
    champ-select,
    in-game,
    results,
}

// Mirrors `hypatia_core::settings::Settings`: one switch per background activity.
export struct PerfSettings {
    live-game: bool,
    riot-client: bool,
    replay-api: bool,
    game-icons: bool,
    splash-backdrops: bool,
    mobile-remote: bool,
    system-footprint: bool,
    endpoint-catalog: bool,
    eco-mode: bool,
    reduce-motion: bool,
}

export struct WaitView {
    title: string,
    detail: string,
    specimen: string,
    summoner-name: string,
    summoner-initials: string,
    summoner-icon: image,
    rank-tier: string,
    notes: [StatLine],
}

export struct ChampSelectView {
    title: string,
    detail: string,
    timer: string,
    // True while the local player is the one picking or banning.
    my-turn: bool,
    allies: [AllyRow],
    map-allies: [MapAlly],
    enemies: [EnemyPick],
    enemies-to-come: int,
    my-bans: string,
    their-bans: string,
    my-ban-list: [BanEntry],
    their-ban-list: [BanEntry],
    anonymized: bool,
    splash-icon: image,
}

export struct LiveView {
    title: string,
    detail: string,
    dead: bool,
    active-initials: string,
    active-icon: image,
    splash-icon: image,
    my-score: int,
    enemy-score: int,
    clock: string,
    self-kda: string,
    my-drakes: int,
    enemy-drakes: int,
    baron-owner: int,
    herald-owner: int,
    order-is-mine: bool,
    my-players: [PlayerLine],
    enemy-players: [PlayerLine],
    towers: [TowerDot],
    my-objectives: [ObjectiveChip],
    enemy-objectives: [ObjectiveChip],
    feed: [FeedLine],
}

export struct EndView {
    title: string,
    detail: string,
    kda: string,
    victory: bool,
    champion-name: string,
    champion-initials: string,
    champion-icon: image,
    splash-icon: image,
    stats: [StatLine],
}

component NoteRow inherits Rectangle {
    in property <StatLine> note;
    height: 44px;
    HorizontalLayout {
        spacing: Space.md;
        Text {
            text: root.note.label;
            color: Theme.muted;
            font-size: Type.small;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.note.value;
            color: Theme.text;
            font-family: Type.mono-family;
            font-size: Type.small;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.rule;
    }
}

// Phase headline plus the screen's one large figure: a running clock when the phase has one,
// otherwise `specimen` (e.g. the final KDA).
component Header inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> specimen;
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> clock-down: true;
    in property <bool> active-turn: false;
    in property <bool> compact: false;
    in property <image> splash;
    in property <color> splash-tint: Theme.accent;
    // Over a full-bleed hero splash: the plate turns translucent instead of carrying its own.
    in property <bool> glass: false;
    property <bool> has-figure: root.clock-seconds >= 0 || root.specimen != "";
    min-height: 92px;

    if !root.compact: HorizontalLayout {
        spacing: Space.xl;
        alignment: stretch;
        Plate {
            horizontal-stretch: 1;
            title: root.title;
            detail: root.detail;
            active-turn: root.active-turn;
            splash: root.splash;
            splash-tint: root.splash-tint;
            glass: root.glass;
        }
        if root.has-figure: ClockReadout {
            seconds: root.clock-seconds;
            total: root.clock-total;
            down: root.clock-down;
            fallback: root.specimen;
        }
    }

    if root.compact: VerticalLayout {
        spacing: Space.md;
        Plate {
            title: root.title;
            detail: root.detail;
            active-turn: root.active-turn;
            splash: root.splash;
            splash-tint: root.splash-tint;
            glass: root.glass;
        }
        if root.has-figure: ClockReadout {
            seconds: root.clock-seconds;
            total: root.clock-total;
            down: root.clock-down;
            fallback: root.specimen;
            size: Type.specimen-compact;
            align-left: true;
        }
    }
}

component RosterRow inherits Rectangle {
    in property <AllyRow> ally;
    height: 70px;
    border-radius: Theme.radius;
    background: root.ally.picking
        ? Theme.signal-soft
        : (root.ally.is-self ? Theme.panel-raised : Theme.panel);
    clip: true;
    animate background { duration: Theme.dur-base; easing: ease-out; }
    accessible-role: text;
    accessible-label: Theme.lane-name(root.ally.lane) + ", "
        + (root.ally.champion != "" ? root.ally.champion : @tr("no pick yet"))
        + (root.ally.is-self ? @tr(", you") : "")
        + (root.ally.picking ? @tr(", acting now") : "")
        + (root.hovering ? @tr(", hovering") : "");
    // Kept out of the label: Slint 1.18's code generator mis-moves the struct field when the
    // label reads `ally.champion` once more.
    property <bool> hovering: root.ally.champion != "" && !root.ally.locked;

    // Splash strip of the chosen skin on the right, melting into the row on its left so the
    // text column keeps a flat surface. Half strength while the champion is only hovered.
    if root.ally.banner.width > 0: Rectangle {
        x: parent.width * 0.38;
        width: parent.width * 0.62;
        height: 100%;
        Image {
            width: 100%;
            height: 100%;
            source: root.ally.banner;
            image-fit: cover;
            opacity: root.ally.locked ? (Theme.dark ? 0.85 : 0.7) : 0.4;
            animate opacity { duration: Theme.dur-slow; easing: ease-out; }
        }
        Rectangle {
            background: @linear-gradient(90deg, root.background 0%, root.background.with-alpha(0.55) 40%, root.background.with-alpha(0) 100%);
        }
    }

    // Lock-in: created when the pick locks, a gold glint crosses the row once, then rests
    // outside it (clipped). An animation never plays on a first value, hence `init`.
    if root.ally.locked: Rectangle {
        property <bool> fired: false;
        init => { self.fired = true; }
        width: 120px;
        height: 100%;
        x: self.fired ? parent.width : -self.width;
        background: @linear-gradient(90deg, Theme.gold-bright.with-alpha(0) 0%, Theme.gold-bright.with-alpha(0.38) 50%, Theme.gold-bright.with-alpha(0) 100%);
        animate x { duration: Theme.dur-reveal; easing: ease-in-out; }
    }

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.md;
        alignment: stretch;

        Rectangle {
            width: 36px;
            Roundel {
                size: 36px;
                lane: root.ally.lane;
                y: (parent.height - self.height) / 2;
            }
        }

        Rectangle {
            width: 48px;
            ChampPlate {
                y: (parent.height - self.height) / 2;
                size: 48px;
                label: root.ally.initials;
                icon: root.ally.icon;
                mine: true;
                is-self: root.ally.is-self;
                empty: root.ally.champion == "";
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: Space.xs;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: Space.sm;
                alignment: stretch;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: root.ally.champion != "" ? root.ally.champion : @tr("Waiting for pick");
                        color: root.ally.champion != "" ? Theme.text : Theme.muted;
                        font-size: Type.name;
                        font-weight: 800;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.ally.picking: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 20px;
                        width: turn-lbl.preferred-width + 14px;
                        border-radius: Theme.radius-sm;
                        background: Theme.signal;
                        turn-lbl := Text {
                            text: root.ally.is-self
                                ? @tr("YOUR TURN")
                                : @tr("ACTING NOW");
                            color: Theme.on-signal;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.ally.spell1-name != "" || root.ally.spell2-name != "": HorizontalLayout {
                    spacing: Space.xs;
                    alignment: end;
                    if root.ally.spell1-name != "": Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: sp1-row.preferred-width;
                        border-radius: Theme.radius-sm;
                        background: Theme.ground;
                        border-width: 1px;
                        border-color: Theme.rule;
                        sp1-row := HorizontalLayout {
                            padding-left: Space.xs;
                            padding-right: Space.sm;
                            spacing: Space.xs;
                            GameIconBadge {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                icon: root.ally.spell1-icon;
                                fallback-text: "D";
                            }
                            Text {
                                text: root.ally.spell1-name;
                                color: Theme.text;
                                font-size: Type.label;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.ally.spell2-name != "": Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: sp2-row.preferred-width;
                        border-radius: Theme.radius-sm;
                        background: Theme.ground;
                        border-width: 1px;
                        border-color: Theme.rule;
                        sp2-row := HorizontalLayout {
                            padding-left: Space.xs;
                            padding-right: Space.sm;
                            spacing: Space.xs;
                            GameIconBadge {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                icon: root.ally.spell2-icon;
                                fallback-text: "F";
                            }
                            Text {
                                text: root.ally.spell2-name;
                                color: Theme.text;
                                font-size: Type.label;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Space.xs;
                alignment: start;
                if !root.ally.hidden && root.ally.rank-tier != "": Rectangle {
                    width: 15px;
                    RankedCrest {
                        y: (parent.height - self.height) / 2;
                        size: 15px;
                        tier: root.ally.rank-tier;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: Theme.lane-name(root.ally.lane)
                        + " · "
                        + (root.ally.is-self ? @tr("You · ") : "")
                        + root.ally.player
                        + (root.ally.is-premade ? @tr(" (Premade)") : "")
                        + (!root.ally.hidden && root.ally.rank != "" ? " · " + root.ally.rank : "");
                    color: Theme.muted;
                    font-size: Type.small;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // Border drawn last, over the splash strip.
    Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: root.ally.picking
            ? Theme.signal
            : (root.ally.is-self ? Theme.rule-strong : Theme.rule);
        animate border-color { duration: Theme.dur-base; easing: ease-out; }
    }
}

component ChampSelectScreen inherits Flickable {
    in property <ChampSelectView> cs;
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> compact: false;
    content-height: body.preferred-height;

    HeroSplash {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 230px;
        splash: root.cs.splash-icon;
    }

    body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.lg;

        Header {
            title: root.cs.title;
            detail: root.cs.detail;
            specimen: root.cs.timer;
            clock-seconds: root.clock-seconds;
            clock-total: root.clock-total;
            active-turn: root.cs.my-turn;
            compact: root.compact;
            glass: true;
        }

        if !root.compact: HorizontalLayout {
            spacing: Space.xl;
            alignment: stretch;

            // Left: 5 allied draft rows, packed at the top rather than spread to the map's height.
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: Space.sm;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: stretch;
                    SectionLabel { text: @tr("ALLIES DRAFT"); vertical-alignment: center; }
                    if root.cs.anonymized: Rectangle {
                        height: 20px;
                        width: anon-lbl.preferred-width + 14px;
                        border-radius: Theme.radius-sm;
                        background: Theme.panel-raised;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        anon-lbl := Text {
                            text: @tr("Solo/Duo Anonymized");
                            color: Theme.muted;
                            font-size: Type.label;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                for ally in root.cs.allies: RosterRow { ally: ally; }
            }

            // Right: Rift map, enemy picks, and visual bans
            VerticalLayout {
                width: 340px;
                spacing: Space.md;

                Card {
                    height: 268px;
                    HorizontalLayout {
                        padding: Space.md;
                        alignment: center;
                        LineMap {
                            width: 248px;
                            height: 248px;
                            allies: root.cs.map-allies;
                            show-jungle: true;
                            line-width: 8px;
                            station: 18px;
                            halo: Theme.panel;
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: Space.md;
                        spacing: Space.md;
                        HorizontalLayout {
                            alignment: stretch;
                            SectionLabel { text: @tr("ENEMY TEAM"); vertical-alignment: center; }
                            if root.cs.enemies-to-come > 0: Text {
                                text: @tr("{0} to pick", root.cs.enemies-to-come);
                                color: Theme.muted;
                                font-size: Type.label;
                                horizontal-alignment: right;
                            }
                        }
                        HorizontalLayout {
                            spacing: Space.sm;
                            alignment: start;
                            for e in root.cs.enemies: VerticalLayout {
                                width: 54px;
                                spacing: Space.xs;
                                EnemySlot {
                                    height: 46px;
                                    pick: e;
                                    size: 46px;
                                }
                                Text {
                                    text: e.picked ? e.champion : "—";
                                    color: e.picked ? Theme.text : Theme.muted;
                                    font-size: Type.label;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: Space.md;
                        spacing: Space.sm;
                        SectionLabel { text: @tr("BANS"); }
                        if root.cs.my-ban-list.length > 0: HorizontalLayout {
                            spacing: Space.sm;
                            alignment: start;
                            Text {
                                text: @tr("Blue");
                                width: 44px;
                                color: Theme.blue-soft;
                                font-size: Type.label;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            for b in root.cs.my-ban-list: BanChip { ban: b; mine: true; }
                        }
                        if root.cs.their-ban-list.length > 0: HorizontalLayout {
                            spacing: Space.sm;
                            alignment: start;
                            Text {
                                text: @tr("Red");
                                width: 44px;
                                color: Theme.red-soft;
                                font-size: Type.label;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            for b in root.cs.their-ban-list: BanChip { ban: b; mine: false; }
                        }
                        if root.cs.my-ban-list.length == 0 && root.cs.their-ban-list.length == 0: Text {
                            text: @tr("No champions banned yet");
                            color: Theme.muted;
                            font-size: Type.small;
                        }
                    }
                }
            }
        }

        // Stacked single-column mode for narrow split pane
        if root.compact: VerticalLayout {
            spacing: Space.md;
            SectionLabel { text: @tr("ALLIES DRAFT"); }
            for ally in root.cs.allies: RosterRow { ally: ally; }

            Card {
                height: 240px;
                LineMap {
                    width: 220px;
                    height: 220px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    allies: root.cs.map-allies;
                    show-jungle: true;
                    line-width: 7px;
                    station: 16px;
                    halo: Theme.panel;
                }
            }

            Card {
                VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;
                    SectionLabel { text: @tr("ENEMY PICKS & BANS"); }
                    HorizontalLayout {
                        spacing: Space.sm;
                        for e in root.cs.enemies: EnemySlot {
                            width: 40px;
                            height: 40px;
                            pick: e;
                            size: 40px;
                        }
                    }
                    if root.cs.my-ban-list.length > 0: HorizontalLayout {
                        spacing: Space.xs;
                        alignment: start;
                        Text {
                            text: @tr("Blue:");
                            color: Theme.blue-soft;
                            font-size: Type.label;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        for b in root.cs.my-ban-list: BanChip { ban: b; mine: true; }
                    }
                    if root.cs.their-ban-list.length > 0: HorizontalLayout {
                        spacing: Space.xs;
                        alignment: start;
                        Text {
                            text: @tr("Red:");
                            color: Theme.red-soft;
                            font-size: Type.label;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        for b in root.cs.their-ban-list: BanChip { ban: b; mine: false; }
                    }
                }
            }
        }
    }
}

component ScoreSpecimen inherits HorizontalLayout {
    in property <int> mine;
    in property <int> theirs;
    spacing: Space.sm;
    alignment: end;
    accessible-role: text;
    accessible-label: @tr("Score: allies {0}, enemies {1}", root.mine, root.theirs);
    Text {
        text: root.mine;
        color: Theme.blue;
        font-family: Type.display-family;
        font-size: Type.score;
        font-weight: 800;
        vertical-alignment: center;
    }
    Text {
        text: ":";
        color: Theme.muted;
        font-family: Type.display-family;
        font-size: Type.score * 0.75;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: root.theirs;
        color: Theme.red;
        font-family: Type.display-family;
        font-size: Type.score;
        font-weight: 800;
        vertical-alignment: center;
    }
}

component LiveScreen inherits Flickable {
    in property <LiveView> live;
    in property <int> clock-seconds: -1;
    in property <bool> compact: false;
    content-height: live-body.preferred-height;

    SplashBackdrop {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 196px;
        splash: root.live.splash-icon;
        tint: root.live.dead ? Theme.danger : Theme.blue;
    }

    live-body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.lg;

        // Top score & game clock telemetry bar
        Rectangle {
            background: root.live.dead ? Theme.danger-soft : Theme.panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: root.live.dead ? Theme.danger : Theme.rule;

            if !root.live.dead: Rectangle {
                width: 100%;
                height: 100%;
                border-radius: parent.border-radius;
                clip: true;
                SplashBackdrop {
                    width: 100%;
                    height: 100%;
                    splash: root.live.splash-icon;
                    tint: Theme.blue;
                    surface: Theme.panel;
                    card-mode: true;
                }
            }

            if !root.live.dead: Rectangle {
                x: 0px;
                y: 6px;
                width: 3px;
                height: max(0px, parent.height - 12px);
                background: Theme.gold-bright;
            }

            HorizontalLayout {
                padding: Space.md;
                spacing: Space.lg;
                alignment: stretch;

                if root.live.active-initials != "" || root.live.active-icon.width > 0: Rectangle {
                    width: 46px;
                    ChampPlate {
                        y: (parent.height - self.height) / 2;
                        size: 46px;
                        label: root.live.active-initials;
                        icon: root.live.active-icon;
                        mine: true;
                        is-self: true;
                        faded: root.live.dead;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Space.xxs;
                    Text {
                        text: root.live.title;
                        color: root.live.dead ? Theme.danger : Theme.text;
                        font-family: Type.display-family;
                        font-size: Type.headline;
                        font-weight: 800;
                    }
                    Text {
                        text: root.live.detail;
                        color: Theme.muted;
                        font-size: Type.body;
                        font-weight: 600;
                    }
                }

                if !root.compact: VerticalLayout {
                    alignment: center;
                    ScoreSpecimen { mine: root.live.my-score; theirs: root.live.enemy-score; }
                }

                Rectangle {
                    width: 112px;
                    background: Theme.ground;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.rule;
                    VerticalLayout {
                        padding: Space.sm;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.clock-seconds >= 0 ? Theme.clock-text(root.clock-seconds) : root.live.clock;
                            color: Theme.text;
                            font-family: Type.mono-family;
                            font-size: Type.title;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.live.self-kda;
                            color: Theme.muted;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        if root.compact: ScoreSpecimen {
            alignment: center;
            mine: root.live.my-score;
            theirs: root.live.enemy-score;
        }

        if !root.compact: HorizontalLayout {
            spacing: Space.lg;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Space.sm;
                SectionLabel { text: @tr("ALLIES"); }
                for p in root.live.my-players: PlayerRow { p: p; mine: true; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Space.sm;
                SectionLabel { text: @tr("ENEMIES"); }
                for p in root.live.enemy-players: PlayerRow { p: p; mine: false; }
            }
        }

        if root.compact: VerticalLayout {
            spacing: Space.md;
            SectionLabel { text: @tr("ALLIES"); }
            for p in root.live.my-players: PlayerRow { p: p; mine: true; }
            SectionLabel { text: @tr("ENEMIES"); }
            for p in root.live.enemy-players: PlayerRow { p: p; mine: false; }
        }

        // Map, Objectives & Live Event Feed
        if !root.compact: HorizontalLayout {
            spacing: Space.lg;
            alignment: stretch;

            Card {
                width: 248px;
                height: 248px;
                LineMap {
                    x: 10px;
                    y: 10px;
                    width: 228px;
                    height: 228px;
                    towers: root.live.towers;
                    show-jungle: true;
                    show-pits: true;
                    order-is-mine: root.live.order-is-mine;
                    my-drakes: root.live.my-drakes;
                    enemy-drakes: root.live.enemy-drakes;
                    baron-owner: root.live.baron-owner;
                    herald-owner: root.live.herald-owner;
                    line-width: 7px;
                    station: 15px;
                    halo: Theme.panel;
                }
            }

            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Space.md;
                    spacing: Space.md;
                    SectionLabel { text: @tr("OBJECTIVES & FEED"); }
                    HorizontalLayout {
                        spacing: Space.md;
                        Text {
                            text: @tr("Blue");
                            width: 48px;
                            color: Theme.blue-soft;
                            font-size: Type.small;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        ObjectiveRow { horizontal-stretch: 1; chips: root.live.my-objectives; }
                    }
                    HorizontalLayout {
                        spacing: Space.md;
                        Text {
                            text: @tr("Red");
                            width: 48px;
                            color: Theme.red-soft;
                            font-size: Type.small;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        ObjectiveRow { horizontal-stretch: 1; chips: root.live.enemy-objectives; }
                    }
                    Divider { }
                    VerticalLayout {
                        spacing: Space.xxs;
                        for line in root.live.feed: FeedRow { line: line; }
                    }
                }
            }
        }

        if root.compact: Card {
            VerticalLayout {
                padding: Space.md;
                spacing: Space.sm;
                SectionLabel { text: @tr("OBJECTIVES & FEED"); }
                ObjectiveRow { chips: root.live.my-objectives; empty-text: @tr("No blue objectives"); }
                ObjectiveRow { chips: root.live.enemy-objectives; empty-text: @tr("No red objectives"); }
                Divider { }
                for line in root.live.feed: FeedRow { line: line; }
            }
        }
    }
}

component WaitScreen inherits Flickable {
    in property <WaitView> wait;
    in property <[PartyRow]> party;
    in property <bool> show-party: false;
    in property <bool> is-ready-check: false;
    in property <bool> compact: false;
    in property <bool> telemetry-enabled: false;
    in property <bool> remote-panel-open: false;
    in property <bool> demo: false;
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> clock-down: true;
    callback toggle-telemetry();
    callback toggle-remote-panel();
    callback toggle-demo();
    content-height: wait-body.preferred-height;

    SplashBackdrop {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 190px;
        // No champion yet before the draft: the client's Summoner's Rift valley sets the scene.
        splash: ClientArt.backdrop;
        tint: root.is-ready-check ? Theme.signal : Theme.accent;
    }

    wait-body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.xl;

        Header {
            title: root.wait.title;
            detail: root.wait.detail;
            specimen: root.wait.specimen;
            clock-seconds: root.clock-seconds;
            clock-total: root.clock-total;
            clock-down: root.clock-down;
            active-turn: root.is-ready-check;
            compact: root.compact;
            splash-tint: root.is-ready-check ? Theme.signal : Theme.accent;
        }

        if !root.compact: HorizontalLayout {
            spacing: Space.xl;
            alignment: stretch;

            // Left: Party roster or summoner telemetry ledger
            Card {
                horizontal-stretch: 3;
                VerticalLayout {
                    padding: Space.lg;
                    spacing: Space.md;
                    alignment: start;
                    SectionLabel {
                        text: root.show-party
                            ? @tr("PARTY ROSTER")
                            : @tr("YOUR ACCOUNT");
                    }
                    if root.show-party: VerticalLayout {
                        spacing: Space.sm;
                        for m in root.party: Rectangle {
                            height: 46px;
                            border-radius: Theme.radius-sm;
                            background: m.is-self ? Theme.panel-raised : Theme.ground;
                            border-width: 1px;
                            border-color: m.is-self ? Theme.rule-strong : Theme.rule;
                            HorizontalLayout {
                                padding-left: Space.md;
                                padding-right: Space.md;
                                spacing: Space.sm;
                                Text {
                                    text: m.name + (m.is-leader ? @tr(" · Leader") : "");
                                    color: Theme.text;
                                    font-size: Type.body;
                                    font-weight: m.is-self ? 800 : 600;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: Space.md;
                                    if m.first-lane >= 0: HorizontalLayout {
                                        spacing: Space.xs;
                                        Rectangle {
                                            width: 22px;
                                            Roundel {
                                                y: (parent.height - self.height) / 2;
                                                size: 22px;
                                                lane: m.first-lane;
                                            }
                                        }
                                        Text {
                                            text: Theme.lane-name(m.first-lane);
                                            color: Theme.text;
                                            font-size: Type.small;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if m.second-lane >= 0: HorizontalLayout {
                                        spacing: Space.xs;
                                        Rectangle {
                                            width: 22px;
                                            Roundel {
                                                y: (parent.height - self.height) / 2;
                                                size: 22px;
                                                lane: m.second-lane;
                                            }
                                        }
                                        Text {
                                            text: Theme.lane-name(m.second-lane);
                                            color: Theme.muted;
                                            font-size: Type.small;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if !root.show-party: VerticalLayout {
                        spacing: Space.sm;
                        if root.wait.summoner-name != "": HorizontalLayout {
                            spacing: Space.md;
                            GameIconBadge {
                                size: 38px;
                                icon: root.wait.summoner-icon;
                                fallback-text: root.wait.summoner-initials;
                            }
                            Text {
                                text: root.wait.summoner-name;
                                color: Theme.text;
                                font-size: Type.body;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                            if root.wait.rank-tier != "": Rectangle {
                                width: 20px;
                                RankedCrest {
                                    y: (parent.height - self.height) / 2;
                                    size: 18px;
                                    tier: root.wait.rank-tier;
                                }
                            }
                        }
                        for n in root.wait.notes: NoteRow { note: n; }
                    }
                }
            }

            // Right: Quick actions & companion readiness
            Card {
                horizontal-stretch: 2;
                VerticalLayout {
                    padding: Space.lg;
                    spacing: Space.md;
                    alignment: start;
                    SectionLabel { text: @tr("GET STARTED"); }
                    if root.show-party: VerticalLayout {
                        for n in root.wait.notes: NoteRow { note: n; }
                    }
                    Text {
                        text: root.demo
                            ? @tr("Demo mode: simulated matches, nothing comes from your account. Switch phases from the left rail.")
                            : @tr("Hypatia only reads what League already shows on this PC. Nothing leaves your machine.");
                        color: Theme.muted;
                        font-size: Type.small;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Space.sm;
                        alignment: start;
                        if !root.demo: Action {
                            text: @tr("Try Demo Mode");
                            primary: true;
                            clicked => { root.toggle-demo(); }
                        }
                        if !root.remote-panel-open: Action {
                            text: @tr("Pair Phone QR");
                            clicked => { root.toggle-remote-panel(); }
                        }
                        if !root.telemetry-enabled: Action {
                            text: @tr("Observatory");
                            clicked => { root.toggle-telemetry(); }
                        }
                    }
                }
            }
        }

        if root.compact: VerticalLayout {
            spacing: Space.md;
            Card {
                VerticalLayout {
                    padding: Space.md;
                    spacing: Space.sm;
                    SectionLabel {
                        text: root.show-party
                            ? @tr("PARTY ROSTER")
                            : @tr("YOUR ACCOUNT");
                    }
                    if !root.show-party && root.wait.summoner-name != "": HorizontalLayout {
                        spacing: Space.md;
                        GameIconBadge {
                            size: 36px;
                            icon: root.wait.summoner-icon;
                            fallback-text: root.wait.summoner-initials;
                        }
                        Text {
                            text: root.wait.summoner-name;
                            color: Theme.text;
                            font-size: Type.body;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        if root.wait.rank-tier != "": Rectangle {
                            width: 18px;
                            RankedCrest {
                                y: (parent.height - self.height) / 2;
                                size: 16px;
                                tier: root.wait.rank-tier;
                            }
                        }
                    }
                    if root.show-party: VerticalLayout {
                        spacing: Space.sm;
                        for m in root.party: HorizontalLayout {
                            height: 36px;
                            spacing: Space.sm;
                            Text {
                                horizontal-stretch: 1;
                                text: m.name + (m.is-leader ? @tr(" · Leader") : "");
                                color: Theme.text;
                                font-size: Type.small;
                                font-weight: m.is-self ? 800 : 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if m.first-lane >= 0: HorizontalLayout {
                                spacing: Space.xs;
                                Rectangle {
                                    width: 18px;
                                    Roundel {
                                        y: (parent.height - self.height) / 2;
                                        size: 18px;
                                        lane: m.first-lane;
                                    }
                                }
                                Text {
                                    text: Theme.lane-name(m.first-lane);
                                    color: Theme.text;
                                    font-size: Type.label;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            if m.second-lane >= 0: HorizontalLayout {
                                spacing: Space.xs;
                                Rectangle {
                                    width: 18px;
                                    Roundel {
                                        y: (parent.height - self.height) / 2;
                                        size: 18px;
                                        lane: m.second-lane;
                                    }
                                }
                                Text {
                                    text: Theme.lane-name(m.second-lane);
                                    color: Theme.muted;
                                    font-size: Type.label;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    for n in root.wait.notes: NoteRow { note: n; }
                }
            }
        }
    }
}

component TelemetrySourceCard inherits Rectangle {
    in property <TelemetrySourceItem> src;
    horizontal-stretch: 1;
    height: 60px;
    background: Theme.panel-raised;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: src.live ? Theme.live-green : Theme.rule;

    VerticalLayout {
        padding: Space.sm;
        spacing: Space.xxs;
        HorizontalLayout {
            spacing: Space.xs;
            alignment: stretch;
            Text {
                text: src.name;
                color: Theme.text;
                font-size: Type.label;
                font-weight: 800;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: src.port;
                color: src.live ? Theme.live-green : Theme.muted;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        Text {
            text: src.stats;
            color: Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            overflow: elide;
        }
    }
}

component TelemetryEventRow inherits Rectangle {
    in property <TelemetryEventItem> ev;
    in property <bool> selected: false;
    callback clicked();
    height: 44px;
    border-radius: Theme.radius-sm;
    background: selected || touch.has-hover ? Theme.panel-raised : Theme.ground;
    border-width: 1px;
    border-color: selected ? Theme.text : Theme.rule;
    accessible-role: button;
    accessible-label: ev.source + " " + ev.kind + " " + ev.uri;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.sm;

        Text {
            width: 56px;
            text: ev.time;
            color: Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            vertical-alignment: center;
        }

        Rectangle {
            width: 38px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: ev.source-idx == 1 ? Theme.blue : (ev.source-idx == 2 ? Theme.live-green : Theme.rule-strong);
            Text {
                text: ev.source;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ev.uri;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: ev.kind + " · " + ev.preview;
                color: Theme.muted;
                font-size: Type.label;
                overflow: elide;
            }
        }

        Text {
            text: ev.size;
            color: Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TelemetryInspector inherits Rectangle {
    in property <TelemetryView> telemetry;
    in-out property <int> inspector-mode: 0;
    callback toggle-reveal-secrets();
    background: Theme.panel-raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;

    VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;

        HorizontalLayout {
            spacing: Space.sm;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: root.telemetry.inspector-title != "" ? root.telemetry.inspector-title : @tr("Payload Inspector");
                    color: Theme.text;
                    font-family: Type.mono-family;
                    font-size: Type.small;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.telemetry.inspector-meta != "" ? root.telemetry.inspector-meta : @tr("Select any stream row to inspect redacted JSON or state diffs");
                    color: Theme.muted;
                    font-size: Type.label;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: Space.xs;
                Action {
                    text: "JSON";
                    selected: root.inspector-mode == 0;
                    clicked => { root.inspector-mode = 0; }
                }
                Action {
                    text: "Diff";
                    selected: root.inspector-mode == 1;
                    clicked => { root.inspector-mode = 1; }
                }
                Action {
                    text: @tr("Prev");
                    selected: root.inspector-mode == 2;
                    clicked => { root.inspector-mode = 2; }
                }
                if root.telemetry.inspector-has-secrets: Action {
                    text: root.telemetry.secrets-revealed ? @tr("Mask") : @tr("Reveal");
                    selected: root.telemetry.secrets-revealed;
                    clicked => { root.toggle-reveal-secrets(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.backdrop;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.rule;
            clip: true;

            Flickable {
                width: 100%;
                height: 100%;
                content-height: payload-input.preferred-height + 24px;
                payload-input := TextInput {
                    accessible-label: @tr("Event payload");
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                    color: Theme.text;
                    text: root.telemetry.inspector-payload != ""
                        ? root.telemetry.inspector-payload
                        : @tr("// No event selected yet.\n// Click any item above to view its live payload or structural JSON diff.");
                }
            }
        }
    }
}

component TelemetryEventsList inherits Rectangle {
    in property <TelemetryView> telemetry;
    callback select-event(int);
    background: Theme.backdrop;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: ev-col.preferred-height + 16px;
        ev-col := VerticalLayout {
            width: parent.width;
            padding: Space.sm;
            spacing: Space.xs;
            if root.telemetry.events.length == 0: Text {
                text: @tr("No events captured for this filter.");
                color: Theme.muted;
                font-size: Type.small;
                horizontal-alignment: center;
            }
            for ev in root.telemetry.events: TelemetryEventRow {
                ev: ev;
                selected: ev.id == root.telemetry.selected-event-id;
                clicked => { root.select-event(ev.id); }
            }
        }
    }
}

component TelemetryEndpointRow inherits Rectangle {
    in property <TelemetryEndpointItem> ep;
    callback clicked();
    height: 46px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.panel-raised : Theme.ground;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.rule-strong : Theme.rule;
    accessible-role: button;
    accessible-label: @tr("Use GET {0} {1}", ep.method, ep.path);
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.sm;
        Rectangle {
            width: 38px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: ep.source-idx == 0 ? Theme.blue : (ep.source-idx == 2 ? Theme.live-green : Theme.rule-strong);
            Text {
                text: ep.source;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: ep.method + " " + ep.path;
                color: Theme.text;
                font-family: Type.mono-family;
                font-size: Type.label;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: ep.namespace + " · " + ep.origin + " · " + ep.stats;
                color: Theme.muted;
                font-size: Type.label;
                overflow: elide;
            }
        }
        Text {
            text: @tr("Use GET");
            color: touch.has-hover ? Theme.text : Theme.muted;
            font-size: Type.label;
            font-weight: 800;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TelemetryEndpointsList inherits Rectangle {
    in property <TelemetryView> telemetry;
    callback select-endpoint(int, string);
    background: Theme.backdrop;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: ep-col.preferred-height + 16px;
        ep-col := VerticalLayout {
            width: parent.width;
            padding: Space.sm;
            spacing: Space.xs;
            if root.telemetry.endpoints.length == 0: Text {
                text: @tr("No API endpoints matched filter.");
                color: Theme.muted;
                font-size: Type.small;
                horizontal-alignment: center;
            }
            for ep in root.telemetry.endpoints: TelemetryEndpointRow {
                ep: ep;
                clicked => { root.select-endpoint(ep.source-idx, ep.path); }
            }
        }
    }
}

component TelemetrySystemView inherits Rectangle {
    in property <TelemetryView> telemetry;
    background: Theme.backdrop;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.rule;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: sys-col.preferred-height + 20px;
        sys-col := VerticalLayout {
            width: parent.width;
            padding: Space.md;
            spacing: Space.md;

            SectionLabel { text: @tr("RIOT PROCESSES ({0})", root.telemetry.processes.length); }
            if root.telemetry.processes.length == 0: Text {
                text: @tr("No active Riot or League processes detected.");
                color: Theme.muted;
                font-size: Type.small;
            }
            for p in root.telemetry.processes: Rectangle {
                height: 36px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    spacing: Space.sm;
                    Text {
                        text: p.name + " (PID " + p.pid + ")";
                        color: Theme.text;
                        font-size: Type.small;
                        font-weight: 800;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: p.cpu + " · " + p.mem;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            SectionLabel { text: @tr("LISTENING SOCKETS ({0})", root.telemetry.sockets.length); }
            for s in root.telemetry.sockets: Rectangle {
                height: 32px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    spacing: Space.sm;
                    Text {
                        text: s.proto + " " + s.address;
                        color: Theme.text;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "PID " + s.pid + " · " + s.state;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            SectionLabel { text: @tr("ACTIVE CONNECTIONS ({0})", root.telemetry.connections.length); }
            for c in root.telemetry.connections: Rectangle {
                height: 32px;
                background: Theme.panel;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    spacing: Space.sm;
                    Text {
                        text: c.address;
                        color: Theme.text;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: c.state;
                        color: Theme.muted;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component TelemetryPanel inherits Rectangle {
    in property <TelemetryView> telemetry;
    in-out property <bool> split: true;
    in-out property <int> tab: 0;
    in-out property <int> source-filter: 0;
    in-out property <int> kind-filter: 0;
    in-out property <bool> paused: false;
    in-out property <int> inspector-mode: 0;
    in-out property <int> call-source-idx: 0;
    in-out property <string> call-path: "/lol-summoner/v1/current-summoner";
    in-out property <string> endpoint-filter: "";

    callback close-telemetry();
    callback select-event(int);
    callback toggle-reveal-secrets();
    callback clear-events();
    callback execute-get(int, string);
    callback set-endpoint-filter(string);

    background: Theme.panel;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 100%;
        background: Theme.rule;
    }

    VerticalLayout {
        padding: Space.md;
        spacing: Space.md;

        // Telemetry Header Bar
        HorizontalLayout {
            spacing: Space.sm;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    spacing: Space.sm;
                    alignment: start;
                    Text {
                        text: @tr("OBSERVATORY");
                        color: Theme.text;
                        font-family: Type.display-family;
                        font-size: Type.title;
                        font-weight: 800;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 20px;
                        width: phase-badge.preferred-width + 12px;
                        border-radius: Theme.radius-sm;
                        background: Theme.panel-raised;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        phase-badge := Text {
                            text: root.telemetry.phase;
                            color: Theme.text;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.telemetry.rate + " · " + root.telemetry.total-events;
                    color: Theme.muted;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                }
            }
            HorizontalLayout {
                spacing: Space.sm;
                Action {
                    text: root.split ? @tr("Full View") : @tr("Split View");
                    selected: !root.split;
                    clicked => { root.split = !root.split; }
                }
                Action {
                    text: @tr("Hide");
                    clicked => { root.close-telemetry(); }
                }
            }
        }

        // Sources Summary Strip
        HorizontalLayout {
            spacing: Space.sm;
            for src in root.telemetry.sources: TelemetrySourceCard { src: src; }
        }

        // Sub-tabs (without numeric prefixes)
        HorizontalLayout {
            spacing: Space.sm;
            alignment: stretch;
            Action {
                text: @tr("Live Stream");
                selected: root.tab == 0;
                clicked => { root.tab = 0; }
            }
            Action {
                text: @tr("API Catalog ({0})", root.telemetry.endpoints-total);
                selected: root.tab == 1;
                clicked => { root.tab = 1; }
            }
            Action {
                text: @tr("System");
                selected: root.tab == 2;
                clicked => { root.tab = 2; }
            }
        }

        // Tab 0: Event Stream + Inspector
        if root.tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: Space.sm;

            HorizontalLayout {
                spacing: Space.xs;
                Action { text: @tr("All"); selected: root.source-filter == 0; clicked => { root.source-filter = 0; } }
                Action { text: "LCU"; selected: root.source-filter == 1; clicked => { root.source-filter = 1; } }
                Action { text: "RC"; selected: root.source-filter == 2; clicked => { root.source-filter = 2; } }
                Action { text: @tr("Game"); selected: root.source-filter == 3; clicked => { root.source-filter = 3; } }
                Rectangle { horizontal-stretch: 1; }
                Action {
                    text: root.paused ? @tr("Resume") : "Pause";
                    selected: root.paused;
                    clicked => { root.paused = !root.paused; }
                }
                Action { text: @tr("Clear"); clicked => { root.clear-events(); } }
            }

            HorizontalLayout {
                spacing: Space.xs;
                Action { text: @tr("All types"); selected: root.kind-filter == 0; clicked => { root.kind-filter = 0; } }
                Action { text: @tr("Update"); selected: root.kind-filter == 1; clicked => { root.kind-filter = 1; } }
                Action { text: @tr("Create"); selected: root.kind-filter == 2; clicked => { root.kind-filter = 2; } }
                Action { text: @tr("Delete"); selected: root.kind-filter == 3; clicked => { root.kind-filter = 3; } }
                Action { text: @tr("Call"); selected: root.kind-filter == 4; clicked => { root.kind-filter = 4; } }
            }

            TelemetryEventsList {
                vertical-stretch: 1;
                min-height: 150px;
                telemetry: root.telemetry;
                select-event(id) => { root.select-event(id); }
            }

            TelemetryInspector {
                vertical-stretch: 1;
                min-height: 170px;
                telemetry: root.telemetry;
                inspector-mode <=> root.inspector-mode;
                toggle-reveal-secrets => { root.toggle-reveal-secrets(); }
            }
        }

        // Tab 1: API Catalog & Read-Only GET Runner
        if root.tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: Space.sm;

            Rectangle {
                height: 46px;
                background: Theme.panel-raised;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule;
                HorizontalLayout {
                    padding: Space.sm;
                    spacing: Space.sm;
                    Action { text: "LCU"; selected: root.call-source-idx == 0; clicked => { root.call-source-idx = 0; } }
                    Action { text: "RC"; selected: root.call-source-idx == 1; clicked => { root.call-source-idx = 1; } }
                    Action { text: ":2999"; selected: root.call-source-idx == 2; clicked => { root.call-source-idx = 2; } }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.backdrop;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: 100%;
                            text <=> root.call-path;
                            accessible-label: @tr("GET request path");
                            color: Theme.text;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.execute-get(root.call-source-idx, root.call-path); }
                        }
                    }
                    Action {
                        text: "GET";
                        primary: true;
                        clicked => { root.execute-get(root.call-source-idx, root.call-path); }
                    }
                }
            }

            HorizontalLayout {
                spacing: Space.sm;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    background: Theme.backdrop;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.rule;
                    Text {
                        x: 10px;
                        height: 100%;
                        text: root.endpoint-filter == "" ? @tr("Filter APIs (summoner, lobby, champ-select...)") : "";
                        color: Theme.muted;
                        font-size: Type.small;
                        vertical-alignment: center;
                    }
                    TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: 100%;
                        text <=> root.endpoint-filter;
                        accessible-label: @tr("Filter APIs");
                        color: Theme.text;
                        font-size: Type.small;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.set-endpoint-filter(self.text); }
                    }
                }
                Text {
                    text: root.telemetry.endpoints-summary;
                    color: Theme.muted;
                    font-family: Type.mono-family;
                    font-size: Type.label;
                    vertical-alignment: center;
                }
            }

            TelemetryEndpointsList {
                vertical-stretch: 1;
                telemetry: root.telemetry;
                select-endpoint(src, path) => {
                    root.call-source-idx = src;
                    root.call-path = path;
                }
            }

            if root.telemetry.call-status != "": Rectangle {
                height: 132px;
                background: Theme.backdrop;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.rule-strong;
                clip: true;
                VerticalLayout {
                    padding: Space.sm;
                    spacing: Space.xs;
                    Text {
                        text: root.telemetry.call-status;
                        color: Theme.text;
                        font-family: Type.mono-family;
                        font-size: Type.label;
                        font-weight: 700;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: call-resp.preferred-height + 8px;
                        call-resp := TextInput {
                            accessible-label: @tr("Call response");
                            width: parent.width;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            text: root.telemetry.call-response;
                            color: Theme.text;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                        }
                    }
                }
            }
        }

        // Tab 2: Processes & Sockets
        if root.tab == 2: TelemetrySystemView {
            vertical-stretch: 1;
            telemetry: root.telemetry;
        }
    }
}

component EndScreen inherits Flickable {
    in property <EndView> end;
    in property <bool> compact: false;
    content-height: end-body.preferred-height;

    SplashBackdrop {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 210px;
        splash: root.end.splash-icon;
        tint: root.end.victory ? Theme.live-green : Theme.red;
    }

    end-body := VerticalLayout {
        width: 100%;
        padding: Theme.gutter;
        spacing: Space.xl;

        Header {
            title: root.end.title;
            detail: root.end.detail;
            specimen: root.end.kda;
            compact: root.compact;
            splash: root.end.splash-icon;
            splash-tint: root.end.victory ? Theme.live-green : Theme.red;
        }

        Card {
            VerticalLayout {
                padding: Space.lg;
                spacing: Space.sm;
                SectionLabel { text: @tr("MATCH SUMMARY"); }
                if root.end.champion-name != "": HorizontalLayout {
                    spacing: Space.md;
                    height: 48px;
                    ChampPlate {
                        y: (parent.height - self.height) / 2;
                        size: 44px;
                        label: root.end.champion-initials;
                        icon: root.end.champion-icon;
                        mine: true;
                        is-self: true;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: Space.xxs;
                        Text {
                            text: root.end.champion-name;
                            color: Theme.text;
                            font-size: Type.name;
                            font-weight: 800;
                        }
                        Text {
                            text: root.end.title + " · " + root.end.kda;
                            color: root.end.victory ? Theme.live-green : Theme.muted;
                            font-size: Type.small;
                            font-weight: 600;
                        }
                    }
                }
                for st in root.end.stats: NoteRow { note: st; }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Hypatia";
    icon: @image-url("../assets/hypatia.png");
    default-font-family: Type.family;
    preferred-width: 1320px;
    preferred-height: 820px;
    min-width: 980px;
    min-height: 680px;
    background: Theme.ground;

    in property <Screen> view: Screen.offline;
    in property <bool> demo: false;
    in property <string> demo-phase: "";
    in property <string> queue-label;
    in property <bool> widget-open: false;
    in property <bool> remote-enabled: false;
    in-out property <bool> remote-panel-open: false;
    in property <int> remote-clients: 0;
    in property <string> remote-url;
    in property <image> remote-qr;
    in property <bool> lcu-live: false;
    in property <bool> rc-live: false;
    in property <bool> game-live: false;
    in property <string> lcu-port: "";
    in property <string> rc-port: "";
    in property <string> game-port: "";
    in property <WaitView> wait;
    in property <[PartyRow]> party;
    in property <ChampSelectView> champ;
    in property <LiveView> live;
    in property <EndView> end;
    // Running phase clock pushed by Rust four times a second: -1 when the phase has none.
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> clock-down: true;
    // Stop server asks once before it closes the phone link.
    in-out property <bool> remote-confirm-stop: false;

    in-out property <bool> telemetry-enabled: false;
    in-out property <bool> telemetry-split: true;
    in-out property <int> telemetry-tab: 0;
    in-out property <int> telemetry-source-filter: 0;
    in-out property <int> telemetry-kind-filter: 0;
    in-out property <bool> telemetry-paused: false;
    in-out property <int> inspector-mode: 0;
    in-out property <int> call-source-idx: 0;
    in-out property <string> call-path: "/lol-summoner/v1/current-summoner";
    in-out property <string> endpoint-filter: "";
    in property <TelemetryView> telemetry;

    in property <PerfSettings> perf;
    in-out property <bool> settings-open: false;
    callback toggle-setting(string);

    callback toggle-widget();
    callback toggle-remote-panel();
    callback rotate-remote-token();
    callback disable-remote();
    callback set-dark(bool);
    // Selected interface language ("en" or "fr"); drives the EN/FR switch only.
    in property <string> language: "en";
    callback select-language(string);
    callback toggle-telemetry();
    callback toggle-demo();
    callback select-demo-phase(string);
    callback select-telemetry-event(int);
    callback toggle-reveal-secrets();
    callback clear-telemetry-events();
    callback execute-get-call(int, string);
    callback set-endpoint-filter(string);

    // PhaseLine stop for the current screen: 0 lobby .. 4 results, -1 before the lobby.
    pure function current-stop() -> int {
        if (root.view == Screen.lobby) { return 0; }
        if (root.view == Screen.queue || root.view == Screen.ready-check) { return 1; }
        if (root.view == Screen.champ-select) { return 2; }
        if (root.view == Screen.in-game) { return 3; }
        if (root.view == Screen.results) { return 4; }
        return -1;
    }

    HorizontalLayout {
        spacing: 0px;

        // Persistent left workspace rail. Scrolls instead of clipping when the window is short.
        Rectangle {
            width: 216px;
            background: Theme.shell;

            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: 100%;
                background: Theme.rule;
            }

            rail-flick := Flickable {
                width: parent.width - 1px;
                height: 100%;
                content-height: max(self.height, rail-col.preferred-height);

            rail-col := VerticalLayout {
                width: rail-flick.width;
                height: rail-flick.content-height;
                padding: Space.md;
                spacing: Space.md;

                // Brand emblem + title
                HorizontalLayout {
                    height: 40px;
                    spacing: Space.md;
                    alignment: start;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius;
                        clip: true;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("../assets/hypatia.png");
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: "HYPATIA";
                            color: Theme.text;
                            font-family: Type.display-family;
                            font-size: Type.title;
                            font-weight: 800;
                            letter-spacing: 0.9px;
                        }
                        Text {
                            text: @tr("LOL COMPANION");
                            color: Theme.muted;
                            font-family: Type.mono-family;
                            font-size: Type.label;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                    }
                }

                Divider { }

                SectionLabel { text: @tr("WORKSPACE"); }

                RailNavItem {
                    label: @tr("Companion");
                    icon-path: "M 3 12 L 12 3 L 21 12 M 5 10 V 20 H 19 V 10";
                    active: (!root.telemetry-enabled || root.telemetry-split) && !root.remote-panel-open;
                    clicked => {
                        root.remote-panel-open = false;
                        if (root.telemetry-enabled && !root.telemetry-split) {
                            root.telemetry-split = true;
                        }
                    }
                }

                RailNavItem {
                    label: @tr("Observatory");
                    icon-path: "M 3 12 H 7 L 10 5 L 14 19 L 17 12 H 21";
                    active: root.telemetry-enabled;
                    badge: root.telemetry-enabled ? (root.telemetry-split ? @tr("SPLIT") : @tr("FULL")) : "";
                    clicked => {
                        root.remote-panel-open = false;
                        root.toggle-telemetry();
                    }
                }

                RailNavItem {
                    label: @tr("Mobile Remote");
                    icon-path: "M 7 3 H 17 V 21 H 7 Z M 11 18 H 13";
                    active: root.remote-panel-open;
                    indicator-live: root.remote-enabled;
                    badge: root.remote-clients > 0
                        ? root.remote-clients + " ON"
                        : (root.remote-enabled ? "QR" : "OFF");
                    clicked => { root.toggle-remote-panel(); }
                }

                RailNavItem {
                    label: "Mini Widget";
                    icon-path: "M 4 4 H 20 V 20 H 4 Z M 12 4 V 20 M 12 12 H 20";
                    active: root.widget-open;
                    badge: root.widget-open ? @tr("OPEN") : "";
                    clicked => { root.toggle-widget(); }
                }

                RailNavItem {
                    label: "Performance";
                    icon-path: "M 4 6 H 20 M 4 12 H 20 M 4 18 H 20 M 8 4 V 8 M 16 10 V 14 M 10 16 V 20";
                    active: root.settings-open;
                    badge: root.perf.eco-mode ? @tr("ECO") : "";
                    clicked => {
                        root.remote-panel-open = false;
                        root.settings-open = !root.settings-open;
                    }
                }

                Divider { }

                SectionLabel { text: "SIMULATION"; }

                RailNavItem {
                    label: @tr("Demo Mode");
                    icon-path: "M 6 4 L 19 12 L 6 20 Z";
                    active: root.demo;
                    badge: root.demo ? @tr("ON") : "OFF";
                    clicked => { root.toggle-demo(); }
                }

                if root.demo: VerticalLayout {
                    spacing: Space.xs;
                    HorizontalLayout {
                        spacing: Space.xs;
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Lobby");
                            selected: root.view == Screen.lobby;
                            clicked => { root.select-demo-phase("Lobby"); }
                        }
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Queue");
                            selected: root.view == Screen.queue;
                            clicked => { root.select-demo-phase("Matchmaking"); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.xs;
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Ready");
                            selected: root.view == Screen.ready-check;
                            clicked => { root.select-demo-phase("ReadyCheck"); }
                        }
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Champ");
                            selected: root.view == Screen.champ-select;
                            clicked => { root.select-demo-phase("ChampSelect"); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.xs;
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("Live");
                            selected: root.view == Screen.in-game;
                            clicked => { root.select-demo-phase("InProgress"); }
                        }
                        Action {
                            horizontal-stretch: 1;
                            text: @tr("End");
                            selected: root.view == Screen.results;
                            clicked => { root.select-demo-phase("EndOfGame"); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Divider { }

                SectionLabel { text: @tr("RIOT SOURCES"); }
                VerticalLayout {
                    spacing: Space.xxs;
                    RailSourceRow {
                        label: @tr("LCU API");
                        port: root.lcu-live && root.lcu-port != "" ? root.lcu-port : (root.lcu-live ? @tr("ready") : @tr("offline"));
                        live: root.lcu-live;
                    }
                    RailSourceRow {
                        label: @tr("Riot Client");
                        port: root.rc-live && root.rc-port != "" ? root.rc-port : (root.rc-live ? @tr("ready") : @tr("offline"));
                        live: root.rc-live;
                    }
                    RailSourceRow {
                        label: @tr("Live Game");
                        port: root.game-live ? ":2999" : @tr("idle");
                        live: root.game-live;
                    }
                }

                Divider { }

                // Language switcher (EN / FR)
                HorizontalLayout {
                    spacing: Space.xs;
                    Action {
                        horizontal-stretch: 1;
                        text: "EN";
                        selected: root.language != "fr";
                        clicked => { root.select-language("en"); }
                    }
                    Action {
                        horizontal-stretch: 1;
                        text: "FR";
                        selected: root.language == "fr";
                        clicked => { root.select-language("fr"); }
                    }
                }

                // Day / Night theme printing switch
                HorizontalLayout {
                    spacing: Space.xs;
                    Action {
                        horizontal-stretch: 1;
                        text: @tr("Dark");
                        selected: Theme.dark;
                        clicked => { root.set-dark(true); }
                    }
                    Action {
                        horizontal-stretch: 1;
                        text: @tr("Light");
                        selected: !Theme.dark;
                        clicked => { root.set-dark(false); }
                    }
                }
            }
            }
        }

        // Right Workspace: Phase Ticker + Responsive Content Stage
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Top 52px Pit-Wall Phase Ticker
            Rectangle {
                height: 52px;
                background: Theme.ground;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: Theme.rule;
                }

                HorizontalLayout {
                    padding-left: Space.xl;
                    padding-right: Space.xl;
                    spacing: Space.md;
                    alignment: stretch;

                    PhaseLine {
                        y: (parent.height - self.height) / 2;
                        current: root.current-stop();
                    }

                    Rectangle { horizontal-stretch: 1; }

                    HorizontalLayout {
                        spacing: Space.sm;

                        if root.queue-label != "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 24px;
                            width: q-lbl.preferred-width + 16px;
                            border-radius: Theme.radius-sm;
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: Theme.rule;
                            q-lbl := Text {
                                text: root.queue-label;
                                color: Theme.text;
                                font-size: Type.label;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.demo: Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 24px;
                            width: demo-tag.preferred-width + 14px;
                            border-radius: Theme.radius-sm;
                            background: Theme.panel-raised;
                            border-width: 1px;
                            border-color: Theme.rule-strong;
                            demo-tag := Text {
                                text: @tr("DEMO");
                                color: Theme.text;
                                font-family: Type.mono-family;
                                font-size: Type.label;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.remote-enabled: Action {
                            y: (parent.height - self.height) / 2;
                            text: root.remote-clients > 0
                                ? @tr("Mobile connected ({0})", root.remote-clients)
                                : @tr("Mobile Remote ready");
                            selected: root.remote-panel-open;
                            clicked => { root.toggle-remote-panel(); }
                        }
                    }
                }
            }

            // Main Workspace Split Area + Floating Mobile Remote Pairing Sheet
            workspace-box := Rectangle {
                vertical-stretch: 1;
                clip: true;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 0px;

                    // Companion Stage
                    if !root.telemetry-enabled || root.telemetry-split: stage := Rectangle {
                        horizontal-stretch: 3;
                        min-width: 340px;
                        property <bool> is-compact: self.width < 680px;

                        if root.view != Screen.champ-select && root.view != Screen.in-game && root.view != Screen.results: WaitScreen {
                            width: 100%;
                            height: 100%;
                            wait: root.wait;
                            party: root.party;
                            show-party: root.view == Screen.lobby && root.party.length > 0;
                            is-ready-check: root.view == Screen.ready-check;
                            compact: stage.is-compact;
                            telemetry-enabled: root.telemetry-enabled;
                            remote-panel-open: root.remote-panel-open;
                            demo: root.demo;
                            clock-seconds: root.clock-seconds;
                            clock-total: root.clock-total;
                            clock-down: root.clock-down;
                            toggle-telemetry => { root.toggle-telemetry(); }
                            toggle-remote-panel => { root.toggle-remote-panel(); }
                            toggle-demo => { root.toggle-demo(); }
                        }
                        if root.view == Screen.champ-select: ChampSelectScreen {
                            width: 100%;
                            height: 100%;
                            cs: root.champ;
                            clock-seconds: root.clock-seconds;
                            clock-total: root.clock-total;
                            compact: stage.is-compact;
                        }
                        if root.view == Screen.in-game: LiveScreen {
                            width: 100%;
                            height: 100%;
                            live: root.live;
                            clock-seconds: root.clock-seconds;
                            compact: stage.is-compact;
                        }
                        if root.view == Screen.results: EndScreen {
                            width: 100%;
                            height: 100%;
                            end: root.end;
                            compact: stage.is-compact;
                        }
                    }

                    // Telemetry Lab Split or Full Pane
                    if root.telemetry-enabled: TelemetryPanel {
                        horizontal-stretch: 2;
                        min-width: root.telemetry-split ? 380px : 0px;
                        height: 100%;
                        telemetry: root.telemetry;
                        split <=> root.telemetry-split;
                        tab <=> root.telemetry-tab;
                        source-filter <=> root.telemetry-source-filter;
                        kind-filter <=> root.telemetry-kind-filter;
                        paused <=> root.telemetry-paused;
                        inspector-mode <=> root.inspector-mode;
                        call-source-idx <=> root.call-source-idx;
                        call-path <=> root.call-path;
                        endpoint-filter <=> root.endpoint-filter;
                        close-telemetry => { root.toggle-telemetry(); }
                        select-event(id) => { root.select-telemetry-event(id); }
                        toggle-reveal-secrets => { root.toggle-reveal-secrets(); }
                        clear-events => { root.clear-telemetry-events(); }
                        execute-get(src, path) => { root.execute-get-call(src, path); }
                        set-endpoint-filter(f) => { root.set-endpoint-filter(f); }
                    }
                }

                // Non-pushing Floating Mobile Remote Pairing Sheet
                if root.remote-panel-open: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.scrim;

                    TouchArea {
                        clicked => { root.remote-panel-open = false; }
                    }
                    FocusScope {
                        // Keyboard-only: must not swallow the backdrop click.
                        focus-on-click: false;
                        init => {
                            root.remote-confirm-stop = false;
                            self.focus();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.remote-panel-open = false;
                                return accept;
                            }
                            return reject;
                        }
                    }

                    Rectangle {
                        x: 24px;
                        y: (parent.height - self.height) / 2;
                        width: min(560px, parent.width - 48px);
                        height: sheet-col.preferred-height;
                        background: Theme.panel;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.rule-strong;

                        // Absorb clicks inside sheet so backdrop doesn't dismiss inadvertently
                        TouchArea {}

                        sheet-col := VerticalLayout {
                            padding: Space.xl;
                            spacing: Space.md;

                            HorizontalLayout {
                                spacing: Space.md;
                                alignment: stretch;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: Space.xxs;
                                    Text {
                                        text: @tr("MOBILE REMOTE PAIRING");
                                        color: Theme.text;
                                        font-family: Type.display-family;
                                        font-size: Type.title;
                                        font-weight: 800;
                                    }
                                    Text {
                                        text: root.remote-clients > 0
                                            ? @tr("{n} phone connected on LAN" | "{n} phones connected on LAN" % root.remote-clients)
                                            : @tr("Waiting for QR scan on same Wi-Fi");
                                        color: root.remote-clients > 0 ? Theme.live-green : Theme.muted;
                                        font-size: Type.small;
                                        font-weight: 600;
                                    }
                                }
                                Action {
                                    text: @tr("Close");
                                    clicked => { root.remote-panel-open = false; }
                                }
                            }

                            Divider { }

                            HorizontalLayout {
                                spacing: Space.lg;
                                alignment: stretch;

                                Rectangle {
                                    width: 168px;
                                    height: 168px;
                                    border-radius: Theme.radius;
                                    background: Theme.qr-ground;
                                    border-width: 1px;
                                    border-color: Theme.rule-strong;
                                    Image {
                                        width: 152px;
                                        height: 152px;
                                        x: 8px;
                                        y: 8px;
                                        source: root.remote-qr;
                                        image-fit: contain;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: space-between;
                                    spacing: Space.md;

                                    Text {
                                        text: @tr("Scan the QR code to accept queues, lock picks & bans, swap roles/champions, switch runes, and view live objectives from your phone.");
                                        color: Theme.text;
                                        font-size: Type.body;
                                        wrap: word-wrap;
                                    }

                                    VerticalLayout {
                                        spacing: Space.xs;
                                        SectionLabel { text: @tr("DIRECT PAIRING URL (SELECT TO COPY)"); }
                                        Rectangle {
                                            height: 32px;
                                            background: Theme.backdrop;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.rule-strong;
                                            TextInput {
                                                x: 8px;
                                                width: parent.width - 16px;
                                                height: 100%;
                                                read-only: true;
                                                single-line: true;
                                                text: root.remote-url;
                                                accessible-label: @tr("Pairing URL");
                                                color: Theme.text;
                                                font-family: Type.mono-family;
                                                font-size: Type.label;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Space.sm;
                                        alignment: start;
                                        Action {
                                            text: @tr("New QR code");
                                            clicked => { root.rotate-remote-token(); }
                                        }
                                        Action {
                                            text: root.remote-confirm-stop
                                                ? @tr("Confirm stop")
                                                : @tr("Stop server");
                                            clicked => {
                                                if (root.remote-confirm-stop) {
                                                    root.disable-remote();
                                                } else {
                                                    root.remote-confirm-stop = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Performance & Features sheet: every background activity has its own switch.
                if root.settings-open: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.scrim;

                    TouchArea {
                        clicked => { root.settings-open = false; }
                    }
                    FocusScope {
                        // Keyboard-only: must not swallow the backdrop click.
                        focus-on-click: false;
                        init => { self.focus(); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.settings-open = false;
                                return accept;
                            }
                            return reject;
                        }
                    }

                    Rectangle {
                        x: 24px;
                        y: max(12px, (parent.height - self.height) / 2);
                        width: min(600px, parent.width - 48px);
                        height: min(settings-col.preferred-height, parent.height - 24px);
                        background: Theme.panel;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.rule-strong;
                        clip: true;

                        // Absorb clicks inside the sheet so the backdrop does not dismiss it.
                        TouchArea {}

                        Flickable {
                            width: 100%;
                            height: 100%;

                            settings-col := VerticalLayout {
                                padding: Space.xl;
                                spacing: Space.sm;

                                HorizontalLayout {
                                    spacing: Space.md;
                                    alignment: stretch;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Space.xxs;
                                        Text {
                                            text: @tr("PERFORMANCE & FEATURES");
                                            color: Theme.text;
                                            font-family: Type.display-family;
                                            font-size: Type.title;
                                            font-weight: 800;
                                        }
                                        Text {
                                            text: @tr("Switch off what you do not need: a disabled feature costs nothing.");
                                            color: Theme.muted;
                                            font-size: Type.small;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                        }
                                    }
                                    Action {
                                        text: @tr("Close");
                                        clicked => { root.settings-open = false; }
                                    }
                                }

                                Divider { }
                                SectionLabel { text: @tr("COMPANION"); }

                                SettingRow {
                                    title: @tr("Live game board");
                                    detail: @tr("Polls the game once per second while you play (score, towers, objectives, mini widget).");
                                    checked: root.perf.live-game;
                                    toggled => { root.toggle-setting("live_game"); }
                                }
                                SettingRow {
                                    title: @tr("Game icons");
                                    detail: @tr("Fetches and shows champion portraits, spells and profile icons. Otherwise: initials.");
                                    checked: root.perf.game-icons;
                                    toggled => { root.toggle-setting("game_icons"); }
                                }
                                SettingRow {
                                    title: @tr("Client artwork");
                                    detail: @tr("Shows cached champion splash art and Summoner's Rift artwork from the League client behind headers and the map.");
                                    checked: root.perf.splash-backdrops;
                                    toggled => { root.toggle-setting("splash_backdrops"); }
                                }
                                SettingRow {
                                    title: @tr("Riot Client connection");
                                    detail: @tr("Keeps a second WebSocket open to the Riot Client (chat presence).");
                                    checked: root.perf.riot-client;
                                    toggled => { root.toggle-setting("riot_client"); }
                                }
                                SettingRow {
                                    title: @tr("Mobile Remote at launch");
                                    detail: @tr("Starts the local pairing server. Off: no port is opened on your network.");
                                    checked: root.perf.mobile-remote;
                                    toggled => { root.toggle-setting("mobile_remote"); }
                                }
                                SettingRow {
                                    title: @tr("Eco mode");
                                    detail: @tr("Halves refresh rates (interface, detection, live game).");
                                    checked: root.perf.eco-mode;
                                    toggled => { root.toggle-setting("eco_mode"); }
                                }
                                SettingRow {
                                    title: @tr("Reduce motion");
                                    detail: @tr("Turns every animation off. The Windows animation setting is honoured either way.");
                                    checked: root.perf.reduce-motion;
                                    toggled => { root.toggle-setting("reduce_motion"); }
                                }

                                Divider { }
                                SectionLabel {
                                    text: @tr("OBSERVATORY (ONLY ACTIVE WHILE IT IS OPEN)");
                                }

                                SettingRow {
                                    title: @tr("System footprint");
                                    detail: @tr("Samples Riot process CPU / RAM and lists their ports and connections.");
                                    checked: root.perf.system-footprint;
                                    toggled => { root.toggle-setting("system_footprint"); }
                                }
                                SettingRow {
                                    title: @tr("Endpoint catalog");
                                    detail: @tr("Imports the clients' Swagger / help listing (several thousand entries).");
                                    checked: root.perf.endpoint-catalog;
                                    toggled => { root.toggle-setting("endpoint_catalog"); }
                                }
                                SettingRow {
                                    title: @tr("Replay API probe");
                                    detail: @tr("Queries /replay/game every 5 seconds during a game.");
                                    checked: root.perf.replay-api;
                                    toggled => { root.toggle-setting("replay_api"); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// One allied draft slot in the mini widget: lane, champion, and whose turn it is.
component MiniAllyRow inherits Rectangle {
    in property <AllyRow> ally;
    height: 44px;
    border-radius: Theme.radius-sm;
    background: root.ally.picking ? Theme.signal-soft : (root.ally.is-self ? Theme.panel-raised : Theme.panel);
    border-width: 1px;
    border-color: root.ally.picking ? Theme.signal : (root.ally.is-self ? Theme.rule-strong : Theme.rule);
    animate background, border-color { duration: Theme.dur-base; easing: ease-out; }
    accessible-role: text;
    accessible-label: Theme.lane-name(root.ally.lane) + ", "
        + (root.ally.champion != "" ? root.ally.champion : @tr("no pick yet"))
        + (root.ally.picking ? @tr(", acting now") : "");

    HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.md;
        spacing: Space.sm;
        Rectangle {
            width: 22px;
            Roundel { size: 22px; lane: root.ally.lane; y: (parent.height - self.height) / 2; }
        }
        Rectangle {
            width: 30px;
            ChampPlate {
                y: (parent.height - self.height) / 2;
                size: 30px;
                label: root.ally.initials;
                icon: root.ally.icon;
                mine: true;
                is-self: root.ally.is-self;
                empty: root.ally.champion == "";
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.ally.champion != "" ? root.ally.champion : @tr("Waiting");
            color: root.ally.champion != "" ? Theme.text : Theme.muted;
            font-size: Type.body;
            font-weight: 800;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.ally.is-self || root.ally.picking: Text {
            text: root.ally.picking
                ? (root.ally.is-self ? @tr("YOUR TURN") : @tr("PICKING"))
                : @tr("YOU");
            color: root.ally.picking ? Theme.signal-text : Theme.muted;
            font-family: Type.mono-family;
            font-size: Type.label;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// One player in the mini widget's team strip: portrait, then level or respawn countdown.
component MiniPlayerCell inherits VerticalLayout {
    in property <PlayerLine> p;
    in property <bool> mine: true;
    spacing: Space.xxs;
    alignment: start;
    accessible-role: text;
    accessible-label: root.p.dead
        ? @tr("{0}, dead, respawn {1}", root.p.champion, root.p.respawn)
        : root.p.champion;
    HorizontalLayout {
        alignment: center;
        ChampPlate {
            size: 36px;
            label: root.p.initials;
            icon: root.p.icon;
            mine: root.mine;
            is-self: root.p.is-self;
            faded: root.p.dead;
            border-width: root.p.is-self ? 2px : 1.5px;
            border-color: root.p.is-self
                ? Theme.gold-bright
                : (root.mine ? Theme.gold : Theme.team-color(root.mine));
        }
    }
    Text {
        text: root.p.dead ? root.p.respawn : @tr("Lv {0}", root.p.level);
        color: root.p.dead ? Theme.danger : Theme.muted;
        font-family: Type.mono-family;
        font-size: Type.label;
        font-weight: root.p.dead ? 700 : 400;
        horizontal-alignment: center;
    }
}

export component MiniWidget inherits Window {
    title: @tr("Hypatia — Live");
    icon: @image-url("../assets/hypatia.png");
    default-font-family: Type.family;
    preferred-width: 360px;
    preferred-height: 640px;
    min-width: 340px;
    min-height: 540px;
    always-on-top: true;
    background: Theme.ground;

    // Same screen as the main window; only ready-check and champ-select change the widget.
    in property <Screen> view: Screen.offline;
    in property <bool> in-game: false;
    in property <WaitView> wait;
    in property <ChampSelectView> champ;
    in property <LiveView> live;
    in property <int> clock-seconds: -1;
    in property <int> clock-total: 0;
    in property <bool> clock-down: true;
    property <bool> drafting: !root.in-game && root.view == Screen.champ-select;

    if root.drafting || root.in-game: SplashBackdrop {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 170px;
        splash: root.in-game ? root.live.splash-icon : root.champ.splash-icon;
        tint: root.in-game && root.live.dead ? Theme.danger : Theme.accent;
    }

    // Between games: what the client is doing, with the queue or ready-check clock.
    if !root.in-game && !root.drafting: VerticalLayout {
        padding: Space.xl;
        alignment: center;
        spacing: Space.lg;
        Plate {
            title: root.wait.title != "" ? root.wait.title : @tr("Waiting for a match");
            detail: root.wait.title != "" ? "" : @tr("Champion select and your game show up here automatically.");
            active-turn: root.view == Screen.ready-check;
        }
        if root.clock-seconds >= 0: ClockReadout {
            seconds: root.clock-seconds;
            total: root.clock-total;
            down: root.clock-down;
            size: Type.specimen-compact;
            align-left: true;
        }
    }

    // Champion select: whose turn, the clock, and the five allied slots.
    if root.drafting: VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;
        Plate {
            title: root.champ.title;
            detail: root.champ.detail;
            active-turn: root.champ.my-turn;
            splash: root.champ.splash-icon;
        }
        ClockReadout {
            seconds: root.clock-seconds;
            total: root.clock-total;
            fallback: root.champ.timer;
            size: Type.specimen-compact;
            align-left: true;
        }
        for a in root.champ.allies: MiniAllyRow { ally: a; }
        Rectangle { vertical-stretch: 1; }
    }

    if root.in-game: VerticalLayout {
        padding: Space.md;
        spacing: Space.sm;

        // Score, game clock, your KDA
        Rectangle {
            height: 52px;
            background: Theme.panel;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.rule;

            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                spacing: Space.sm;
                alignment: stretch;

                HorizontalLayout {
                    spacing: Space.xs;
                    alignment: start;
                    accessible-role: text;
                    accessible-label: @tr("Score: {0} - {1}", root.live.my-score, root.live.enemy-score);
                    Text {
                        text: root.live.my-score;
                        color: Theme.blue;
                        font-family: Type.display-family;
                        font-size: Type.timer;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        text: ":";
                        color: Theme.muted;
                        font-family: Type.display-family;
                        font-size: Type.title;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.live.enemy-score;
                        color: Theme.red;
                        font-family: Type.display-family;
                        font-size: Type.timer;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.clock-seconds >= 0 ? Theme.clock-text(root.clock-seconds) : root.live.clock;
                    color: Theme.text;
                    font-family: Type.display-family;
                    font-size: Type.timer;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: root.live.self-kda;
                    color: Theme.text;
                    font-family: Type.mono-family;
                    font-size: Type.small;
                    font-weight: 700;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        // Your champion, alive or respawning
        Rectangle {
            height: 40px;
            background: root.live.dead ? Theme.danger-soft : Theme.panel;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: root.live.dead ? Theme.danger : Theme.rule;
            animate background, border-color { duration: Theme.dur-base; easing: ease-out; }
            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                spacing: Space.sm;
                if root.live.active-initials != "" || root.live.active-icon.width > 0: Rectangle {
                    width: 24px;
                    ChampPlate {
                        y: (parent.height - self.height) / 2;
                        size: 24px;
                        label: root.live.active-initials;
                        icon: root.live.active-icon;
                        mine: true;
                        is-self: true;
                        faded: root.live.dead;
                    }
                }
                Text {
                    text: root.live.title;
                    color: root.live.dead ? Theme.danger : Theme.text;
                    font-size: Type.body;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.live.detail;
                    color: Theme.muted;
                    font-size: Type.label;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Who is up, who is dead and for how long
        Card {
            VerticalLayout {
                padding: Space.sm;
                spacing: Space.sm;
                HorizontalLayout {
                    spacing: Space.xs;
                    alignment: space-around;
                    for p in root.live.my-players: MiniPlayerCell { p: p; mine: true; }
                }
                Divider { }
                HorizontalLayout {
                    spacing: Space.xs;
                    alignment: space-around;
                    for p in root.live.enemy-players: MiniPlayerCell { p: p; mine: false; }
                }
            }
        }

        // Towers and objectives side by side
        HorizontalLayout {
            spacing: Space.sm;
            height: 140px;
            Card {
                width: 140px;
                LineMap {
                    width: 124px;
                    height: 124px;
                    x: 8px;
                    y: 8px;
                    towers: root.live.towers;
                    show-jungle: true;
                    show-pits: true;
                    order-is-mine: root.live.order-is-mine;
                    my-drakes: root.live.my-drakes;
                    enemy-drakes: root.live.enemy-drakes;
                    baron-owner: root.live.baron-owner;
                    herald-owner: root.live.herald-owner;
                    line-width: 5px;
                    station: 10px;
                    halo: Theme.panel;
                }
            }
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: Space.sm;
                    spacing: Space.xs;
                    alignment: start;
                    Text { text: @tr("BLUE"); color: Theme.blue-soft; font-size: Type.label; font-weight: 800; }
                    ObjectiveRow { compact: true; chips: root.live.my-objectives; empty-text: @tr("None"); }
                    Text { text: @tr("RED"); color: Theme.red-soft; font-size: Type.label; font-weight: 800; }
                    ObjectiveRow { compact: true; chips: root.live.enemy-objectives; empty-text: @tr("None"); }
                }
            }
        }

        // Recent events, scrollable
        Card {
            vertical-stretch: 1;
            clip: true;

            VerticalLayout {
                padding: Space.sm;
                spacing: Space.xs;
                SectionLabel { text: @tr("RECENT EVENTS"); }
                Flickable {
                    vertical-stretch: 1;
                    content-height: mini-feed.preferred-height;
                    mini-feed := VerticalLayout {
                        width: parent.width;
                        spacing: Space.xxs;
                        for line in root.live.feed: FeedRow { line: line; }
                    }
                }
            }
        }
    }
}
